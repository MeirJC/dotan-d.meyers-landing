          <a href="#services">שירותים</a>
          <a href="#projects">פרויקטים</a>
          <a href="#about">אודות</a>
          <a href="#contact">צור קשר</a>
        </nav>

        <div class="head-actions">
          <button
            class="icon-btn theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="החלף מצב תצוגה בהיר וכהה"
