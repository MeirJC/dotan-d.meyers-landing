<!doctype html>
<html lang="he" dir="rtl" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית · ייעוץ איטום · אפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700;800&family=Rubik:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "light" || saved === "dark" ? saved : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      /* ============ AURORA DEPTH — TOKENS ============ */
      :root {
        --font-body: "Assistant", system-ui, sans-serif;
        --font-display: "Rubik", "Assistant", system-ui, sans-serif;
        --maxw: 1200px;
        --pad: clamp(1.15rem, 4vw, 3rem);
        --r: 16px;
        --r-lg: 26px;
        --r-xl: 34px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* ===== DARK (default) — deep indigo → teal → cyan aurora mesh ===== */
      html[data-theme="dark"] {
        color-scheme: dark;
        --bg-0: oklch(0.16 0.04 268);
        --bg-1: oklch(0.21 0.05 250);
        --glow-a: oklch(0.55 0.2 274 / 0.62);
        --glow-b: oklch(0.62 0.15 205 / 0.5);
        --glow-c: oklch(0.74 0.16 178 / 0.42);
        --text: oklch(0.98 0.01 250);
        --text-dim: oklch(0.87 0.02 250);
        --text-faint: oklch(0.72 0.02 250);
        --accent: oklch(0.84 0.16 188);
        --accent-2: oklch(0.78 0.16 224);
        --accent-strong: oklch(0.9 0.17 184);
        --accent-ink: oklch(0.17 0.05 222);
        --on-photo: oklch(0.99 0.01 200);
        --on-photo-soft: oklch(0.92 0.015 220);
        --glass-bg: oklch(0.99 0.02 230 / 0.08);
        --glass-bg-2: oklch(0.99 0.02 230 / 0.14);
        --glass-border: oklch(0.97 0.03 220 / 0.26);
        --glass-border-hi: oklch(0.88 0.1 188 / 0.6);
        --shadow: 0 28px 70px -26px oklch(0.04 0.05 268 / 0.85);
        --shadow-sm: 0 12px 34px -18px oklch(0.04 0.05 268 / 0.7);
        --inner: inset 0 1px 0 0 oklch(1 0 0 / 0.14);
        --header-bg: oklch(0.16 0.04 268 / 0.6);
        --img-fade: oklch(0.16 0.04 268);
        --scrim-strong: oklch(0.1 0.04 268 / 0.78);
      }

      /* ===== LIGHT — airy frosted glass over soft aurora wash ===== */
      html[data-theme="light"] {
        color-scheme: light;
        --bg-0: oklch(0.975 0.015 228);
        --bg-1: oklch(0.93 0.03 208);
        --glow-a: oklch(0.82 0.1 272 / 0.5);
        --glow-b: oklch(0.86 0.09 202 / 0.55);
        --glow-c: oklch(0.9 0.1 176 / 0.5);
        --text: oklch(0.23 0.04 262);
        --text-dim: oklch(0.36 0.03 258);
        --text-faint: oklch(0.47 0.03 252);
        --accent: oklch(0.55 0.13 210);
        --accent-2: oklch(0.5 0.14 248);
        --accent-strong: oklch(0.5 0.15 206);
        --accent-ink: oklch(0.99 0.01 200);
        --on-photo: oklch(0.99 0.01 200);
        --on-photo-soft: oklch(0.93 0.015 220);
        --glass-bg: oklch(1 0 0 / 0.55);
        --glass-bg-2: oklch(1 0 0 / 0.72);
        --glass-border: oklch(0.5 0.04 250 / 0.18);
        --glass-border-hi: oklch(0.55 0.13 210 / 0.55);
        --shadow: 0 28px 60px -28px oklch(0.45 0.06 250 / 0.4);
        --shadow-sm: 0 12px 32px -20px oklch(0.45 0.06 250 / 0.32);
        --inner: inset 0 1px 0 0 oklch(1 0 0 / 0.7);
        --header-bg: oklch(0.975 0.015 228 / 0.74);
        --img-fade: oklch(0.93 0.03 208);
        --scrim-strong: oklch(0.18 0.05 258 / 0.62);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--bg-0);
        color: var(--text);
        font-family: var(--font-body);
        font-weight: 400;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        position: relative;
        transition: background 0.4s var(--ease), color 0.4s var(--ease);
      }

      /* layered gradient-mesh that lives behind everything */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -2;
        background:
          radial-gradient(48% 42% at 12% 8%, var(--glow-a), transparent 70%),
          radial-gradient(52% 48% at 88% 18%, var(--glow-b), transparent 72%),
          radial-gradient(60% 55% at 78% 96%, var(--glow-c), transparent 74%),
          radial-gradient(50% 50% at 18% 88%, var(--glow-a), transparent 76%),
          linear-gradient(160deg, var(--bg-0), var(--bg-1));
        pointer-events: none;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 700;
        line-height: 1.1;
        margin: 0;
        letter-spacing: -0.015em;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--accent-strong);
        outline-offset: 3px;
        border-radius: 8px;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--pad);
      }

      .eyebrow {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        color: var(--accent-strong);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .eyebrow::before {
        content: "";
        inline-size: 26px;
        block-size: 2px;
        background: currentColor;
        display: inline-block;
        flex: none;
        border-radius: 2px;
      }

      /* ============ BUTTONS ============ */
      .btn {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.9rem 1.6rem;
        min-block-size: 48px;
        border-radius: 100px;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
          background 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .btn svg {
        transition: transform 0.3s var(--ease);
      }
      .btn-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: var(--accent-ink);
        box-shadow: 0 14px 34px -14px var(--accent),
          inset 0 1px 0 0 oklch(1 0 0 / 0.3);
      }
      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 20px 44px -16px var(--accent),
          inset 0 1px 0 0 oklch(1 0 0 / 0.3);
      }
      /* RTL arrow points left */
      .btn:hover svg {
        transform: translateX(-5px);
      }
      .btn-glass {
        background: var(--glass-bg-2);
        color: var(--on-photo);
        border-color: oklch(0.97 0.02 220 / 0.4);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }
      .btn-glass:hover {
        transform: translateY(-3px);
        border-color: var(--accent-strong);
      }

      /* ============ GLASS PRIMITIVE ============ */
      .glass {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-sm), var(--inner);
        backdrop-filter: blur(20px) saturate(1.3);
        -webkit-backdrop-filter: blur(20px) saturate(1.3);
      }

      /* ============ HEADER ============ */
      .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: var(--header-bg);
        backdrop-filter: blur(18px) saturate(1.4);
        -webkit-backdrop-filter: blur(18px) saturate(1.4);
        border-block-end: 1px solid var(--glass-border);
        transition: background 0.4s var(--ease);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        block-size: 72px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      /* small brand mark — header only */
      .brand-mark {
        inline-size: 34px;
        block-size: 34px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: var(--accent-ink);
        box-shadow: 0 6px 18px -8px var(--accent), var(--inner);
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: -0.03em;
        white-space: nowrap;
      }
      .wordmark span {
        color: var(--accent-strong);
      }
      .nav {
        display: none;
        gap: 1.7rem;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.98rem;
      }
      .nav a {
        position: relative;
        color: var(--text-dim);
        padding-block: 0.3rem;
        transition: color 0.25s var(--ease);
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 0;
        inline-size: 0;
        block-size: 2px;
        background: var(--accent);
        transition: inline-size 0.3s var(--ease);
      }
      .nav a:hover {
        color: var(--text);
      }
      .nav a:hover::after {
        inline-size: 100%;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }
      .theme-toggle {
        inline-size: 44px;
        block-size: 44px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: 1px solid var(--glass-border);
        background: var(--glass-bg-2);
        color: var(--text);
        cursor: pointer;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .theme-toggle:hover {
        transform: rotate(18deg);
        border-color: var(--accent);
      }
      .theme-toggle .icon-sun {
        display: none;
      }
      html[data-theme="light"] .theme-toggle .icon-sun {
        display: block;
      }
      html[data-theme="light"] .theme-toggle .icon-moon {
        display: none;
      }
      .header-cta {
        display: none;
      }
      @media (min-width: 900px) {
        .nav {
          display: flex;
        }
        .header-cta {
          display: inline-flex;
        }
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4.5rem, 9vw, 7.5rem);
        overflow: hidden;
        isolation: isolate;
      }
      .hero-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        align-items: center;
        grid-template-columns: 1fr;
      }
      @media (min-width: 960px) {
        .hero-grid {
          grid-template-columns: 1.05fr 0.95fr;
        }
      }
      .hero-content {
        max-inline-size: 640px;
      }
      .hero h1 {
        font-size: clamp(2.2rem, 6vw, 4.2rem);
        line-height: 1.05;
        color: var(--text);
        text-wrap: balance;
        margin-block: 1rem 1.15rem;
        max-inline-size: 16ch;
      }
      .hero h1 .hl {
        background: linear-gradient(120deg, var(--accent-strong), var(--accent-2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        white-space: nowrap;
      }
      .hero p {
        font-size: clamp(1rem, 1.5vw, 1.18rem);
        color: var(--text-dim);
        max-inline-size: 54ch;
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-block-start: 1.9rem;
      }
      /* one small trust chip — court mentioned once only */
      .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-block-start: 1.5rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--text);
        padding: 0.42rem 0.95rem 0.42rem 0.78rem;
        border-radius: 100px;
        border: 1px solid var(--glass-border);
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
      .hero-chip svg {
        color: var(--accent-strong);
        flex: none;
      }

      /* hero visual: defined glass panel offset over a softly faded carousel */
      .hero-visual {
        position: relative;
        isolation: isolate;
      }
      .hero-stage {
        position: relative;
        border-radius: var(--r-xl);
        overflow: hidden;
        aspect-ratio: 4 / 5;
        max-block-size: 560px;
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow);
      }
      .hero-media,
      .hero-media .embla,
      .hero-media .embla__container,
      .hero-media .embla__slide {
        block-size: 100%;
      }
      .hero-media {
        position: absolute;
        inset: 0;
        z-index: -2;
      }
      .hero-media .embla {
        overflow: hidden;
      }
      .hero-media .embla__container {
        display: flex;
      }
      .hero-media .embla__slide {
        position: relative;
        flex: 0 0 100%;
        min-inline-size: 0;
      }
      .hero-media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        transform: scale(1.04);
      }
      /* soften the hero image so the glass panel reads clearly */
      .hero-stage::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            155deg,
            oklch(0.5 0.16 250 / 0.45),
            transparent 55%
          ),
          linear-gradient(to top, var(--scrim-strong), transparent 65%);
        backdrop-filter: saturate(1.1);
      }
      /* defined glass info panel, offset over the photo */
      .hero-panel {
        position: absolute;
        inset-block-end: clamp(1rem, 3vw, 1.6rem);
        inset-inline: clamp(1rem, 3vw, 1.6rem);
        padding: clamp(1.2rem, 3vw, 1.6rem);
        border-radius: var(--r-lg);
        background: var(--glass-bg-2);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-sm), var(--inner);
        backdrop-filter: blur(22px) saturate(1.4);
        -webkit-backdrop-filter: blur(22px) saturate(1.4);
        z-index: 2;
      }
      .hero-panel .panel-label {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        color: var(--accent-strong);
      }
      .hero-panel .panel-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-block-start: 0.7rem;
      }
      .hero-panel .panel-num {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(1.7rem, 4vw, 2.2rem);
        color: var(--on-photo);
        line-height: 1;
      }
      .hero-panel .panel-txt {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--on-photo-soft);
        line-height: 1.35;
      }

      /* ============ STATS STRIP ============ */
      .stats {
        position: relative;
        z-index: 5;
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--glass-border);
        border: 1px solid var(--glass-border);
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow), var(--inner);
        backdrop-filter: blur(20px) saturate(1.3);
        -webkit-backdrop-filter: blur(20px) saturate(1.3);
      }
      @media (min-width: 760px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .stat {
        background: var(--glass-bg-2);
        padding: clamp(1.5rem, 3vw, 2.1rem) 1rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: background 0.3s var(--ease);
      }
      .stat:hover {
        background: var(--glass-bg);
      }
      .stat .num {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(1.55rem, 3.6vw, 2.1rem);
        background: linear-gradient(120deg, var(--accent-strong), var(--accent-2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        line-height: 1.05;
      }
      .stat .lbl {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--text-dim);
        margin-block-start: 0.5rem;
      }

      /* ============ SECTION SHELL ============ */
      .section {
        padding-block: clamp(4.5rem, 10vw, 8rem);
      }
      .section-head {
        max-inline-size: 700px;
        margin-block-end: clamp(2.4rem, 5vw, 3.4rem);
      }
      .section-head h2 {
        font-size: clamp(1.95rem, 4.6vw, 3.1rem);
        margin-block: 0.9rem 0.85rem;
        text-wrap: balance;
        color: var(--text);
      }
      .section-head p {
        color: var(--text-faint);
        font-size: 1.06rem;
        max-inline-size: 54ch;
      }

      /* ============ SERVICES ============ */
      .svc-grid {
        display: grid;
        gap: 1.3rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 720px) {
        .svc-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 1040px) {
        .svc-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .svc {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        min-block-size: 440px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        isolation: isolate;
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-sm);
        transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
          border-color 0.4s var(--ease);
      }
      .svc:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow);
        border-color: var(--glass-border-hi);
      }
      .svc-img {
        position: absolute;
        inset: 0;
        z-index: -2;
      }
      .svc-img img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .svc:hover .svc-img img {
        transform: scale(1.08);
      }
      .svc::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          to top,
          var(--scrim-strong) 8%,
          oklch(0.12 0.05 258 / 0.55) 52%,
          oklch(0.12 0.05 258 / 0.1) 100%
        );
      }
      /* legible frosted body sits on the photo */
      .svc-body {
        margin: clamp(0.8rem, 2vw, 1rem);
        padding: clamp(1.25rem, 3vw, 1.6rem);
        border-radius: var(--r);
        color: var(--on-photo);
        background: oklch(0.13 0.05 262 / 0.55);
        border: 1px solid oklch(0.97 0.02 220 / 0.18);
        box-shadow: var(--inner);
        backdrop-filter: blur(16px) saturate(1.3);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
      }
      .svc-num {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 0.95rem;
        color: var(--accent-strong);
      }
      .svc-body h3 {
        font-size: 1.45rem;
        color: var(--on-photo);
        margin-block: 0.4rem 0.85rem;
      }
      .svc-body > p {
        color: var(--on-photo-soft);
        font-size: 0.98rem;
        margin: 0 0 1.1rem;
      }
      .svc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.55rem;
      }
      .svc-list li {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--on-photo);
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }
      .svc-list svg {
        flex: none;
        color: var(--accent-strong);
      }

      /* ============ BEFORE / AFTER — CENTERPIECE ============ */
      .ba .section-head {
        text-align: center;
        margin-inline: auto;
      }
      .ba .section-head .eyebrow {
        justify-content: center;
      }
      .ba .section-head p {
        margin-inline: auto;
      }
      .ba-stage {
        max-inline-size: 1000px;
        margin-inline: auto;
      }
      .ba-compare {
        position: relative;
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--glass-border);
        --pos: 50%;
        user-select: none;
        touch-action: pan-y;
      }
      .ba-layer {
        position: absolute;
        inset: 0;
      }
      .ba-layer img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      /* "after" sits on top, clipped. Physical positioning (RTL-safe):
         before stays on the RIGHT, after is revealed from the LEFT as --pos grows. */
      .ba-after {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }
      .ba-badge {
        position: absolute;
        inset-block-start: 1rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        padding: 0.4rem 1rem;
        border-radius: 100px;
        background: oklch(0.1 0.04 262 / 0.72);
        color: var(--on-photo);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        z-index: 4;
        pointer-events: none;
      }
      .ba-badge.before {
        right: 1rem;
      }
      .ba-badge.after {
        left: 1rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: var(--accent-ink);
      }
      .ba-divider {
        position: absolute;
        inset-block: 0;
        left: var(--pos);
        inline-size: 3px;
        background: oklch(0.99 0.01 200 / 0.92);
        transform: translateX(-50%);
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 0 18px oklch(0.7 0.16 188 / 0.7);
      }
      .ba-handle {
        position: absolute;
        inset-block-start: 50%;
        left: var(--pos);
        transform: translate(-50%, -50%);
        inline-size: 54px;
        block-size: 54px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: var(--accent-ink);
        display: grid;
        place-items: center;
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 6px 22px oklch(0.04 0.05 262 / 0.6), var(--inner);
      }
      .ba-range {
        position: absolute;
        inset-block-start: 50%;
        inset-inline: 0;
        transform: translateY(-50%);
        inline-size: 100%;
        block-size: 56px;
        margin: 0;
        z-index: 5;
        cursor: ew-resize;
        opacity: 0;
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        direction: ltr; /* keep range math LTR; value mapped to physical left */
      }
      .ba-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        inline-size: 56px;
        block-size: 56px;
        border-radius: 50%;
      }
      .ba-range::-moz-range-thumb {
        inline-size: 56px;
        block-size: 56px;
        border: 0;
        border-radius: 50%;
      }
      .ba-range:focus-visible {
        opacity: 1;
        outline-offset: -3px;
      }
      .ba-caption {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-faint);
        text-align: center;
        margin-block-start: 1.1rem;
      }

      /* projects gallery — Embla carousel (real embla-carousel lib) */
      .embla--gallery {
        margin-block-start: 1.9rem;
      }
      .embla--gallery .embla__viewport {
        overflow: hidden;
        border-radius: var(--r);
      }
      .embla--gallery .embla__container {
        display: flex;
        gap: 1.1rem;
        touch-action: pan-y;
      }
      .embla--gallery .embla__slide {
        position: relative;
        flex: 0 0 82%;
        min-inline-size: 0;
        border-radius: var(--r);
        overflow: hidden;
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-sm);
      }
      @media (min-width: 720px) {
        .embla--gallery .embla__slide {
          flex-basis: 46%;
        }
      }
      @media (min-width: 1040px) {
        .embla--gallery .embla__slide {
          flex-basis: 31.5%;
        }
      }
      .embla--gallery .embla__slide img {
        inline-size: 100%;
        aspect-ratio: 16 / 11;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .embla--gallery .embla__slide:hover img {
        transform: scale(1.06);
      }
      .embla--gallery .embla__slide span {
        position: absolute;
        inset-block-end: 0.8rem;
        inset-inline-start: 0.8rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--on-photo);
        padding: 0.35rem 0.85rem;
        border-radius: 100px;
        background: oklch(0.1 0.04 262 / 0.6);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }
      .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-block-start: 1.4rem;
      }
      .embla__btn {
        inline-size: 46px;
        block-size: 46px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 1px solid var(--glass-border);
        background: var(--glass-bg-2);
        color: var(--text);
        cursor: pointer;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .embla__btn:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
      }
      .embla__dots {
        display: flex;
        gap: 0.5rem;
      }
      .embla__dot {
        inline-size: 9px;
        block-size: 9px;
        border-radius: 50%;
        border: 0;
        padding: 0;
        cursor: pointer;
        background: var(--glass-border);
        transition: background 0.3s var(--ease), transform 0.3s var(--ease);
      }
      .embla__dot.is-selected {
        background: var(--accent);
        transform: scale(1.3);
      }

      /* ============ ABOUT ============ */
      .about-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        grid-template-columns: 1fr;
      }
      @media (min-width: 880px) {
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
        }
      }
      .about-portrait {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--glass-border);
      }
      .about-portrait img {
        inline-size: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .about-portrait:hover img {
        transform: scale(1.05);
      }
      .about-portrait .tag {
        position: absolute;
        inset-block-end: 1rem;
        inset-inline-start: 1rem;
        background: var(--glass-bg-2);
        color: var(--on-photo);
        font-family: var(--font-display);
        font-weight: 700;
        padding: 0.6rem 1.1rem;
        border-radius: 14px;
        font-size: 0.95rem;
        line-height: 1.2;
        border: 1px solid var(--glass-border);
        box-shadow: var(--inner);
        backdrop-filter: blur(16px) saturate(1.3);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
      }
      .about-portrait .tag small {
        display: block;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.7rem;
        color: var(--on-photo-soft);
        margin-block-start: 0.15rem;
      }
      .about h2 {
        font-size: clamp(1.9rem, 4.6vw, 2.9rem);
        margin-block: 0.9rem;
        text-wrap: balance;
        color: var(--text);
      }
      .about p {
        color: var(--text-dim);
        font-size: 1.08rem;
        max-inline-size: 54ch;
      }
      .about-points {
        list-style: none;
        margin: 1.8rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.9rem;
      }
      .about-points li {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        font-family: var(--font-body);
        font-weight: 600;
        color: var(--text);
      }
      .about-points svg {
        flex: none;
        color: var(--accent-strong);
        margin-block-start: 2px;
      }

      /* ============ FINAL CTA ============ */
      .cta-band {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }
      .cta-band img {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        z-index: -2;
      }
      .cta-band::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            155deg,
            oklch(0.45 0.18 268 / 0.7),
            transparent 60%
          ),
          linear-gradient(to top, var(--scrim-strong), oklch(0.1 0.05 262 / 0.78));
      }
      .cta-inner {
        text-align: center;
        padding-block: clamp(4rem, 10vw, 7rem);
        color: var(--on-photo);
      }
      .cta-inner h2 {
        font-size: clamp(2rem, 5.4vw, 3.5rem);
        color: var(--on-photo);
        max-inline-size: 20ch;
        margin-inline: auto;
        margin-block: 0.9rem 1.15rem;
        text-wrap: balance;
      }
      .cta-inner .eyebrow {
        color: var(--accent-strong);
        justify-content: center;
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 1.3rem;
        justify-content: center;
        margin-block-start: 1.9rem;
        font-family: var(--font-body);
        font-weight: 600;
      }
      .cta-contact a,
      .cta-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--on-photo-soft);
      }
      .cta-contact a {
        transition: color 0.25s var(--ease);
      }
      .cta-contact a:hover {
        color: var(--on-photo);
      }
      .cta-contact svg {
        color: var(--accent-strong);
        flex: none;
      }
      .cta-inner .btn {
        margin-block-start: 2.1rem;
      }

      /* ============ FOOTER ============ */
      .site-footer {
        border-block-start: 1px solid var(--glass-border);
        padding-block: clamp(2.5rem, 5vw, 3.5rem);
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }
      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        align-items: flex-start;
      }
      @media (min-width: 720px) {
        .footer-inner {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }
      }
      .footer-tag {
        color: var(--text-faint);
        font-size: 0.95rem;
        max-inline-size: 46ch;
        margin-block: 0.5rem 0;
      }
      .footer-copy {
        color: var(--text-faint);
        font-size: 0.88rem;
      }

      /* ============ REVEAL ANIM ============ */
      .reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: rise 0.9s var(--ease) forwards;
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }
      .d1 {
        animation-delay: 0.08s;
      }
      .d2 {
        animation-delay: 0.2s;
      }
      .d3 {
        animation-delay: 0.32s;
      }
      .d4 {
        animation-delay: 0.44s;
      }
      .d5 {
        animation-delay: 0.56s;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
        .hero-media img {
          transform: scale(1.02);
        }
      }
    </style>
  </head>

