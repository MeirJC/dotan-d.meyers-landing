<!doctype html>
<html lang="he" dir="rtl" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית, ייעוץ איטום ואפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&family=Spline+Sans+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var KEY = "dmeyers-mock-theme";
        var t = null;
        try {
          t = localStorage.getItem(KEY);
        } catch (e) {}
        if (t !== "light" && t !== "dark") t = "dark";
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <style>
      /* ============ TOKENS ============ */
      :root {
        --font-sans: "Rubik", "Heebo", sans-serif;
        --font-mono: "Spline Sans Mono", "SFMono-Regular", monospace;

        --maxw: 1320px;
        --gutter: clamp(1.1rem, 4vw, 3.5rem);
        --radius: 4px;
        --tick: 0.65;

        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html[data-theme="dark"] {
        --bg: oklch(0.18 0.012 250);
        --bg-2: oklch(0.21 0.014 250);
        --panel: oklch(0.235 0.016 252);
        --panel-2: oklch(0.27 0.018 252);
        --line: oklch(0.4 0.02 250);
        --line-soft: oklch(0.32 0.016 250);
        --grid: oklch(0.5 0.03 250 / 0.1);
        --ink: oklch(0.96 0.005 250);
        --ink-2: oklch(0.78 0.012 250);
        --ink-3: oklch(0.62 0.014 250);
        --accent: oklch(0.82 0.16 78);
        --accent-ink: oklch(0.2 0.04 78);
        --accent-soft: oklch(0.82 0.16 78 / 0.14);
        --shadow: 0 24px 60px -30px oklch(0 0 0 / 0.8);
      }

      html[data-theme="light"] {
        --bg: oklch(0.97 0.004 250);
        --bg-2: oklch(0.99 0.003 250);
        --panel: oklch(1 0 0);
        --panel-2: oklch(0.96 0.005 250);
        --line: oklch(0.78 0.012 250);
        --line-soft: oklch(0.88 0.008 250);
        --grid: oklch(0.55 0.02 250 / 0.12);
        --ink: oklch(0.24 0.014 252);
        --ink-2: oklch(0.4 0.014 252);
        --ink-3: oklch(0.52 0.014 252);
        --accent: oklch(0.62 0.15 55);
        --accent-ink: oklch(0.99 0.01 78);
        --accent-soft: oklch(0.62 0.15 55 / 0.12);
        --shadow: 0 24px 50px -30px oklch(0.4 0.02 250 / 0.4);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        background-color: var(--bg);
        color: var(--ink);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        background-image:
          linear-gradient(var(--grid) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid) 1px, transparent 1px),
          radial-gradient(
            ellipse 80% 50% at 70% 0%,
            var(--accent-soft),
            transparent 60%
          ),
          linear-gradient(180deg, var(--bg-2), var(--bg) 40%);
        background-size:
          44px 44px,
          44px 44px,
          100% 100%,
          100% 100%;
        background-attachment: fixed;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .mono {
        font-family: var(--font-mono);
        font-feature-settings: "tnum" 1;
      }

      .seccode {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        color: var(--accent);
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .seccode::before {
        content: "";
        width: 26px;
        height: 1px;
        background: var(--accent);
      }

      .kicker {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        color: var(--ink-3);
        text-transform: uppercase;
      }

      .btn {
        --b: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 0.85rem 1.4rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        color: var(--ink);
        background: var(--panel);
        transition:
          transform 0.3s var(--ease),
          background 0.3s var(--ease),
          border-color 0.3s var(--ease),
          color 0.3s var(--ease);
        position: relative;
      }
      .btn svg {
        width: 16px;
        height: 16px;
        transition: transform 0.3s var(--ease);
      }
      .btn:hover {
        transform: translateY(-2px);
        border-color: var(--ink-3);
      }
      .btn:hover svg {
        transform: translateX(-4px);
      }
      .btn--primary {
        background: var(--accent);
        color: var(--accent-ink);
        border-color: var(--accent);
      }
      .btn--primary:hover {
        background: var(--accent);
        filter: brightness(1.08);
      }

      /* corner ticks decorator */
      .ticked {
        position: relative;
      }
      .ticked::before,
      .ticked::after {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        border: 1px solid var(--accent);
        opacity: 0.7;
      }
      .ticked::before {
        inset-block-start: -1px;
        inset-inline-start: -1px;
        border-inline-end: none;
        border-block-end: none;
      }
      .ticked::after {
        inset-block-end: -1px;
        inset-inline-end: -1px;
        border-inline-start: none;
        border-block-start: none;
      }

      /* ============ HEADER ============ */
      .site-head {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        background: color-mix(in oklch, var(--bg) 78%, transparent);
        border-block-end: 1px solid var(--line-soft);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        block-size: 64px;
      }
      .brand {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: -0.01em;
      }
      .brand .dot {
        color: var(--accent);
      }
      .brand small {
        font-family: var(--font-mono);
        font-size: 0.58rem;
        letter-spacing: 0.12em;
        color: var(--ink-3);
        font-weight: 500;
      }
      .nav {
        display: none;
        gap: 0.3rem;
        align-items: center;
      }
      .nav a {
        font-size: 0.9rem;
        color: var(--ink-2);
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius);
        transition: color 0.25s var(--ease);
        position: relative;
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-block-end: 0.25rem;
        inset-inline: 0.75rem;
        block-size: 1px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: var(--rtl-origin, right);
        transition: transform 0.3s var(--ease);
      }
      .nav a:hover {
        color: var(--ink);
      }
      .nav a:hover::after {
        transform: scaleX(1);
      }
      .head-tools {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .toggle {
        inline-size: 40px;
        block-size: 40px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--panel);
        color: var(--ink);
        cursor: pointer;
        transition:
          transform 0.3s var(--ease),
          border-color 0.3s var(--ease);
      }
      .toggle:hover {
        transform: translateY(-2px);
        border-color: var(--accent);
      }
      .toggle svg {
        width: 18px;
        height: 18px;
      }
      html[data-theme="dark"] .icon-sun {
        display: block;
      }
      html[data-theme="dark"] .icon-moon {
        display: none;
      }
      html[data-theme="light"] .icon-sun {
        display: none;
      }
      html[data-theme="light"] .icon-moon {
        display: block;
      }
      .head-cta {
        display: none;
      }

      @media (min-width: 880px) {
        .nav {
          display: flex;
        }
        .head-cta {
          display: inline-flex;
        }
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        padding-block: clamp(2.5rem, 7vw, 5.5rem)
          clamp(2.5rem, 6vw, 4.5rem);
        overflow: hidden;
      }
      .hero-grid {
        display: grid;
        gap: clamp(1.5rem, 4vw, 2.5rem);
        grid-template-columns: 1fr;
        align-items: center;
      }
      @media (min-width: 980px) {
        .hero-grid {
          grid-template-columns: 1.05fr 0.95fr;
        }
      }
      .hero-copy {
        position: relative;
        z-index: 2;
      }
      .hero-h1 {
        font-size: clamp(2.1rem, 6.2vw, 4.2rem);
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-block: 1.2rem 1.1rem;
      }
      .hero-h1 .hl {
        color: var(--accent);
      }
      .hero-sub {
        color: var(--ink-2);
        font-size: clamp(0.95rem, 1.6vw, 1.1rem);
        max-width: 54ch;
        margin-block-end: 1.8rem;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
      }

      /* hero figure / blueprint frame */
      .hero-figure {
        position: relative;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--panel);
        padding: 10px;
        box-shadow: var(--shadow);
      }
      .hero-figure .frame {
        position: relative;
        border-radius: 3px;
        overflow: hidden;
        aspect-ratio: 4 / 3.4;
      }
      .hero-figure img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: saturate(0.85) contrast(1.05);
      }
      .hero-figure .frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            200deg,
            transparent 30%,
            color-mix(in oklch, var(--bg) 70%, transparent)
          ),
          linear-gradient(
            0deg,
            var(--accent-soft),
            transparent 55%
          );
        mix-blend-mode: multiply;
      }
      html[data-theme="dark"] .hero-figure .frame::after {
        mix-blend-mode: normal;
      }
      .hero-label {
        position: absolute;
        inset-block-end: 16px;
        inset-inline-start: 16px;
        z-index: 3;
        font-family: var(--font-mono);
        font-size: 0.66rem;
        letter-spacing: 0.1em;
        color: var(--ink);
        background: color-mix(in oklch, var(--bg) 75%, transparent);
        backdrop-filter: blur(6px);
        border: 1px solid var(--line);
        padding: 0.4rem 0.65rem;
        border-radius: 3px;
        text-transform: uppercase;
      }
      .scan {
        position: absolute;
        inset-inline: 0;
        inset-block-start: 0;
        block-size: 2px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--accent),
          transparent
        );
        opacity: 0.85;
        z-index: 2;
        animation: scan 4.5s var(--ease) infinite;
      }
      @keyframes scan {
        0% {
          transform: translateY(0);
          opacity: 0;
        }
        8% {
          opacity: 0.85;
        }
        50% {
          transform: translateY(380px);
          opacity: 0.85;
        }
        92% {
          opacity: 0;
        }
        100% {
          transform: translateY(380px);
          opacity: 0;
        }
      }

      /* measurement ruler under hero */
      .ruler {
        margin-block-start: clamp(2rem, 5vw, 3.5rem);
        border-block-start: 1px solid var(--line-soft);
        position: relative;
        block-size: 22px;
        background-image: repeating-linear-gradient(
          90deg,
          var(--line-soft) 0,
          var(--line-soft) 1px,
          transparent 1px,
          transparent 22px
        );
      }
      .ruler::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline: 0;
        block-size: 9px;
        background-image: repeating-linear-gradient(
          90deg,
          var(--line) 0,
          var(--line) 1px,
          transparent 1px,
          transparent 110px
        );
      }

      /* ============ STATS ============ */
      .stats {
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--line-soft);
        border: 1px solid var(--line-soft);
        border-radius: var(--radius);
        overflow: hidden;
      }
      @media (min-width: 760px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .stat {
        background: var(--panel);
        padding: clamp(1.2rem, 3vw, 1.8rem);
        position: relative;
        transition: background 0.3s var(--ease);
      }
      .stat:hover {
        background: var(--panel-2);
      }
      .stat .num {
        font-family: var(--font-mono);
        font-size: clamp(1.7rem, 4vw, 2.6rem);
        font-weight: 700;
        line-height: 1;
        color: var(--ink);
      }
      .stat .num .u {
        color: var(--accent);
      }
      .stat .lab {
        margin-block-start: 0.6rem;
        font-size: 0.85rem;
        color: var(--ink-2);
      }
      .stat .code {
        position: absolute;
        inset-block-start: 0.7rem;
        inset-inline-end: 0.7rem;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--ink-3);
        letter-spacing: 0.1em;
      }

      /* ============ SECTION HEAD ============ */
      .sec {
        padding-block: clamp(3rem, 8vw, 6rem);
      }
      .sec-head {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-block-end: clamp(2rem, 5vw, 3rem);
        max-width: 60ch;
      }
      .sec-title {
        font-size: clamp(1.7rem, 4.5vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.08;
      }

      /* ============ SERVICES ============ */
      .svc-grid {
        display: grid;
        gap: 1.1rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 760px) {
        .svc-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .card {
        position: relative;
        border: 1px solid var(--line-soft);
        border-radius: var(--radius);
        background: var(--panel);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition:
          transform 0.4s var(--ease),
          border-color 0.4s var(--ease),
          box-shadow 0.4s var(--ease);
      }
      .card:hover {
        transform: translateY(-5px);
        border-color: var(--accent);
        box-shadow: var(--shadow);
      }
      .card .media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
      }
      .card .media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: saturate(0.8) contrast(1.05);
        transition: transform 0.6s var(--ease);
      }
      .card:hover .media img {
        transform: scale(1.06);
      }
      .card .media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          transparent 40%,
          color-mix(in oklch, var(--panel) 92%, transparent)
        );
      }
      .card .code {
        position: absolute;
        inset-block-start: 0.7rem;
        inset-inline-start: 0.7rem;
        z-index: 2;
        font-family: var(--font-mono);
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--accent);
        background: color-mix(in oklch, var(--bg) 70%, transparent);
        border: 1px solid var(--line);
        padding: 0.25rem 0.5rem;
        border-radius: 3px;
      }
      .card-body {
        padding: 1.3rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        flex: 1;
      }
      .card h3 {
        font-size: 1.25rem;
        font-weight: 700;
      }
      .card p {
        color: var(--ink-2);
        font-size: 0.92rem;
      }
      .card ul {
        margin: 0.3rem 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.5rem;
        border-block-start: 1px solid var(--line-soft);
        padding-block-start: 0.9rem;
      }
      .card li {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.85rem;
        color: var(--ink-2);
      }
      .card li svg {
        flex: none;
        width: 14px;
        height: 14px;
        margin-block-start: 0.25rem;
        color: var(--accent);
      }

      /* ============ BEFORE / AFTER ============ */
      .ba-grid {
        display: grid;
        gap: 1.1rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 720px) {
        .ba-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
      .ba {
        position: relative;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        aspect-ratio: 4 / 3;
        background: var(--panel);
      }
      .ba img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      .ba .tag {
        position: absolute;
        inset-block-start: 1rem;
        inset-inline-start: 1rem;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.35rem 0.7rem;
        border-radius: 3px;
        border: 1px solid var(--line);
        background: color-mix(in oklch, var(--bg) 72%, transparent);
        backdrop-filter: blur(6px);
      }
      .ba--after .tag {
        color: var(--accent);
        border-color: var(--accent);
      }

      /* ============ ABOUT ============ */
      .about-grid {
        display: grid;
        gap: clamp(1.5rem, 4vw, 3rem);
        grid-template-columns: 1fr;
        align-items: center;
      }
      @media (min-width: 860px) {
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
        }
      }
      .portrait {
        position: relative;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--panel);
        padding: 10px;
        max-inline-size: 380px;
      }
      .portrait .frame {
        border-radius: 3px;
        overflow: hidden;
        aspect-ratio: 3 / 4;
      }
      .portrait img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: grayscale(0.25) contrast(1.05);
      }
      .portrait .badge {
        position: absolute;
        inset-block-end: -14px;
        inset-inline-start: 22px;
        background: var(--accent);
        color: var(--accent-ink);
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        padding: 0.5rem 0.9rem;
        border-radius: 3px;
      }
      .about-body p {
        color: var(--ink-2);
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        margin-block-start: 1.2rem;
        max-width: 56ch;
      }
      .specs {
        display: grid;
        gap: 1px;
        background: var(--line-soft);
        border: 1px solid var(--line-soft);
        border-radius: var(--radius);
        overflow: hidden;
        margin-block-start: 1.8rem;
        grid-template-columns: repeat(2, 1fr);
      }
      .spec {
        background: var(--panel);
        padding: 1rem 1.1rem;
      }
      .spec dt {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--ink-3);
        text-transform: uppercase;
      }
      .spec dd {
        margin: 0.35rem 0 0;
        font-weight: 600;
        font-size: 0.95rem;
      }

      /* ============ FINAL CTA ============ */
      .cta {
        position: relative;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background:
          radial-gradient(
            ellipse 60% 100% at 80% 0%,
            var(--accent-soft),
            transparent 70%
          ),
          var(--panel);
        padding: clamp(2rem, 6vw, 4rem);
        overflow: hidden;
      }
      .cta .seccode {
        margin-block-end: 1rem;
      }
      .cta h2 {
        font-size: clamp(1.6rem, 4.5vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        max-width: 22ch;
        line-height: 1.1;
      }
      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem 2.2rem;
        align-items: center;
        margin-block-start: 1.8rem;
      }
      .contact-lines {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem 1.6rem;
      }
      .contact-lines a,
      .contact-lines span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--ink-2);
      }
      .contact-lines svg {
        width: 15px;
        height: 15px;
        color: var(--accent);
      }
      .contact-lines a:hover {
        color: var(--ink);
      }

      /* ============ FOOTER ============ */
      .site-foot {
        border-block-start: 1px solid var(--line-soft);
        margin-block-start: clamp(3rem, 8vw, 6rem);
        padding-block: 2.5rem;
      }
      .foot-inner {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        justify-content: space-between;
        align-items: flex-start;
      }
      @media (min-width: 680px) {
        .foot-inner {
          flex-direction: row;
          align-items: center;
        }
      }
      .foot-tag {
        color: var(--ink-3);
        font-size: 0.85rem;
        max-width: 42ch;
      }
      .foot-copy {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--ink-3);
      }

      /* ============ MOTION / REVEAL ============ */
      .reveal {
        opacity: 0;
        transform: translateY(22px);
        animation: rise 0.85s var(--ease) forwards;
        animation-delay: var(--d, 0s);
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }
      .draw {
        animation: draw 1.1s var(--ease) forwards;
        transform-origin: var(--rtl-origin, right);
        transform: scaleX(0);
      }
      @keyframes draw {
        to {
          transform: scaleX(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
        .draw {
          transform: none;
        }
      }
    </style>
  </head>

