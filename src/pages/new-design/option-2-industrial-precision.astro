<!doctype html>
<html lang="he" dir="rtl" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — Blueprint</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("dmeyers-mock-theme");
          document.documentElement.setAttribute(
            "data-theme",
            s === "light" || s === "dark" ? s : "dark"
          );
        } catch (e) {}
      })();
    </script>
    <style>
      html[data-theme="dark"] {
        --bg: oklch(0.19 0.012 250);
        --bg-2: oklch(0.23 0.014 250);
        --surface: oklch(0.26 0.016 250);
        --grid-line: oklch(0.72 0.05 220 / 0.07);
        --grid-line-bold: oklch(0.72 0.05 220 / 0.12);
        --border: oklch(0.55 0.02 240 / 0.5);
        --hair: oklch(0.62 0.02 240 / 0.32);
        --ink: oklch(0.97 0.008 230);
        --ink-soft: oklch(0.83 0.012 230);
        --ink-mute: oklch(0.66 0.016 235);
        --accent: oklch(0.82 0.15 200);
        --accent-soft: oklch(0.82 0.15 200 / 0.14);
        --accent-ink: oklch(0.18 0.04 240);
        --glow: oklch(0.82 0.15 200 / 0.16);
        --shadow: 0 28px 64px -34px oklch(0.04 0.02 240 / 0.9);
      }
      html[data-theme="light"] {
        --bg: oklch(0.98 0.004 230);
        --bg-2: oklch(0.95 0.006 230);
        --surface: oklch(1 0 0);
        --grid-line: oklch(0.5 0.06 230 / 0.08);
        --grid-line-bold: oklch(0.5 0.06 230 / 0.14);
        --border: oklch(0.74 0.02 235 / 0.95);
        --hair: oklch(0.66 0.02 235 / 0.55);
        --ink: oklch(0.21 0.02 245);
        --ink-soft: oklch(0.35 0.02 245);
        --ink-mute: oklch(0.48 0.02 240);
        --accent: oklch(0.52 0.16 235);
        --accent-soft: oklch(0.52 0.16 235 / 0.1);
        --accent-ink: oklch(0.99 0.005 230);
        --glow: oklch(0.6 0.14 225 / 0.14);
        --shadow: 0 28px 60px -36px oklch(0.4 0.05 240 / 0.4);
      }
      :root {
        --maxw: 1340px;
        --pad: clamp(1.15rem, 4vw, 3.5rem);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Rubik", sans-serif;
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        transition: background 0.4s var(--ease), color 0.4s var(--ease);
      }
      /* blueprint measurement grid */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image:
          linear-gradient(var(--grid-line) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
          linear-gradient(var(--grid-line-bold) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid-line-bold) 1px, transparent 1px);
        background-size: 28px 28px, 28px 28px, 140px 140px, 140px 140px;
        transition: background-image 0.4s var(--ease);
      }
      h1, h2, h3 { font-family: "Rubik", sans-serif; font-weight: 800; line-height: 1.04; margin: 0; letter-spacing: -0.02em; overflow-wrap: anywhere; }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
      .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--pad); position: relative; z-index: 1; }

      .mono { font-family: "JetBrains Mono", monospace; font-variant-numeric: tabular-nums; }
      .code-label {
        font-family: "JetBrains Mono", monospace; font-weight: 600; font-size: 0.72rem;
        letter-spacing: 0.16em; color: var(--accent); text-transform: uppercase;
        display: inline-flex; align-items: center; gap: 0.55rem;
      }
      .code-label::before { content: ""; inline-size: 24px; block-size: 1px; background: currentColor; }

      .btn {
        font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.02em;
        display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
        padding: 0.95rem 1.5rem; min-block-size: 50px; border-radius: 0; border: 1px solid transparent; cursor: pointer;
        transition: transform 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
      }
      .btn svg { transition: transform 0.25s var(--ease); }
      .btn:hover svg { transform: translateX(-5px); }
      .btn-primary { background: var(--accent); color: var(--accent-ink); }
      .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -14px var(--accent); }
      .btn-ghost { background: transparent; color: var(--ink); border-color: var(--border); }
      .btn-ghost:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); }

      /* corner-tick decorator */
      .ticked { position: relative; }
      .ticked::before, .ticked::after {
        content: ""; position: absolute; inline-size: 10px; block-size: 10px; pointer-events: none; z-index: 6;
        border-color: var(--accent); border-style: solid; border-width: 0;
      }
      .ticked::before { inset-block-start: -1px; inset-inline-start: -1px; border-inline-start-width: 2px; border-block-start-width: 2px; }
      .ticked::after { inset-block-end: -1px; inset-inline-end: -1px; border-inline-end-width: 2px; border-block-end-width: 2px; }

      /* header */
      .site-header { position: sticky; inset-block-start: 0; z-index: 60; background: color-mix(in oklch, var(--bg) 80%, transparent); backdrop-filter: blur(14px); border-block-end: 1px solid var(--hair); }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; block-size: 70px; }
      .wordmark { font-family: "Rubik", sans-serif; font-weight: 900; font-size: 1.45rem; letter-spacing: -0.03em; }
      .wordmark span { color: var(--accent); }
      .nav { display: none; gap: 1.6rem; font-family: "JetBrains Mono", monospace; font-weight: 500; font-size: 0.84rem; }
      .nav a { color: var(--ink-soft); display: inline-flex; gap: 0.4rem; align-items: baseline; }
      .nav a .n { color: var(--ink-mute); font-size: 0.72rem; }
      .nav a:hover { color: var(--accent); }
      .header-actions { display: flex; align-items: center; gap: 0.6rem; }
      .theme-toggle { inline-size: 44px; block-size: 44px; display: grid; place-items: center; border-radius: 0; border: 1px solid var(--border); background: var(--surface); color: var(--ink); cursor: pointer; transition: border-color 0.25s var(--ease), color 0.25s var(--ease); }
      .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
      .theme-toggle .icon-sun { display: none; }
      html[data-theme="light"] .theme-toggle .icon-sun { display: block; }
      html[data-theme="light"] .theme-toggle .icon-moon { display: none; }
      .header-cta { display: none; }
      @media (min-width: 980px) { .nav, .header-cta { display: inline-flex; } }

      /* HERO */
      .hero { position: relative; overflow: hidden; isolation: isolate; }
      .hero::before {
        content: ""; position: absolute; z-index: -1; inset-block-start: -25%; inset-inline-end: -15%;
        inline-size: 55vw; block-size: 55vw; border-radius: 50%;
        background: radial-gradient(circle, var(--glow), transparent 66%); pointer-events: none;
      }
      .hero-grid { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; padding-block: clamp(2.6rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
      @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; } }
      .hero-meta { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; margin-block-start: 1.1rem; font-family: "JetBrains Mono", monospace; font-size: 0.74rem; color: var(--ink-mute); }
      .hero-meta span { display: inline-flex; align-items: center; gap: 0.4rem; }
      .hero-meta span::before { content: ""; inline-size: 6px; block-size: 6px; background: var(--accent); }
      .hero h1 { font-size: clamp(2.5rem, 7.8vw, 5.6rem); margin-block: 1.1rem 1.2rem; letter-spacing: -0.035em; }
      .hero h1 .line2 { color: var(--accent); }
      .hero p { font-size: clamp(1rem, 1.5vw, 1.18rem); color: var(--ink-soft); max-inline-size: 46ch; }
      .hero-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-block-start: 1.9rem; }

      /* TECHNICAL SPEC PANEL */
      .spec-panel { background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); }
      .spec-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1.2rem; border-block-end: 1px solid var(--hair); }
      .spec-head .title { font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 0.82rem; letter-spacing: 0.06em; }
      .spec-head .dot-row { display: flex; gap: 6px; }
      .spec-head .dot-row i { inline-size: 9px; block-size: 9px; border-radius: 50%; border: 1px solid var(--border); display: block; }
      .spec-head .dot-row i.live { background: var(--accent); border-color: var(--accent); }
      .spec-rows { display: grid; }
      .spec-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.05rem 1.2rem; border-block-end: 1px solid var(--hair); }
      .spec-row:last-child { border-block-end: 0; }
      .spec-row .k { font-family: "JetBrains Mono", monospace; font-size: 0.78rem; letter-spacing: 0.04em; color: var(--ink-mute); display: inline-flex; align-items: baseline; gap: 0.5rem; }
      .spec-row .k .idx { color: var(--accent); font-size: 0.68rem; }
      .spec-row .v { font-family: "Rubik", sans-serif; font-weight: 800; font-size: clamp(1.3rem, 3vw, 1.8rem); color: var(--ink); letter-spacing: -0.02em; }
      .spec-foot { padding: 0.8rem 1.2rem; font-family: "JetBrains Mono", monospace; font-size: 0.7rem; color: var(--ink-mute); border-block-start: 1px solid var(--hair); display: flex; justify-content: space-between; gap: 1rem; }
      .spec-foot .live { color: var(--accent); }

      /* draw-on underline for line2 */
      .draw { position: relative; display: inline-block; }
      .draw::after {
        content: ""; position: absolute; inset-block-end: 0.06em; inset-inline: 0; block-size: 3px;
        background: var(--accent); transform: scaleX(0); transform-origin: right;
        animation: draw 1s var(--ease) 0.5s forwards;
      }
      @keyframes draw { to { transform: scaleX(1); } }

      /* ticker strip */
      .ticker { border-block: 1px solid var(--hair); background: var(--bg-2); overflow: hidden; }
      .ticker-track { display: flex; gap: 0; width: max-content; animation: scroll-x 30s linear infinite; }
      .ticker-track span { font-family: "JetBrains Mono", monospace; font-size: 0.82rem; color: var(--ink-mute); padding-block: 0.85rem; padding-inline: 1.6rem; display: inline-flex; align-items: center; gap: 0.7rem; border-inline-end: 1px solid var(--hair); white-space: nowrap; }
      .ticker-track span b { color: var(--accent); font-weight: 600; }
      @keyframes scroll-x { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }

      /* sections */
      .section { padding-block: clamp(4rem, 9vw, 7rem); position: relative; }
      .section-head { max-inline-size: 720px; margin-block-end: clamp(2.2rem, 5vw, 3.2rem); }
      .section-head.center { margin-inline: auto; text-align: center; }
      .section-head.center .code-label { justify-content: center; }
      .section-head h2 { font-size: clamp(1.9rem, 4.8vw, 3.2rem); margin-block: 0.85rem 0.7rem; }
      .section-head p { color: var(--ink-mute); font-size: 1.04rem; }

      /* services — precise numbered rows */
      .svc-list { border-block-start: 1px solid var(--hair); }
      .svc-row { display: grid; grid-template-columns: 1fr; gap: 0.5rem 2rem; padding-block: clamp(1.6rem, 3.5vw, 2.4rem); border-block-end: 1px solid var(--hair); position: relative; transition: background 0.3s var(--ease); }
      @media (min-width: 760px) { .svc-row { grid-template-columns: 7rem 1fr 1.1fr; align-items: start; } }
      .svc-row:hover { background: var(--accent-soft); }
      .svc-row .svc-idx { font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: clamp(1.6rem, 4vw, 2.4rem); color: var(--accent); line-height: 1; }
      .svc-row h3 { font-size: clamp(1.3rem, 2.6vw, 1.65rem); }
      .svc-row .svc-tag { font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: var(--ink-mute); margin-block-start: 0.5rem; letter-spacing: 0.04em; }
      .svc-row p { color: var(--ink-soft); margin: 0; font-size: 0.98rem; }

      /* before/after section */
      .ba { background: var(--bg-2); border-block: 1px solid var(--hair); }
      .ba-stage { max-inline-size: 1000px; margin-inline: auto; }
      .ba-compare { position: relative; inline-size: 100%; aspect-ratio: 16/10; overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow); --pos: 50%; user-select: none; touch-action: pan-y; }
      .ba-layer { position: absolute; inset: 0; }
      .ba-layer img { inline-size: 100%; block-size: 100%; object-fit: cover; }
      .ba-after { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
      .ba-badge { position: absolute; inset-block-start: 1rem; font-family: "JetBrains Mono", monospace; font-weight: 600; font-size: 0.72rem; letter-spacing: 0.14em; padding: 0.4rem 0.9rem; background: oklch(0.12 0.02 240 / 0.82); color: #fff; z-index: 4; pointer-events: none; }
      .ba-badge.before { right: 1rem; }
      .ba-badge.after { left: 1rem; background: var(--accent); color: var(--accent-ink); }
      .ba-divider { position: absolute; inset-block: 0; left: var(--pos); inline-size: 2px; background: var(--accent); transform: translateX(-50%); z-index: 3; pointer-events: none; box-shadow: 0 0 16px var(--accent); }
      .ba-handle { position: absolute; inset-block-start: 50%; left: var(--pos); transform: translate(-50%, -50%); inline-size: 52px; block-size: 52px; border-radius: 0; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; z-index: 3; pointer-events: none; box-shadow: var(--shadow); }
      .ba-range { position: absolute; inset-block-start: 50%; inset-inline: 0; transform: translateY(-50%); inline-size: 100%; block-size: 60px; margin: 0; z-index: 5; cursor: ew-resize; opacity: 0; -webkit-appearance: none; appearance: none; background: transparent; direction: ltr; }
      .ba-range::-webkit-slider-thumb { -webkit-appearance: none; inline-size: 60px; block-size: 60px; }
      .ba-range:focus-visible { opacity: 1; }
      .reveal-note { position: absolute; inset-block-end: 1rem; inset-inline: 1rem; text-align: center; font-family: "JetBrains Mono", monospace; font-size: 0.74rem; color: #fff; background: oklch(0.12 0.02 240 / 0.55); backdrop-filter: blur(4px); padding: 0.45rem; z-index: 4; pointer-events: none; }

      /* gallery */
      .gallery { margin-block-start: 2rem; }
      .embla__viewport { overflow: hidden; }
      .embla__container { display: flex; gap: 1rem; }
      .embla__slide { position: relative; flex: 0 0 84%; min-inline-size: 0; overflow: hidden; border: 1px solid var(--border); background: var(--surface); }
      @media (min-width: 720px) { .embla__slide { flex-basis: 47%; } }
      @media (min-width: 1040px) { .embla__slide { flex-basis: 32%; } }
      .embla__slide img { inline-size: 100%; aspect-ratio: 16/11; object-fit: cover; transition: transform 0.7s var(--ease); }
      .embla__slide:hover img { transform: scale(1.05); }
      .embla__slide .cap { position: absolute; inset-block-end: 0; inset-inline: 0; display: flex; justify-content: space-between; gap: 0.5rem; font-family: "JetBrains Mono", monospace; font-size: 0.72rem; color: #fff; padding: 0.5rem 0.7rem; background: linear-gradient(to top, oklch(0.12 0.02 240 / 0.85), transparent); }
      .embla__slide .cap .id { color: var(--accent); }
      .embla__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-block-start: 1.3rem; }
      .embla__btn { inline-size: 46px; block-size: 46px; border-radius: 0; display: grid; place-items: center; border: 1px solid var(--border); background: var(--surface); color: var(--ink); cursor: pointer; transition: border-color 0.25s var(--ease), color 0.25s var(--ease); }
      .embla__btn:hover { border-color: var(--accent); color: var(--accent); }
      .embla__dots { display: flex; gap: 0.5rem; }
      .embla__dot { inline-size: 26px; block-size: 4px; border-radius: 0; border: 0; padding: 0; cursor: pointer; background: var(--border); transition: background 0.25s var(--ease); }
      .embla__dot.is-selected { background: var(--accent); }

      /* stats band */
      .stats { display: grid; grid-template-columns: repeat(2, 1fr); border-block-start: 1px solid var(--hair); }
      @media (min-width: 760px) { .stats { grid-template-columns: repeat(4, 1fr); } }
      .stat { padding: clamp(1.8rem, 4vw, 2.6rem) 1.2rem; border-inline-start: 1px solid var(--hair); border-block-end: 1px solid var(--hair); }
      .stat .idx { font-family: "JetBrains Mono", monospace; font-size: 0.68rem; color: var(--ink-mute); letter-spacing: 0.1em; }
      .stat .n { font-family: "Rubik", sans-serif; font-weight: 900; font-size: clamp(1.9rem, 5vw, 3rem); color: var(--accent); line-height: 1; margin-block: 0.4rem 0.3rem; letter-spacing: -0.02em; }
      .stat .l { font-family: "JetBrains Mono", monospace; font-weight: 500; color: var(--ink-soft); font-size: 0.82rem; }

      /* about */
      .about-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; grid-template-columns: 1fr; }
      @media (min-width: 900px) { .about-grid { grid-template-columns: 0.82fr 1.18fr; } }
      .about-portrait { position: relative; overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow); aspect-ratio: 4/5; }
      .about-portrait img { inline-size: 100%; block-size: 100%; object-fit: cover; filter: grayscale(0.15); }
      .about-portrait .pin { position: absolute; inset-block-end: 0; inset-inline: 0; background: oklch(0.12 0.02 240 / 0.78); color: #fff; font-family: "JetBrains Mono", monospace; padding: 0.6rem 1rem; font-size: 0.78rem; display: flex; justify-content: space-between; gap: 1rem; }
      .about-portrait .pin b { color: var(--accent); }
      .about h2 { font-size: clamp(1.9rem, 4.4vw, 2.8rem); margin-block: 0.85rem; }
      .about p { color: var(--ink-soft); font-size: 1.06rem; max-inline-size: 52ch; }
      .about-points { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: 0.85rem; }
      .about-points li { display: flex; gap: 0.75rem; align-items: flex-start; font-weight: 500; }
      .about-points svg { flex: none; color: var(--accent); margin-block-start: 3px; }

      /* CTA */
      .cta { position: relative; overflow: hidden; background: var(--bg-2); border-block-start: 1px solid var(--hair); isolation: isolate; }
      .cta::before { content: ""; position: absolute; z-index: -1; inset-block-end: -35%; inset-inline-start: -12%; inline-size: 50vw; block-size: 50vw; border-radius: 50%; background: radial-gradient(circle, var(--glow), transparent 66%); }
      .cta-inner { text-align: center; padding-block: clamp(3.5rem, 9vw, 6.5rem); }
      .cta-inner h2 { font-size: clamp(2rem, 5.6vw, 3.6rem); max-inline-size: 18ch; margin-inline: auto; margin-block: 0.85rem 1.3rem; }
      .cta-contact { display: flex; flex-wrap: wrap; gap: 0.8rem 1.2rem; justify-content: center; margin-block: 1.6rem; font-family: "JetBrains Mono", monospace; font-size: 0.86rem; font-weight: 500; }
      .cta-contact a, .cta-contact span { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink-soft); }
      .cta-contact svg { color: var(--accent); flex: none; }

      /* footer */
      .site-footer { background: var(--bg); border-block-start: 1px solid var(--hair); padding-block: clamp(2.4rem, 6vw, 3.6rem); }
      .footer-row { display: flex; flex-direction: column; gap: 1rem; }
      @media (min-width: 720px) { .footer-row { flex-direction: row; justify-content: space-between; align-items: center; } }
      .footer-row .wordmark { font-size: 1.6rem; }
      .footer-row .tag { font-family: "JetBrains Mono", monospace; color: var(--ink-mute); font-size: 0.82rem; }
      .footer-row .copy { font-family: "JetBrains Mono", monospace; color: var(--ink-mute); font-size: 0.76rem; }

      .reveal { opacity: 0; transform: translateY(24px); animation: rise 0.85s var(--ease) forwards; }
      @keyframes rise { to { opacity: 1; transform: none; } }
      .d1 { animation-delay: 0.05s; } .d2 { animation-delay: 0.16s; } .d3 { animation-delay: 0.27s; } .d4 { animation-delay: 0.38s; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
        .reveal { opacity: 1; transform: none; }
        .draw::after { transform: scaleX(1); }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="#top">D<span>.</span>Meyer's</a>
        <nav class="nav" aria-label="ניווט ראשי">
