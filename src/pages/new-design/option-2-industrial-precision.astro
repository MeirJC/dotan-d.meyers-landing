<!doctype html>
<html lang="he" dir="rtl" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית · ייעוץ איטום · אפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        var KEY = "dmeyers-mock-theme";
        var t = null;
        try {
          t = localStorage.getItem(KEY);
        } catch (e) {}
        if (t !== "light" && t !== "dark") t = "dark";
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <style>
      /* ============================================================
         TOKENS — "Industrial Precision" graphite/steel + cyan signal
         ============================================================ */
      html[data-theme="dark"] {
        --bg: oklch(0.17 0.008 240);
        --bg-2: oklch(0.2 0.009 240);
        --surface: oklch(0.24 0.01 240);
        --surface-2: oklch(0.28 0.012 240);
        --border: oklch(0.4 0.012 240 / 0.5);
        --border-strong: oklch(0.52 0.014 240 / 0.7);
        --ink: oklch(0.97 0.004 240);
        --ink-soft: oklch(0.85 0.008 240);
        --ink-mute: oklch(0.66 0.01 240);
        --accent: oklch(0.78 0.14 200);
        --accent-2: oklch(0.84 0.12 195);
        --accent-ink: oklch(0.18 0.04 220);
        --grid-line: oklch(0.5 0.012 240 / 0.07);
        --on-photo: oklch(0.99 0.006 200);
        --on-photo-soft: oklch(0.92 0.006 240);
        --scrim-top: oklch(0.1 0.008 240 / 0.95);
        --scrim-mid: oklch(0.11 0.008 240 / 0.55);
        --card-glow: oklch(0.78 0.14 200 / 0.16);
        --shadow: 0 24px 60px -24px oklch(0.05 0.01 240 / 0.85);
        --shadow-sm: 0 10px 30px -16px oklch(0.05 0.01 240 / 0.7);
      }
      html[data-theme="light"] {
        --bg: oklch(0.98 0.003 240);
        --bg-2: oklch(0.955 0.004 240);
        --surface: oklch(1 0 0);
        --surface-2: oklch(0.97 0.004 240);
        --border: oklch(0.8 0.01 240 / 0.95);
        --border-strong: oklch(0.7 0.012 240 / 0.95);
        --ink: oklch(0.22 0.014 240);
        --ink-soft: oklch(0.36 0.014 240);
        --ink-mute: oklch(0.48 0.012 240);
        --accent: oklch(0.55 0.13 218);
        --accent-2: oklch(0.5 0.13 220);
        --accent-ink: oklch(0.99 0.006 200);
        --grid-line: oklch(0.45 0.012 240 / 0.08);
        --on-photo: oklch(0.99 0.006 200);
        --on-photo-soft: oklch(0.93 0.006 240);
        --scrim-top: oklch(0.1 0.008 240 / 0.92);
        --scrim-mid: oklch(0.12 0.008 240 / 0.5);
        --card-glow: oklch(0.55 0.13 218 / 0.12);
        --shadow: 0 24px 56px -26px oklch(0.4 0.03 240 / 0.5);
        --shadow-sm: 0 10px 28px -18px oklch(0.4 0.03 240 / 0.4);
      }

      :root {
        --maxw: 1280px;
        --pad: clamp(1.15rem, 4vw, 3rem);
        --r: 6px;
        --r-lg: 10px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Rubik", sans-serif;
        font-weight: 400;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        transition: background 0.4s var(--ease), color 0.4s var(--ease);
      }

      /* faint blueprint grid behind everything */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -10;
        pointer-events: none;
        background-image: linear-gradient(
            to left,
            var(--grid-line) 1px,
            transparent 1px
          ),
          linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(
          ellipse 120% 90% at 50% 0%,
          #000 35%,
          transparent 100%
        );
      }

      h1,
      h2,
      h3 {
        font-family: "Rubik", sans-serif;
        font-weight: 800;
        line-height: 1.06;
        margin: 0;
        letter-spacing: -0.02em;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .mono {
        font-family: "JetBrains Mono", monospace;
        font-feature-settings: "tnum" 1;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--pad);
      }

      /* section code label — technical white-paper marker */
      .eyebrow {
        font-family: "JetBrains Mono", monospace;
        font-weight: 600;
        font-size: 0.74rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--accent);
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
      }
      .eyebrow::before {
        content: "";
        inline-size: 28px;
        block-size: 1px;
        background: currentColor;
        display: inline-block;
        flex: none;
      }

      /* ============ BUTTONS ============ */
      .btn {
        font-family: "Rubik", sans-serif;
        font-weight: 600;
        font-size: 0.98rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.85rem 1.55rem;
        min-block-size: 48px;
        border-radius: var(--r);
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
          background 0.25s var(--ease), border-color 0.25s var(--ease),
          color 0.25s var(--ease);
      }
      .btn svg {
        transition: transform 0.25s var(--ease);
      }
      .btn-primary {
        background: var(--accent);
        color: var(--accent-ink);
        box-shadow: 0 10px 30px -12px var(--accent);
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        background: var(--accent-2);
        box-shadow: 0 16px 38px -14px var(--accent);
      }
      /* RTL arrow points left */
      .btn:hover svg {
        transform: translateX(-5px);
      }
      .btn-ghost {
        background: transparent;
        color: var(--on-photo);
        border-color: oklch(0.95 0.01 240 / 0.4);
      }
      .btn-ghost:hover {
        transform: translateY(-2px);
        border-color: var(--accent);
        background: oklch(0.5 0.02 240 / 0.22);
      }
      .btn-outline {
        background: transparent;
        color: var(--ink);
        border-color: var(--border-strong);
      }
      .btn-outline:hover {
        transform: translateY(-2px);
        border-color: var(--accent);
        color: var(--accent);
      }

      /* ============ HEADER ============ */
      .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: oklch(0.17 0.008 240 / 0.7);
        backdrop-filter: blur(16px);
        border-block-end: 1px solid var(--border);
        transition: background 0.4s var(--ease);
      }
      html[data-theme="light"] .site-header {
        background: oklch(0.98 0.003 240 / 0.78);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        block-size: 72px;
      }
      .wordmark {
        font-family: "Rubik", sans-serif;
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: -0.03em;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 0.1rem;
      }
      .wordmark b {
        color: var(--accent);
        font-weight: 800;
      }
      .nav {
        display: none;
        gap: 1.7rem;
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 0.82rem;
        letter-spacing: 0.02em;
      }
      .nav a {
        position: relative;
        color: var(--ink-soft);
        padding-block: 0.3rem;
        transition: color 0.25s var(--ease);
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 0;
        inline-size: 0;
        block-size: 2px;
        background: var(--accent);
        transition: inline-size 0.3s var(--ease);
      }
      .nav a:hover {
        color: var(--ink);
      }
      .nav a:hover::after {
        inline-size: 100%;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }
      .theme-toggle {
        inline-size: 44px;
        block-size: 44px;
        display: grid;
        place-items: center;
        border-radius: var(--r);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          background 0.3s var(--ease);
      }
      .theme-toggle:hover {
        border-color: var(--accent);
      }
      .theme-toggle .icon-sun {
        display: none;
      }
      html[data-theme="light"] .theme-toggle .icon-sun {
        display: block;
      }
      html[data-theme="light"] .theme-toggle .icon-moon {
        display: none;
      }
      .header-cta {
        display: none;
      }
      @media (min-width: 900px) {
        .nav {
          display: flex;
        }
        .header-cta {
          display: inline-flex;
        }
      }

      /* ============ HERO — split / technical composition ============ */
      .hero {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        border-block-end: 1px solid var(--border);
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        min-block-size: clamp(560px, 90svh, 880px);
      }
      @media (min-width: 980px) {
        .hero-grid {
          grid-template-columns: 1.05fr 0.95fr;
        }
      }
      /* left/start = content panel */
      .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: clamp(3rem, 8vw, 5rem);
        padding-inline-end: clamp(1.15rem, 4vw, 3rem);
        padding-inline-start: clamp(1.15rem, 4vw, 3rem);
      }
      @media (min-width: 980px) {
        .hero-content {
          padding-inline-start: max(
            calc((100vw - var(--maxw)) / 2 + var(--pad)),
            var(--pad)
          );
          padding-inline-end: clamp(2rem, 4vw, 3.5rem);
        }
      }
      .hero-tick {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        color: var(--ink-mute);
        margin-block-end: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .hero-tick .dot {
        inline-size: 7px;
        block-size: 7px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent);
        flex: none;
      }
      .hero h1 {
        font-size: clamp(2.2rem, 6vw, 4rem);
        line-height: 1.04;
        color: var(--ink);
        text-wrap: balance;
        margin-block: 0.4rem 1.15rem;
        max-inline-size: 16ch;
      }
      .hero h1 .hl {
        color: var(--accent);
      }
      .hero-content > p {
        font-size: clamp(1rem, 1.5vw, 1.16rem);
        color: var(--ink-soft);
        max-inline-size: 52ch;
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-block-start: 1.9rem;
      }
      /* one small trust chip — court mentioned once only */
      .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-block-start: 1.5rem;
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 0.76rem;
        letter-spacing: 0.04em;
        color: var(--ink-soft);
        padding: 0.45rem 0.9rem;
        border-radius: var(--r);
        border: 1px solid var(--border-strong);
        background: var(--surface);
        width: fit-content;
      }
      .hero-chip svg {
        color: var(--accent);
        flex: none;
      }
      /* right = media carousel with technical frame */
      .hero-media {
        position: relative;
        min-block-size: 320px;
        z-index: 1;
        border-inline-start: 1px solid var(--border);
        overflow: hidden;
      }
      @media (max-width: 979px) {
        .hero-media {
          order: -1;
          min-block-size: 46svh;
          border-inline-start: 0;
          border-block-end: 1px solid var(--border);
        }
      }
      .hero-media .embla,
      .hero-media .embla__container,
      .hero-media .embla__slide {
        block-size: 100%;
      }
      .hero-media .embla {
        overflow: hidden;
        block-size: 100%;
      }
      .hero-media .embla__container {
        display: flex;
      }
      .hero-media .embla__slide {
        position: relative;
        flex: 0 0 100%;
        min-inline-size: 0;
      }
      .hero-media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      .hero-media::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient(
          to inline-start,
          transparent 55%,
          var(--scrim-mid) 100%
        );
      }
      /* corner measurement ticks on the media frame */
      .hero-frame {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
      }
      .hero-frame span {
        position: absolute;
        inline-size: 18px;
        block-size: 18px;
        border: 2px solid var(--accent);
      }
      .hero-frame .tl {
        inset-block-start: 14px;
        inset-inline-start: 14px;
        border-inline-end: 0;
        border-block-end: 0;
      }
      .hero-frame .tr {
        inset-block-start: 14px;
        inset-inline-end: 14px;
        border-inline-start: 0;
        border-block-end: 0;
      }
      .hero-frame .bl {
        inset-block-end: 14px;
        inset-inline-start: 14px;
        border-inline-end: 0;
        border-block-start: 0;
      }
      .hero-frame .br {
        inset-block-end: 14px;
        inset-inline-end: 14px;
        border-inline-start: 0;
        border-block-start: 0;
      }

      /* ============ STATS STRIP ============ */
      .stats {
        background: var(--bg-2);
        border-block-end: 1px solid var(--border);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
      }
      @media (min-width: 760px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .stat {
        padding: clamp(1.6rem, 3vw, 2.3rem) clamp(1.1rem, 2.5vw, 1.8rem);
        border-inline-start: 1px solid var(--border);
        position: relative;
        transition: background 0.3s var(--ease);
      }
      .stat:nth-child(2n + 1) {
        border-inline-start: 0;
      }
      @media (min-width: 760px) {
        .stat {
          border-inline-start: 1px solid var(--border);
        }
        .stat:first-child {
          border-inline-start: 0;
        }
        .stat:nth-child(2n + 1) {
          border-inline-start: 1px solid var(--border);
        }
      }
      .stat:hover {
        background: var(--surface);
      }
      .stat .idx {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.66rem;
        letter-spacing: 0.1em;
        color: var(--ink-mute);
      }
      .stat .num {
        font-family: "Rubik", sans-serif;
        font-weight: 800;
        font-size: clamp(1.5rem, 3.4vw, 2.1rem);
        color: var(--ink);
        line-height: 1.05;
        margin-block-start: 0.5rem;
        letter-spacing: -0.02em;
      }
      .stat .num em {
        color: var(--accent);
        font-style: normal;
      }
      .stat .lbl {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.74rem;
        letter-spacing: 0.06em;
        color: var(--ink-mute);
        margin-block-start: 0.35rem;
        text-transform: uppercase;
      }

      /* ============ SECTION SHELL ============ */
      .section {
        padding-block: clamp(4.5rem, 10vw, 7.5rem);
      }
      .section-head {
        max-inline-size: 720px;
        margin-block-end: clamp(2.4rem, 5vw, 3.4rem);
      }
      .section-head h2 {
        font-size: clamp(1.95rem, 4.6vw, 3rem);
        margin-block: 1rem 0.85rem;
        text-wrap: balance;
      }
      .section-head p {
        color: var(--ink-mute);
        font-size: 1.05rem;
        max-inline-size: 56ch;
      }

      /* ============ SERVICES — roomy technical cards ============ */
      .svc-grid {
        display: grid;
        gap: 1.4rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 720px) {
        .svc-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 1040px) {
        .svc-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .svc {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        overflow: hidden;
        transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
          border-color 0.4s var(--ease);
      }
      .svc:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow);
        border-color: var(--border-strong);
      }
      .svc-media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
      }
      .svc-media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .svc:hover .svc-media img {
        transform: scale(1.06);
      }
      .svc-media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          oklch(0.1 0.008 240 / 0.55),
          transparent 55%
        );
      }
      .svc-num {
        position: absolute;
        inset-block-start: 0.9rem;
        inset-inline-start: 0.9rem;
        z-index: 2;
        font-family: "JetBrains Mono", monospace;
        font-weight: 600;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--accent-ink);
        background: var(--accent);
        padding: 0.28rem 0.6rem;
        border-radius: 4px;
      }
      .svc-body {
        padding: clamp(1.5rem, 2.6vw, 2rem);
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .svc-body h3 {
        font-size: 1.4rem;
        color: var(--ink);
        margin-block-end: 0.6rem;
      }
      .svc-body > p {
        color: var(--ink-mute);
        font-size: 0.98rem;
        margin: 0 0 1.3rem;
      }
      .svc-list {
        list-style: none;
        margin: 0;
        padding-block-start: 1.2rem;
        border-block-start: 1px solid var(--border);
        display: grid;
        gap: 0.75rem;
      }
      .svc-list li {
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        color: var(--ink-soft);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .svc-list svg {
        flex: none;
        color: var(--accent);
      }

      /* ============ BEFORE / AFTER — CENTERPIECE ============ */
      .ba {
        background: var(--bg-2);
        position: relative;
        overflow: hidden;
        border-block: 1px solid var(--border);
      }
      .ba::before {
        content: "";
        position: absolute;
        inset-block-start: -25%;
        inset-inline-end: -12%;
        inline-size: 55vw;
        block-size: 55vw;
        background: radial-gradient(circle, var(--card-glow), transparent 70%);
        z-index: 0;
        pointer-events: none;
      }
      .ba .wrap {
        position: relative;
        z-index: 1;
      }
      .ba-stage {
        max-inline-size: 1040px;
        margin-inline: auto;
      }
      .ba-compare {
        position: relative;
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-strong);
        --pos: 50%;
        user-select: none;
        touch-action: pan-y;
      }
      .ba-layer {
        position: absolute;
        inset: 0;
      }
      .ba-layer img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      /* "after" sits on top, clipped. Physical positioning (RTL-safe):
         before stays on the RIGHT, after is revealed from the LEFT as --pos grows. */
      .ba-after {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }
      .ba-badge {
        position: absolute;
        inset-block-start: 1rem;
        font-family: "JetBrains Mono", monospace;
        font-weight: 600;
        font-size: 0.74rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.4rem 0.9rem;
        border-radius: 4px;
        background: oklch(0.1 0.008 240 / 0.74);
        color: var(--on-photo);
        backdrop-filter: blur(6px);
        z-index: 4;
        pointer-events: none;
      }
      .ba-badge.before {
        right: 1rem;
      }
      .ba-badge.after {
        left: 1rem;
        background: var(--accent);
        color: var(--accent-ink);
      }
      .ba-divider {
        position: absolute;
        inset-block: 0;
        left: var(--pos);
        inline-size: 2px;
        background: var(--accent);
        transform: translateX(-50%);
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 0 16px oklch(0.78 0.14 200 / 0.6);
      }
      .ba-handle {
        position: absolute;
        inset-block-start: 50%;
        left: var(--pos);
        transform: translate(-50%, -50%);
        inline-size: 50px;
        block-size: 50px;
        border-radius: var(--r);
        background: var(--accent);
        color: var(--accent-ink);
        display: grid;
        place-items: center;
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 6px 22px oklch(0.05 0.01 240 / 0.6);
      }
      .ba-range {
        position: absolute;
        inset-block-start: 50%;
        inset-inline: 0;
        transform: translateY(-50%);
        inline-size: 100%;
        block-size: 56px;
        margin: 0;
        z-index: 5;
        cursor: ew-resize;
        opacity: 0;
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        direction: ltr; /* keep range math LTR; value mapped to inline-end */
      }
      .ba-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        inline-size: 56px;
        block-size: 56px;
        border-radius: 50%;
      }
      .ba-range::-moz-range-thumb {
        inline-size: 56px;
        block-size: 56px;
        border: 0;
        border-radius: 50%;
      }
      .ba-range:focus-visible {
        opacity: 1;
        outline-offset: -3px;
      }
      .ba-caption {
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: var(--ink-mute);
        text-align: center;
        margin-block-start: 1.1rem;
      }
      /* projects gallery — Embla carousel (uses the project's embla-carousel lib) */
      .embla--gallery {
        margin-block-start: 2rem;
      }
      .embla--gallery .embla__viewport {
        overflow: hidden;
        border-radius: var(--r);
      }
      .embla--gallery .embla__container {
        display: flex;
        gap: 1.1rem;
        touch-action: pan-y;
      }
      .embla--gallery .embla__slide {
        position: relative;
        flex: 0 0 82%;
        min-inline-size: 0;
        border-radius: var(--r);
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
      }
      @media (min-width: 720px) {
        .embla--gallery .embla__slide {
          flex-basis: 46%;
        }
      }
      @media (min-width: 1040px) {
        .embla--gallery .embla__slide {
          flex-basis: 31.5%;
        }
      }
      .embla--gallery .embla__slide img {
        inline-size: 100%;
        aspect-ratio: 16 / 11;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .embla--gallery .embla__slide:hover img {
        transform: scale(1.06);
      }
      .embla--gallery .embla__slide span {
        position: absolute;
        inset-block-end: 0.8rem;
        inset-inline-start: 0.8rem;
        font-family: "JetBrains Mono", monospace;
        font-weight: 600;
        font-size: 0.74rem;
        letter-spacing: 0.04em;
        color: var(--on-photo);
        padding: 0.3rem 0.7rem;
        border-radius: 4px;
        background: oklch(0.1 0.008 240 / 0.65);
        backdrop-filter: blur(6px);
      }
      .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-block-start: 1.5rem;
      }
      .embla__btn {
        inline-size: 46px;
        block-size: 46px;
        border-radius: var(--r);
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          color 0.3s var(--ease);
      }
      .embla__btn:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-2px);
      }
      .embla__dots {
        display: flex;
        gap: 0.5rem;
      }
      .embla__dot {
        inline-size: 22px;
        block-size: 4px;
        border-radius: 2px;
        border: 0;
        padding: 0;
        cursor: pointer;
        background: var(--border-strong);
        transition: background 0.3s var(--ease), inline-size 0.3s var(--ease);
      }
      .embla__dot.is-selected {
        background: var(--accent);
        inline-size: 34px;
      }

      /* ============ ABOUT — clean portrait block ============ */
      .about-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        grid-template-columns: 1fr;
      }
      @media (min-width: 880px) {
        .about-grid {
          grid-template-columns: 0.82fr 1.18fr;
        }
      }
      .about-portrait {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-strong);
      }
      .about-portrait img {
        inline-size: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .about-portrait:hover img {
        transform: scale(1.04);
      }
      .about-portrait::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          oklch(0.1 0.008 240 / 0.7),
          transparent 45%
        );
        pointer-events: none;
      }
      .about-portrait .tag {
        position: absolute;
        inset-block-end: 1.1rem;
        inset-inline: 1.1rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        color: var(--on-photo);
      }
      .about-portrait .tag strong {
        font-family: "Rubik", sans-serif;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
      }
      .about-portrait .tag small {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: var(--on-photo-soft);
      }
      .about h2 {
        font-size: clamp(1.9rem, 4.6vw, 2.8rem);
        margin-block: 1rem 0.9rem;
        text-wrap: balance;
      }
      .about p {
        color: var(--ink-soft);
        font-size: 1.06rem;
        max-inline-size: 56ch;
      }
      .about-points {
        list-style: none;
        margin: 1.8rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.9rem;
      }
      .about-points li {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        font-weight: 500;
        color: var(--ink);
      }
      .about-points svg {
        flex: none;
        color: var(--accent);
        margin-block-start: 3px;
      }

      /* ============ FINAL CTA ============ */
      .cta-band {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        border-block-start: 1px solid var(--border);
      }
      .cta-band img {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        z-index: -2;
      }
      .cta-band::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          to top,
          var(--scrim-top),
          oklch(0.1 0.008 240 / 0.82)
        );
      }
      .cta-inner {
        text-align: center;
        padding-block: clamp(4rem, 10vw, 7rem);
        color: var(--on-photo);
      }
      .cta-inner h2 {
        font-size: clamp(2rem, 5.4vw, 3.4rem);
        color: var(--on-photo);
        max-inline-size: 22ch;
        margin-inline: auto;
        margin-block: 1rem 1.15rem;
        text-wrap: balance;
      }
      .cta-inner .eyebrow {
        color: var(--accent-2);
        justify-content: center;
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 1.3rem;
        justify-content: center;
        margin-block-start: 1.9rem;
        font-family: "JetBrains Mono", monospace;
        font-weight: 500;
        font-size: 0.88rem;
      }
      .cta-contact a,
      .cta-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--on-photo-soft);
      }
      .cta-contact a {
        transition: color 0.25s var(--ease);
      }
      .cta-contact a:hover {
        color: var(--on-photo);
      }
      .cta-contact svg {
        color: var(--accent-2);
        flex: none;
      }
      .cta-inner .btn {
        margin-block-start: 2.1rem;
      }

      /* ============ FOOTER ============ */
      .site-footer {
        background: var(--bg-2);
        border-block-start: 1px solid var(--border);
        padding-block: clamp(2.5rem, 5vw, 3.5rem);
      }
      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        align-items: flex-start;
      }
      @media (min-width: 720px) {
        .footer-inner {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }
      }
      .footer-tag {
        font-family: "JetBrains Mono", monospace;
        color: var(--ink-mute);
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        max-inline-size: 46ch;
        margin-block: 0.55rem 0;
      }
      .footer-copy {
        font-family: "JetBrains Mono", monospace;
        color: var(--ink-mute);
        font-size: 0.76rem;
        letter-spacing: 0.03em;
      }

      /* ============ REVEAL ANIM ============ */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        animation: rise 0.9s var(--ease) forwards;
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }
      .d1 {
        animation-delay: 0.08s;
      }
      .d2 {
        animation-delay: 0.2s;
      }
      .d3 {
        animation-delay: 0.32s;
      }
      .d4 {
        animation-delay: 0.44s;
      }
      .d5 {
        animation-delay: 0.56s;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>

