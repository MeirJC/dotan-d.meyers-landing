<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית, ייעוץ איטום ואפיון ציפויים | אמון אנושי</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Secular+One&family=Assistant:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "dark" || saved === "light" ? saved : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      :root {
        --font-display: "Secular One", system-ui, sans-serif;
        --font-body: "Assistant", system-ui, sans-serif;

        --r-sm: 14px;
        --r-md: 22px;
        --r-lg: 34px;
        --r-xl: 48px;
        --r-pill: 999px;

        --max: 1200px;
        --pad: clamp(1.1rem, 4vw, 2.5rem);

        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html[data-theme="light"] {
        --bg: oklch(0.967 0.018 78);
        --bg-2: oklch(0.99 0.012 86);
        --surface: oklch(0.995 0.008 88);
        --surface-2: oklch(0.955 0.022 72);
        --ink: oklch(0.28 0.03 52);
        --ink-soft: oklch(0.44 0.035 55);
        --ink-faint: oklch(0.56 0.03 58);
        --line: oklch(0.88 0.022 70);

        --clay: oklch(0.62 0.14 42);
        --clay-deep: oklch(0.52 0.15 38);
        --terra: oklch(0.66 0.16 48);
        --ochre: oklch(0.78 0.12 78);
        --sand: oklch(0.91 0.04 76);
        --forest: oklch(0.42 0.07 158);
        --forest-soft: oklch(0.55 0.08 160);

        --on-clay: oklch(0.98 0.01 80);
        --on-forest: oklch(0.97 0.02 120);

        --blob-a: oklch(0.86 0.09 60 / 0.55);
        --blob-b: oklch(0.84 0.07 150 / 0.4);

        --shadow-sm: 0 2px 8px oklch(0.4 0.05 50 / 0.07);
        --shadow-md: 0 14px 36px oklch(0.4 0.06 48 / 0.12);
        --shadow-lg: 0 30px 70px oklch(0.38 0.07 46 / 0.18);
      }

      html[data-theme="dark"] {
        --bg: oklch(0.21 0.018 50);
        --bg-2: oklch(0.25 0.02 52);
        --surface: oklch(0.27 0.022 52);
        --surface-2: oklch(0.31 0.025 54);
        --ink: oklch(0.95 0.018 78);
        --ink-soft: oklch(0.82 0.02 72);
        --ink-faint: oklch(0.68 0.022 68);
        --line: oklch(0.36 0.025 56);

        --clay: oklch(0.74 0.13 48);
        --clay-deep: oklch(0.68 0.14 44);
        --terra: oklch(0.76 0.14 52);
        --ochre: oklch(0.82 0.12 82);
        --sand: oklch(0.4 0.04 70);
        --forest: oklch(0.7 0.1 158);
        --forest-soft: oklch(0.62 0.09 160);

        --on-clay: oklch(0.2 0.02 50);
        --on-forest: oklch(0.18 0.02 120);

        --blob-a: oklch(0.55 0.1 55 / 0.4);
        --blob-b: oklch(0.5 0.08 155 / 0.32);

        --shadow-sm: 0 2px 8px oklch(0 0 0 / 0.3);
        --shadow-md: 0 16px 40px oklch(0 0 0 / 0.4);
        --shadow-lg: 0 34px 80px oklch(0 0 0 / 0.5);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: var(--font-body);
        background-color: var(--bg);
        color: var(--ink);
        line-height: 1.65;
        font-size: clamp(1rem, 0.95rem + 0.3vw, 1.12rem);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: -0.01em;
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      :focus-visible {
        outline: 3px solid var(--clay);
        outline-offset: 3px;
        border-radius: 6px;
      }

      .wrap {
        width: 100%;
        max-width: var(--max);
        margin-inline: auto;
        padding-inline: var(--pad);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        color: var(--clay-deep);
        background: color-mix(in oklab, var(--clay) 14%, transparent);
        padding: 0.4rem 0.9rem;
        border-radius: var(--r-pill);
      }
      .eyebrow .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--clay);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 1rem;
        padding: 0.95rem 1.7rem;
        border-radius: var(--r-pill);
        border: 1.5px solid transparent;
        cursor: pointer;
        transition:
          transform 0.3s var(--ease),
          box-shadow 0.3s var(--ease),
          background-color 0.3s var(--ease);
      }
      .btn svg {
        transition: transform 0.3s var(--ease);
      }
      .btn-primary {
        background: var(--clay);
        color: var(--on-clay);
        box-shadow: var(--shadow-md);
      }
      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
        background: var(--clay-deep);
      }
      .btn-primary:hover svg {
        transform: translateX(-4px);
      }
      .btn-ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }
      .btn-ghost:hover {
        transform: translateY(-3px);
        border-color: var(--clay);
        background: var(--surface);
      }
      .btn-ghost:hover svg {
        transform: translateX(-4px);
      }

      /* ============ HEADER ============ */
      header.site {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in oklab, var(--bg) 82%, transparent);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.85rem;
      }
      .brand {
        font-family: var(--font-display);
        font-size: 1.45rem;
        letter-spacing: 0.01em;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .brand .mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(140deg, var(--clay), var(--terra));
        color: var(--on-clay);
        font-size: 1.05rem;
        box-shadow: var(--shadow-sm);
      }
      .nav-links {
        display: none;
        align-items: center;
        gap: 0.4rem;
      }
      .nav-links a {
        padding: 0.5rem 0.85rem;
        border-radius: var(--r-pill);
        font-weight: 500;
        color: var(--ink-soft);
        transition:
          color 0.25s,
          background-color 0.25s;
      }
      .nav-links a:hover {
        color: var(--ink);
        background: color-mix(in oklab, var(--clay) 12%, transparent);
      }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .nav-cta {
        display: none;
      }
      .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition:
          transform 0.4s var(--ease),
          background-color 0.3s,
          border-color 0.3s;
      }
      .theme-toggle:hover {
        transform: rotate(-18deg) scale(1.06);
        border-color: var(--clay);
      }
      .theme-toggle .moon {
        display: none;
      }
      html[data-theme="dark"] .theme-toggle .sun {
        display: none;
      }
      html[data-theme="dark"] .theme-toggle .moon {
        display: block;
      }

      @media (min-width: 900px) {
        .nav-links {
          display: flex;
        }
        .nav-cta {
          display: inline-flex;
        }
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
        overflow: hidden;
      }
      .hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.9;
      }
      .blob.b1 {
        width: 46vw;
        height: 46vw;
        max-width: 560px;
        max-height: 560px;
        background: var(--blob-a);
        inset-block-start: -12%;
        inset-inline-start: -8%;
        animation: drift 22s var(--ease) infinite alternate;
      }
      .blob.b2 {
        width: 38vw;
        height: 38vw;
        max-width: 460px;
        max-height: 460px;
        background: var(--blob-b);
        inset-block-end: -14%;
        inset-inline-end: -6%;
        animation: drift 26s var(--ease) infinite alternate-reverse;
      }
      @keyframes drift {
        0% {
          transform: translate(0, 0) scale(1);
        }
        100% {
          transform: translate(4%, 6%) scale(1.12);
        }
      }

      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        align-items: center;
      }
      .hero-copy h1 {
        font-size: clamp(2.1rem, 1.4rem + 4.4vw, 4.1rem);
        margin-block: 1.1rem 1.1rem;
      }
      .hero-copy h1 .accent {
        color: var(--clay);
      }
      .hero-sub {
        color: var(--ink-soft);
        font-size: clamp(1rem, 0.95rem + 0.4vw, 1.18rem);
        max-width: 56ch;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-block-start: 1.7rem;
      }
      .hero-microtrust {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin-block-start: 1.8rem;
        color: var(--ink-faint);
        font-size: 0.92rem;
        font-weight: 500;
      }
      .hero-microtrust .checks {
        display: inline-flex;
        color: var(--forest);
      }

      .hero-media {
        position: relative;
      }
      .hero-frame {
        position: relative;
        border-radius: var(--r-xl);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        border: 6px solid var(--surface);
        aspect-ratio: 4 / 5;
      }
      .hero-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          165deg,
          transparent 40%,
          oklch(0.5 0.12 42 / 0.28)
        );
      }
      .hero-badge {
        position: absolute;
        inset-block-end: 1.1rem;
        inset-inline-start: 1.1rem;
        z-index: 2;
        background: color-mix(in oklab, var(--surface) 92%, transparent);
        backdrop-filter: blur(8px);
        border-radius: var(--r-md);
        padding: 0.9rem 1.1rem;
        box-shadow: var(--shadow-md);
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }
      .hero-badge .num {
        font-family: var(--font-display);
        font-size: 1.7rem;
        color: var(--clay);
        line-height: 1;
      }
      .hero-badge .lbl {
        font-size: 0.82rem;
        color: var(--ink-soft);
        line-height: 1.25;
      }
      .hero-pill-float {
        position: absolute;
        inset-block-start: 1.2rem;
        inset-inline-end: -0.4rem;
        z-index: 2;
        background: var(--forest);
        color: var(--on-forest);
        border-radius: var(--r-pill);
        padding: 0.6rem 1.1rem;
        font-weight: 600;
        font-size: 0.85rem;
        box-shadow: var(--shadow-md);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }

      @media (min-width: 880px) {
        .hero-grid {
          grid-template-columns: 1.05fr 0.95fr;
        }
      }

      /* ============ STATS ============ */
      .stats {
        position: relative;
        z-index: 2;
        margin-block-start: clamp(-1rem, -2vw, -2rem);
      }
      .stats-inner {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-md);
        padding: clamp(1.3rem, 3vw, 2rem);
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
      .stat {
        text-align: center;
        padding: 0.6rem;
        border-radius: var(--r-md);
      }
      .stat .v {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 1rem + 1.8vw, 2.3rem);
        color: var(--clay);
        line-height: 1;
      }
      .stat .l {
        margin-block-start: 0.45rem;
        font-size: 0.92rem;
        color: var(--ink-soft);
        font-weight: 500;
      }
      @media (min-width: 760px) {
        .stats-inner {
          grid-template-columns: repeat(4, 1fr);
        }
        .stat + .stat {
          border-inline-start: 1px solid var(--line);
        }
      }

      /* ============ SECTION SHELL ============ */
      section.block {
        padding-block: clamp(3.5rem, 8vw, 6.5rem);
      }
      .sec-head {
        max-width: 60ch;
        margin-block-end: clamp(2rem, 4vw, 3rem);
      }
      .sec-head h2 {
        font-size: clamp(1.8rem, 1.3rem + 2.4vw, 3rem);
        margin-block: 0.9rem 0.7rem;
      }
      .sec-head p {
        color: var(--ink-soft);
        margin: 0;
      }

      /* ============ SERVICES ============ */
      .services-grid {
        display: grid;
        gap: clamp(1.2rem, 2.5vw, 1.8rem);
      }
      .card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: clamp(1.5rem, 3vw, 2rem);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition:
          transform 0.4s var(--ease),
          box-shadow 0.4s var(--ease),
          border-color 0.4s var(--ease);
      }
      .card::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        width: 120px;
        height: 120px;
        background: radial-gradient(
          circle at top right,
          color-mix(in oklab, var(--clay) 22%, transparent),
          transparent 70%
        );
        opacity: 0;
        transition: opacity 0.4s var(--ease);
      }
      .card:hover {
        transform: translateY(-7px);
        box-shadow: var(--shadow-lg);
        border-color: color-mix(in oklab, var(--clay) 45%, var(--line));
      }
      .card:hover::before {
        opacity: 1;
      }
      .card .icon {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: linear-gradient(
          145deg,
          color-mix(in oklab, var(--clay) 18%, var(--surface)),
          color-mix(in oklab, var(--ochre) 22%, var(--surface))
        );
        color: var(--clay-deep);
        margin-block-end: 1.2rem;
      }
      .card h3 {
        font-size: 1.45rem;
        margin-block-end: 0.6rem;
      }
      .card > p {
        color: var(--ink-soft);
        margin: 0 0 1.2rem;
        font-size: 0.98rem;
      }
      .feat-list {
        display: grid;
        gap: 0.55rem;
      }
      .feat-list li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.94rem;
        color: var(--ink);
        font-weight: 500;
      }
      .feat-list li svg {
        flex: none;
        color: var(--forest);
      }
      @media (min-width: 760px) {
        .services-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      /* ============ BEFORE / AFTER ============ */
      .ba {
        background: var(--bg-2);
      }
      .ba-grid {
        display: grid;
        gap: 1.2rem;
      }
      .ba-card {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        aspect-ratio: 4 / 3;
        border: 5px solid var(--surface);
      }
      .ba-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease);
      }
      .ba-card:hover img {
        transform: scale(1.05);
      }
      .ba-tag {
        position: absolute;
        inset-block-start: 1rem;
        inset-inline-start: 1rem;
        font-family: var(--font-display);
        font-size: 0.95rem;
        padding: 0.4rem 1rem;
        border-radius: var(--r-pill);
        background: color-mix(in oklab, var(--surface) 90%, transparent);
        backdrop-filter: blur(6px);
        color: var(--ink);
        box-shadow: var(--shadow-sm);
      }
      .ba-card.after .ba-tag {
        background: var(--forest);
        color: var(--on-forest);
      }
      @media (min-width: 720px) {
        .ba-grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      /* ============ ABOUT ============ */
      .about-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        align-items: center;
      }
      .portrait-wrap {
        position: relative;
        max-width: 420px;
        margin-inline: auto;
      }
      .portrait {
        position: relative;
        z-index: 1;
        border-radius: 46% 54% 52% 48% / 54% 46% 54% 46%;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        box-shadow: var(--shadow-lg);
        border: 6px solid var(--surface);
      }
      .portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .portrait-wrap::before {
        content: "";
        position: absolute;
        inset: -6% -6% 8% 8%;
        z-index: 0;
        border-radius: 54% 46% 48% 52% / 46% 54% 46% 54%;
        background: linear-gradient(150deg, var(--ochre), var(--clay));
        opacity: 0.35;
        filter: blur(8px);
      }
      .portrait-chip {
        position: absolute;
        z-index: 2;
        inset-block-end: 4%;
        inset-inline-start: -4%;
        background: var(--surface);
        border-radius: var(--r-md);
        padding: 0.8rem 1.1rem;
        box-shadow: var(--shadow-md);
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-weight: 600;
      }
      .portrait-chip .ring {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: color-mix(in oklab, var(--forest) 16%, transparent);
        color: var(--forest);
      }
      .portrait-chip small {
        display: block;
        font-weight: 500;
        color: var(--ink-faint);
        font-size: 0.78rem;
      }

      .about-copy h2 {
        font-size: clamp(1.8rem, 1.3rem + 2.2vw, 2.7rem);
        margin-block: 0.9rem 1rem;
      }
      .about-copy p {
        color: var(--ink-soft);
      }
      .quote {
        margin-block-start: 1.8rem;
        position: relative;
        background: var(--surface);
        border: 1px solid var(--line);
        border-inline-start: 4px solid var(--clay);
        border-radius: var(--r-md);
        padding: 1.4rem 1.5rem;
        box-shadow: var(--shadow-sm);
      }
      .quote .mark {
        font-family: var(--font-display);
        font-size: 2.6rem;
        color: var(--clay);
        opacity: 0.45;
        line-height: 0.6;
      }
      .quote p {
        font-size: 1.08rem;
        color: var(--ink);
        margin: 0.5rem 0 0.9rem;
        font-weight: 500;
      }
      .quote .by {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }
      .stars {
        display: inline-flex;
        gap: 2px;
        color: var(--ochre);
      }
      @media (min-width: 860px) {
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
        }
      }

      /* ============ FINAL CTA ============ */
      .cta-band {
        position: relative;
        overflow: hidden;
        background: linear-gradient(150deg, var(--clay-deep), var(--terra));
        border-radius: var(--r-xl);
        padding: clamp(2.4rem, 6vw, 4.5rem);
        color: var(--on-clay);
        box-shadow: var(--shadow-lg);
      }
      .cta-band::before,
      .cta-band::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        filter: blur(50px);
        pointer-events: none;
      }
      .cta-band::before {
        width: 320px;
        height: 320px;
        background: oklch(0.85 0.12 80 / 0.4);
        inset-block-start: -30%;
        inset-inline-end: -8%;
      }
      .cta-band::after {
        width: 280px;
        height: 280px;
        background: oklch(0.5 0.1 150 / 0.35);
        inset-block-end: -34%;
        inset-inline-start: -6%;
      }
      .cta-inner {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 1.6rem;
        align-items: center;
      }
      .cta-band h2 {
        font-size: clamp(1.7rem, 1.2rem + 2.6vw, 2.8rem);
        color: var(--on-clay);
      }
      .cta-band p {
        margin: 0.7rem 0 0;
        color: color-mix(in oklab, var(--on-clay) 88%, transparent);
        max-width: 50ch;
      }
      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
      }
      .btn-onclay {
        background: var(--on-clay);
        color: var(--clay-deep);
      }
      .btn-onclay:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
      }
      .btn-onclay:hover svg {
        transform: translateX(-4px);
      }
      .btn-outline-light {
        background: transparent;
        color: var(--on-clay);
        border-color: color-mix(in oklab, var(--on-clay) 55%, transparent);
      }
      .btn-outline-light:hover {
        transform: translateY(-3px);
        background: color-mix(in oklab, var(--on-clay) 14%, transparent);
      }
      .btn-outline-light:hover svg {
        transform: translateX(-4px);
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 1.3rem;
        margin-block-start: 0.4rem;
      }
      .cta-contact a,
      .cta-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--on-clay);
      }
      @media (min-width: 820px) {
        .cta-inner {
          grid-template-columns: 1.3fr 0.7fr;
        }
        .cta-actions {
          justify-content: flex-end;
        }
      }

      /* ============ FOOTER ============ */
      footer.site {
        background: var(--bg-2);
        border-top: 1px solid var(--line);
        padding-block: clamp(2.5rem, 5vw, 3.5rem) 2rem;
      }
      .foot-grid {
        display: grid;
        gap: 1.6rem;
        align-items: start;
      }
      .foot-grid p {
        color: var(--ink-soft);
        margin: 0.7rem 0 0;
        max-width: 42ch;
      }
      .foot-contact {
        display: grid;
        gap: 0.6rem;
      }
      .foot-contact a,
      .foot-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--ink-soft);
        font-weight: 500;
      }
      .foot-contact a:hover {
        color: var(--clay);
      }
      .foot-contact svg {
        color: var(--clay);
        flex: none;
      }
      .foot-bottom {
        margin-block-start: clamp(2rem, 4vw, 3rem);
        padding-block-start: 1.4rem;
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        justify-content: space-between;
        align-items: center;
        color: var(--ink-faint);
        font-size: 0.88rem;
      }
      @media (min-width: 720px) {
        .foot-grid {
          grid-template-columns: 1.4fr 1fr;
        }
      }

      /* ============ REVEAL ANIMATIONS ============ */
      .reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: rise 0.9s var(--ease) forwards;
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .d1 {
        animation-delay: 0.08s;
      }
      .d2 {
        animation-delay: 0.2s;
      }
      .d3 {
        animation-delay: 0.32s;
      }
      .d4 {
        animation-delay: 0.44s;
      }
      .d5 {
        animation-delay: 0.56s;
      }
      .d6 {
        animation-delay: 0.68s;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
