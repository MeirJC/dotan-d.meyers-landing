<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית · ייעוץ איטום · אפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Secular+One&family=Rubik:wght@500;600;700&family=Assistant:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "dark" || saved === "light" ? saved : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      :root {
        --font-display: "Secular One", "Rubik", system-ui, sans-serif;
        --font-alt: "Rubik", system-ui, sans-serif;
        --font-body: "Assistant", system-ui, sans-serif;

        --r-sm: 14px;
        --r-md: 20px;
        --r-lg: 28px;
        --r-xl: 40px;
        --r-pill: 999px;

        --max: 1180px;
        --pad: clamp(1.15rem, 4vw, 2.4rem);

        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* ---------- LIGHT (warm cream + clay/terracotta + forest) ---------- */
      html[data-theme="light"] {
        --bg: oklch(0.968 0.018 76);
        --bg-2: oklch(0.992 0.012 84);
        --surface: oklch(0.997 0.006 88);
        --surface-2: oklch(0.952 0.024 72);
        --ink: oklch(0.27 0.03 50);
        --ink-soft: oklch(0.44 0.034 54);
        --ink-faint: oklch(0.55 0.028 58);
        --line: oklch(0.885 0.02 70);
        --line-soft: oklch(0.93 0.016 74);

        --clay: oklch(0.56 0.15 38);
        --clay-deep: oklch(0.47 0.155 34);
        --terra: oklch(0.62 0.165 44);
        --ochre: oklch(0.79 0.115 78);
        --sand: oklch(0.91 0.04 76);
        --forest: oklch(0.4 0.075 158);
        --forest-soft: oklch(0.54 0.08 160);

        --on-clay: oklch(0.985 0.01 80);
        --on-forest: oklch(0.97 0.02 120);
        --on-photo: oklch(0.99 0.01 90);
        --on-photo-soft: oklch(0.94 0.012 80);
        --scrim: oklch(0.22 0.04 44 / 0.62);

        --blob-a: oklch(0.86 0.09 60 / 0.5);
        --blob-b: oklch(0.84 0.07 150 / 0.34);

        --shadow-sm: 0 2px 8px oklch(0.4 0.05 50 / 0.08);
        --shadow-md: 0 14px 34px oklch(0.4 0.06 48 / 0.13);
        --shadow-lg: 0 30px 64px oklch(0.38 0.07 46 / 0.18);
      }

      /* ---------- DARK (cozy warm charcoal) ---------- */
      html[data-theme="dark"] {
        --bg: oklch(0.2 0.018 48);
        --bg-2: oklch(0.24 0.02 50);
        --surface: oklch(0.265 0.022 52);
        --surface-2: oklch(0.31 0.025 54);
        --ink: oklch(0.95 0.018 78);
        --ink-soft: oklch(0.82 0.02 72);
        --ink-faint: oklch(0.69 0.022 68);
        --line: oklch(0.37 0.025 56);
        --line-soft: oklch(0.32 0.022 54);

        --clay: oklch(0.76 0.13 50);
        --clay-deep: oklch(0.7 0.14 46);
        --terra: oklch(0.78 0.14 54);
        --ochre: oklch(0.83 0.12 82);
        --sand: oklch(0.4 0.04 70);
        --forest: oklch(0.74 0.1 158);
        --forest-soft: oklch(0.64 0.09 160);

        --on-clay: oklch(0.18 0.02 50);
        --on-forest: oklch(0.16 0.02 120);
        --on-photo: oklch(0.99 0.01 90);
        --on-photo-soft: oklch(0.93 0.012 80);
        --scrim: oklch(0.12 0.02 44 / 0.66);

        --blob-a: oklch(0.55 0.1 55 / 0.36);
        --blob-b: oklch(0.5 0.08 155 / 0.28);

        --shadow-sm: 0 2px 8px oklch(0 0 0 / 0.32);
        --shadow-md: 0 16px 38px oklch(0 0 0 / 0.44);
        --shadow-lg: 0 34px 76px oklch(0 0 0 / 0.54);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: var(--font-body);
        background-color: var(--bg);
        color: var(--ink);
        line-height: 1.65;
        font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1rem);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        transition:
          background-color 0.4s var(--ease),
          color 0.4s var(--ease);
      }
      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.01em;
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        display: block;
        max-width: 100%;
      }
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      :focus-visible {
        outline: 3px solid var(--clay);
        outline-offset: 3px;
        border-radius: 8px;
      }

      .wrap {
        width: 100%;
        max-width: var(--max);
        margin-inline: auto;
        padding-inline: var(--pad);
      }
      .skip-link {
        position: absolute;
        inset-inline-start: 0;
        inset-block-start: -100%;
        z-index: 100;
        background: var(--clay);
        color: var(--on-clay);
        padding: 0.7rem 1.2rem;
        border-radius: 0 0 var(--r-sm) 0;
        font-weight: 600;
      }
      .skip-link:focus {
        inset-block-start: 0;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        color: var(--clay-deep);
        background: color-mix(in oklab, var(--clay) 13%, transparent);
        padding: 0.42rem 0.95rem;
        border-radius: var(--r-pill);
      }
      .eyebrow .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--clay);
        flex: none;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 1rem;
        min-block-size: 48px;
        padding: 0.9rem 1.65rem;
        border-radius: var(--r-pill);
        border: 1.5px solid transparent;
        cursor: pointer;
        transition:
          transform 0.3s var(--ease),
          box-shadow 0.3s var(--ease),
          background-color 0.3s var(--ease),
          border-color 0.3s var(--ease);
      }
      .btn svg {
        transition: transform 0.3s var(--ease);
      }
      /* RTL: arrow points to the inline-start (left) */
      .btn:hover svg {
        transform: translateX(-4px);
      }
      .btn-primary {
        background: var(--clay);
        color: var(--on-clay);
        box-shadow: var(--shadow-md);
      }
      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
        background: var(--clay-deep);
      }
      .btn-ghost {
        background: var(--surface);
        color: var(--ink);
        border-color: var(--line);
      }
      .btn-ghost:hover {
        transform: translateY(-3px);
        border-color: var(--clay);
      }
      .btn-onphoto {
        background: color-mix(in oklab, var(--surface) 22%, transparent);
        color: var(--on-photo);
        border-color: color-mix(in oklab, var(--on-photo) 42%, transparent);
        backdrop-filter: blur(10px);
      }
      .btn-onphoto:hover {
        transform: translateY(-3px);
        background: color-mix(in oklab, var(--surface) 34%, transparent);
        border-color: var(--ochre);
      }

      /* ============ HEADER ============ */
      header.site {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: color-mix(in oklab, var(--bg) 78%, transparent);
        backdrop-filter: blur(14px);
        border-block-end: 1px solid var(--line-soft);
        transition: background-color 0.4s var(--ease);
      }
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.8rem;
      }
      .brand {
        font-family: var(--font-display);
        font-size: 1.4rem;
        letter-spacing: 0.01em;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      .brand .mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(140deg, var(--clay), var(--terra));
        color: var(--on-clay);
        font-size: 0.95rem;
        box-shadow: var(--shadow-sm);
      }
      .nav-links {
        display: none;
        align-items: center;
        gap: 0.3rem;
      }
      .nav-links a {
        padding: 0.5rem 0.85rem;
        border-radius: var(--r-pill);
        font-weight: 600;
        font-size: 0.96rem;
        color: var(--ink-soft);
        transition:
          color 0.25s,
          background-color 0.25s;
      }
      .nav-links a:hover {
        color: var(--ink);
        background: color-mix(in oklab, var(--clay) 11%, transparent);
      }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }
      .nav-cta {
        display: none;
        font-size: 0.95rem;
        padding: 0.7rem 1.3rem;
      }
      .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        flex: none;
        transition:
          transform 0.4s var(--ease),
          background-color 0.3s,
          border-color 0.3s;
      }
      .theme-toggle:hover {
        transform: rotate(-18deg) scale(1.06);
        border-color: var(--clay);
      }
      .theme-toggle .moon {
        display: none;
      }
      html[data-theme="dark"] .theme-toggle .sun {
        display: none;
      }
      html[data-theme="dark"] .theme-toggle .moon {
        display: block;
      }
      @media (min-width: 900px) {
        .nav-links {
          display: flex;
        }
        .nav-cta {
          display: inline-flex;
        }
      }

      /* ============ HERO (human-led, warm) ============ */
      .hero {
        position: relative;
        padding-block: clamp(2.4rem, 5.5vw, 4.4rem) clamp(3rem, 7vw, 5.4rem);
        overflow: hidden;
      }
      .hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(64px);
      }
      .blob.b1 {
        width: 46vw;
        height: 46vw;
        max-width: 540px;
        max-height: 540px;
        background: var(--blob-a);
        inset-block-start: -14%;
        inset-inline-start: -8%;
        animation: drift 24s var(--ease) infinite alternate;
      }
      .blob.b2 {
        width: 38vw;
        height: 38vw;
        max-width: 440px;
        max-height: 440px;
        background: var(--blob-b);
        inset-block-end: -16%;
        inset-inline-end: -6%;
        animation: drift 28s var(--ease) infinite alternate-reverse;
      }
      @keyframes drift {
        0% {
          transform: translate(0, 0) scale(1);
        }
        100% {
          transform: translate(4%, 6%) scale(1.1);
        }
      }

      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        gap: clamp(2.4rem, 5vw, 3.6rem);
        align-items: center;
      }
      .hero-copy h1 {
        font-size: clamp(2.2rem, 1.4rem + 4.4vw, 4rem);
        margin-block: 1.1rem 1.1rem;
        text-wrap: balance;
        max-inline-size: 15ch;
      }
      .hero-copy h1 .accent {
        color: var(--clay);
        white-space: nowrap;
      }
      .hero-sub {
        color: var(--ink-soft);
        font-size: clamp(1rem, 0.95rem + 0.4vw, 1.16rem);
        max-width: 54ch;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-block-start: 1.7rem;
      }
      .hero-trust {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem 0.85rem;
        margin-block-start: 1.6rem;
        color: var(--ink-faint);
        font-size: 0.92rem;
        font-weight: 600;
      }
      /* ONE small court chip only */
      .hero-trust .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.9rem;
        border-radius: var(--r-pill);
        background: color-mix(in oklab, var(--forest) 12%, transparent);
        color: var(--forest);
        border: 1px solid color-mix(in oklab, var(--forest) 24%, transparent);
        font-size: 0.85rem;
      }
      .hero-trust .note {
        color: var(--ink-faint);
      }

      /* Hero media: portrait-led frame + small Embla showcase strip */
      .hero-media {
        position: relative;
        max-width: 480px;
        margin-inline: auto;
        width: 100%;
      }
      .hero-media::before {
        content: "";
        position: absolute;
        inset: -7% -5% 5% 7%;
        z-index: 0;
        border-radius: 52% 48% 46% 54% / 48% 54% 46% 52%;
        background: linear-gradient(150deg, var(--ochre), var(--clay));
        opacity: 0.3;
        filter: blur(10px);
      }
      .hero-frame {
        position: relative;
        z-index: 1;
        border-radius: var(--r-xl) var(--r-xl) var(--r-xl) 64px;
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        border: 7px solid var(--surface);
        aspect-ratio: 4 / 5;
      }
      .hero-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          transparent 50%,
          oklch(0.28 0.05 44 / 0.5)
        );
      }
      /* warm human intro card pinned to portrait */
      .hero-card {
        position: absolute;
        z-index: 3;
        inset-block-end: 1rem;
        inset-inline-start: -0.6rem;
        inset-inline-end: 1.4rem;
        background: color-mix(in oklab, var(--surface) 94%, transparent);
        backdrop-filter: blur(10px);
        border: 1px solid var(--line-soft);
        border-radius: var(--r-md);
        padding: 0.85rem 1rem;
        box-shadow: var(--shadow-md);
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .hero-card .av {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        flex: none;
        background: color-mix(in oklab, var(--clay) 16%, var(--surface));
        color: var(--clay-deep);
      }
      .hero-card .name {
        font-family: var(--font-display);
        font-size: 1.02rem;
        color: var(--ink);
        line-height: 1.15;
      }
      .hero-card small {
        display: block;
        font-weight: 600;
        color: var(--ink-faint);
        font-size: 0.78rem;
        font-family: var(--font-body);
      }
      /* Embla showcase strip beneath the portrait */
      .hero-strip {
        margin-block-start: 1.1rem;
      }
      .hero-strip .embla__viewport {
        overflow: hidden;
        border-radius: var(--r-md);
      }
      .hero-strip .embla__container {
        display: flex;
        touch-action: pan-y;
      }
      .hero-strip .embla__slide {
        position: relative;
        flex: 0 0 100%;
        min-inline-size: 0;
      }
      .hero-strip .embla__slide img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }
      .hero-strip .embla__slide span {
        position: absolute;
        inset-block-end: 0.6rem;
        inset-inline-start: 0.6rem;
        font-family: var(--font-alt);
        font-weight: 600;
        font-size: 0.78rem;
        color: var(--on-photo);
        padding: 0.3rem 0.75rem;
        border-radius: var(--r-pill);
        background: var(--scrim);
        backdrop-filter: blur(6px);
      }
      @media (min-width: 880px) {
        .hero-grid {
          grid-template-columns: 1.08fr 0.92fr;
        }
        .hero-media {
          margin-inline: 0 auto;
        }
      }

      /* ============ STATS ============ */
      .stats {
        position: relative;
        z-index: 3;
        margin-block-start: clamp(-1.5rem, -3vw, -2.4rem);
      }
      .stats-inner {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-md);
        padding: clamp(1.2rem, 3vw, 1.9rem);
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
      }
      .stat {
        text-align: center;
        padding: 0.7rem 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
      }
      .stat .v {
        font-family: var(--font-display);
        font-size: clamp(1.55rem, 1rem + 1.9vw, 2.25rem);
        color: var(--clay);
        line-height: 1;
      }
      .stat .l {
        font-size: 0.92rem;
        color: var(--ink-soft);
        font-weight: 600;
        line-height: 1.3;
      }
      @media (min-width: 760px) {
        .stats-inner {
          grid-template-columns: repeat(4, 1fr);
        }
        .stat + .stat {
          border-inline-start: 1px solid var(--line);
        }
      }

      /* ============ SECTION SHELL ============ */
      section.block {
        padding-block: clamp(3.4rem, 7.5vw, 6rem);
      }
      .sec-head {
        max-width: 58ch;
        margin-block-end: clamp(2rem, 4vw, 2.8rem);
      }
      .sec-head h2 {
        font-size: clamp(1.85rem, 1.3rem + 2.4vw, 2.9rem);
        margin-block: 0.85rem 0.65rem;
        text-wrap: balance;
      }
      .sec-head p {
        color: var(--ink-soft);
        margin: 0;
      }
      .sec-head.center {
        margin-inline: auto;
        text-align: center;
      }
      .sec-head.center .eyebrow {
        margin-inline: auto;
      }

      /* ============ SERVICES ============ */
      .services-grid {
        display: grid;
        gap: clamp(1.1rem, 2.4vw, 1.6rem);
      }
      .card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: clamp(1.5rem, 3vw, 1.9rem);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition:
          transform 0.4s var(--ease),
          box-shadow 0.4s var(--ease),
          border-color 0.4s var(--ease);
      }
      .card::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline-end: 0;
        width: 150px;
        height: 150px;
        background: radial-gradient(
          circle at top left,
          color-mix(in oklab, var(--clay) 20%, transparent),
          transparent 70%
        );
        opacity: 0;
        transition: opacity 0.4s var(--ease);
      }
      .card:hover {
        transform: translateY(-7px);
        box-shadow: var(--shadow-lg);
        border-color: color-mix(in oklab, var(--clay) 42%, var(--line));
      }
      .card:hover::before {
        opacity: 1;
      }
      .card .icon {
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        border-radius: 18px;
        background: linear-gradient(
          145deg,
          color-mix(in oklab, var(--clay) 18%, var(--surface)),
          color-mix(in oklab, var(--ochre) 22%, var(--surface))
        );
        color: var(--clay-deep);
        margin-block-end: 1.15rem;
      }
      .card .num {
        position: absolute;
        inset-block-start: 1.4rem;
        inset-inline-start: 1.6rem;
        font-family: var(--font-display);
        font-size: 0.85rem;
        color: var(--ink-faint);
        letter-spacing: 0.05em;
      }
      .card h3 {
        font-size: 1.4rem;
        margin-block-end: 0.55rem;
      }
      .card > p {
        color: var(--ink-soft);
        margin: 0 0 1.15rem;
        font-size: 0.97rem;
      }
      .feat-list {
        display: grid;
        gap: 0.55rem;
        margin-block-start: auto;
        padding-block-start: 0.35rem;
      }
      .feat-list li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.93rem;
        color: var(--ink);
        font-weight: 600;
      }
      .feat-list li svg {
        flex: none;
        color: var(--forest);
      }
      @media (min-width: 760px) {
        .services-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      /* ============ BEFORE / AFTER SLIDER (physical, RTL-correct) ======= */
      .ba {
        background: var(--bg-2);
      }
      .ba-stage {
        max-width: 920px;
        margin-inline: auto;
      }
      .ba-compare {
        position: relative;
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        border: 6px solid var(--surface);
        --pos: 50%;
        user-select: none;
        touch-action: pan-y;
      }
      .ba-layer {
        position: absolute;
        inset: 0;
      }
      .ba-layer img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      /* "after" sits on top, clipped. Physical positioning (RTL-safe):
         before stays on the RIGHT, after is revealed from the LEFT as --pos grows. */
      .ba-after {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }
      .ba-badge {
        position: absolute;
        inset-block-start: 0.9rem;
        font-family: var(--font-alt);
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.36rem 0.95rem;
        border-radius: var(--r-pill);
        backdrop-filter: blur(6px);
        box-shadow: var(--shadow-sm);
        z-index: 4;
        pointer-events: none;
      }
      .ba-badge.before {
        right: 0.9rem;
        background: color-mix(in oklab, var(--surface) 90%, transparent);
        color: var(--ink);
      }
      .ba-badge.after {
        left: 0.9rem;
        background: var(--forest);
        color: var(--on-forest);
      }
      .ba-divider {
        position: absolute;
        inset-block: 0;
        left: var(--pos);
        inline-size: 3px;
        background: var(--surface);
        transform: translateX(-50%);
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 0 0 1px oklch(0 0 0 / 0.1);
      }
      .ba-handle {
        position: absolute;
        inset-block-start: 50%;
        left: var(--pos);
        transform: translate(-50%, -50%);
        inline-size: 52px;
        block-size: 52px;
        border-radius: 50%;
        background: var(--surface);
        color: var(--clay-deep);
        display: grid;
        place-items: center;
        z-index: 3;
        pointer-events: none;
        box-shadow: var(--shadow-md);
      }
      .ba-range {
        position: absolute;
        inset-block-start: 50%;
        inset-inline: 0;
        transform: translateY(-50%);
        inline-size: 100%;
        block-size: 56px;
        margin: 0;
        z-index: 5;
        cursor: ew-resize;
        opacity: 0;
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        direction: ltr; /* keep range math LTR; value mapped via --pos */
      }
      .ba-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        inline-size: 56px;
        block-size: 56px;
        border-radius: 50%;
      }
      .ba-range::-moz-range-thumb {
        inline-size: 56px;
        block-size: 56px;
        border: 0;
        border-radius: 50%;
      }
      .ba-range:focus-visible {
        opacity: 1;
        outline-offset: -3px;
      }
      .ba-hint {
        margin-block-start: 1rem;
        text-align: center;
        color: var(--ink-faint);
        font-size: 0.9rem;
        font-weight: 600;
      }

      /* projects gallery — Embla carousel */
      .gallery {
        margin-block-start: clamp(2rem, 4vw, 2.8rem);
      }
      .gallery .embla__viewport {
        overflow: hidden;
        border-radius: var(--r-md);
      }
      .gallery .embla__container {
        display: flex;
        gap: 1.1rem;
        touch-action: pan-y;
      }
      .gallery .embla__slide {
        position: relative;
        flex: 0 0 84%;
        min-inline-size: 0;
        border-radius: var(--r-md);
        overflow: hidden;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-sm);
      }
      @media (min-width: 720px) {
        .gallery .embla__slide {
          flex-basis: 47%;
        }
      }
      @media (min-width: 1040px) {
        .gallery .embla__slide {
          flex-basis: 31.5%;
        }
      }
      .gallery .embla__slide img {
        inline-size: 100%;
        aspect-ratio: 16 / 11;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .gallery .embla__slide:hover img {
        transform: scale(1.06);
      }
      .gallery .embla__slide span {
        position: absolute;
        inset-block-end: 0.8rem;
        inset-inline-start: 0.8rem;
        font-family: var(--font-alt);
        font-weight: 600;
        font-size: 0.82rem;
        color: var(--on-photo);
        padding: 0.35rem 0.85rem;
        border-radius: var(--r-pill);
        background: var(--scrim);
        backdrop-filter: blur(6px);
      }
      .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-block-start: 1.4rem;
      }
      .embla__btn {
        inline-size: 46px;
        block-size: 46px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 1.5px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition:
          transform 0.3s var(--ease),
          border-color 0.3s var(--ease);
      }
      .embla__btn:hover {
        border-color: var(--clay);
        transform: translateY(-2px);
      }
      .embla__dots {
        display: flex;
        gap: 0.5rem;
      }
      .embla__dot {
        inline-size: 9px;
        block-size: 9px;
        border-radius: 50%;
        border: 0;
        padding: 0;
        cursor: pointer;
        background: var(--line);
        transition:
          background-color 0.3s var(--ease),
          transform 0.3s var(--ease);
      }
      .embla__dot.is-selected {
        background: var(--clay);
        transform: scale(1.25);
      }

      /* ============ ABOUT + TESTIMONIAL ============ */
      .about-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        align-items: center;
      }
      .portrait-wrap {
        position: relative;
        max-width: 400px;
        margin-inline: auto;
      }
      .portrait {
        position: relative;
        z-index: 1;
        border-radius: 46% 54% 52% 48% / 54% 46% 54% 46%;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        box-shadow: var(--shadow-lg);
        border: 7px solid var(--surface);
      }
      .portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .portrait-wrap::before {
        content: "";
        position: absolute;
        inset: -6% -6% 8% 8%;
        z-index: 0;
        border-radius: 54% 46% 48% 52% / 46% 54% 46% 54%;
        background: linear-gradient(150deg, var(--ochre), var(--clay));
        opacity: 0.3;
        filter: blur(10px);
      }
      .about-copy h2 {
        font-size: clamp(1.85rem, 1.3rem + 2.2vw, 2.6rem);
        margin-block: 0.85rem 0.95rem;
        text-wrap: balance;
      }
      .about-copy > p {
        color: var(--ink-soft);
        margin: 0;
        max-width: 54ch;
      }
      .quote {
        margin-block-start: 1.8rem;
        position: relative;
        background: var(--surface);
        border: 1px solid var(--line);
        border-inline-start: 4px solid var(--clay);
        border-radius: var(--r-md);
        padding: 1.35rem 1.45rem;
        box-shadow: var(--shadow-sm);
      }
      .quote .mark {
        font-family: var(--font-display);
        font-size: 2.4rem;
        color: var(--clay);
        opacity: 0.42;
        line-height: 0.55;
      }
      .quote p {
        font-size: 1.06rem;
        color: var(--ink);
        margin: 0.45rem 0 0.85rem;
        font-weight: 600;
      }
      .quote .by {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }
      .stars {
        display: inline-flex;
        gap: 2px;
        color: var(--ochre);
      }
      @media (min-width: 860px) {
        .about-grid {
          grid-template-columns: 0.82fr 1.18fr;
        }
      }

      /* ============ FINAL CTA ============ */
      .cta-band {
        position: relative;
        overflow: hidden;
        background: linear-gradient(150deg, var(--clay-deep), var(--terra));
        border-radius: var(--r-xl);
        padding: clamp(2.3rem, 6vw, 4.2rem);
        color: var(--on-clay);
        box-shadow: var(--shadow-lg);
      }
      .cta-band::before,
      .cta-band::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        filter: blur(54px);
        pointer-events: none;
      }
      .cta-band::before {
        width: 320px;
        height: 320px;
        background: oklch(0.85 0.12 80 / 0.38);
        inset-block-start: -30%;
        inset-inline-end: -8%;
      }
      .cta-band::after {
        width: 280px;
        height: 280px;
        background: oklch(0.5 0.1 150 / 0.32);
        inset-block-end: -34%;
        inset-inline-start: -6%;
      }
      .cta-inner {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 1.5rem;
        align-items: center;
      }
      .cta-band h2 {
        font-size: clamp(1.7rem, 1.2rem + 2.6vw, 2.7rem);
        color: var(--on-clay);
        text-wrap: balance;
      }
      .cta-band > .cta-inner p {
        margin: 0.65rem 0 0;
        color: color-mix(in oklab, var(--on-clay) 88%, transparent);
        max-width: 48ch;
      }
      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .btn-onclay {
        background: var(--on-clay);
        color: var(--clay-deep);
      }
      .btn-onclay:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
      }
      .btn-outline-light {
        background: transparent;
        color: var(--on-clay);
        border-color: color-mix(in oklab, var(--on-clay) 55%, transparent);
      }
      .btn-outline-light:hover {
        transform: translateY(-3px);
        background: color-mix(in oklab, var(--on-clay) 14%, transparent);
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.3rem;
        margin-block-start: 1.3rem;
      }
      .cta-contact a,
      .cta-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--on-clay);
      }
      .cta-contact svg {
        flex: none;
      }
      @media (min-width: 820px) {
        .cta-inner {
          grid-template-columns: 1.3fr 0.7fr;
        }
        .cta-actions {
          justify-content: flex-end;
        }
      }

      /* ============ FOOTER ============ */
      footer.site {
        background: var(--bg-2);
        border-block-start: 1px solid var(--line);
        padding-block: clamp(2.4rem, 5vw, 3.4rem) 2rem;
      }
      .foot-grid {
        display: grid;
        gap: 1.6rem;
        align-items: start;
      }
      .foot-grid p {
        color: var(--ink-soft);
        margin: 0.7rem 0 0;
        max-width: 40ch;
      }
      .foot-contact {
        display: grid;
        gap: 0.6rem;
      }
      .foot-contact a,
      .foot-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--ink-soft);
        font-weight: 600;
      }
      .foot-contact a:hover {
        color: var(--clay);
      }
      .foot-contact svg {
        color: var(--clay);
        flex: none;
      }
      .foot-bottom {
        margin-block-start: clamp(2rem, 4vw, 2.8rem);
        padding-block-start: 1.4rem;
        border-block-start: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem 1.2rem;
        justify-content: space-between;
        align-items: center;
        color: var(--ink-faint);
        font-size: 0.88rem;
      }
      @media (min-width: 720px) {
        .foot-grid {
          grid-template-columns: 1.4fr 1fr;
        }
      }

      /* ============ REVEAL ANIMATIONS ============ */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        animation: rise 0.85s var(--ease) forwards;
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .d1 {
        animation-delay: 0.06s;
      }
      .d2 {
        animation-delay: 0.16s;
      }
      .d3 {
        animation-delay: 0.26s;
      }
      .d4 {
        animation-delay: 0.36s;
      }
      .d5 {
        animation-delay: 0.46s;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
        .blob {
          animation: none;
        }
      }
    </style>
  </head>

