<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בית בידיים טובות</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Secular+One&family=Assistant:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("dmeyers-mock-theme");
          document.documentElement.setAttribute(
            "data-theme",
            s === "light" || s === "dark" ? s : "light"
          );
        } catch (e) {}
      })();
    </script>
    <style>
      html[data-theme="light"] {
        --bg: oklch(0.96 0.02 75);
        --bg-2: oklch(0.93 0.028 70);
        --surface: oklch(0.99 0.012 85);
        --surface-2: oklch(0.97 0.018 72);
        --border: oklch(0.82 0.03 65 / 0.85);
        --ink: oklch(0.28 0.04 55);
        --ink-soft: oklch(0.42 0.04 55);
        --ink-mute: oklch(0.5 0.035 58);
        --deep: oklch(0.34 0.05 145);
        --deep-ink: oklch(0.97 0.02 90);
        --accent: oklch(0.62 0.15 52);
        --accent-2: oklch(0.55 0.16 40);
        --accent-ink: oklch(0.99 0.01 85);
        --glow: oklch(0.78 0.13 60 / 0.4);
        --shadow-s: 0 4px 14px -6px oklch(0.4 0.06 55 / 0.3);
        --shadow: 0 24px 50px -28px oklch(0.42 0.08 55 / 0.45);
        --shadow-l: 0 40px 80px -36px oklch(0.42 0.08 55 / 0.5);
      }
      html[data-theme="dark"] {
        --bg: oklch(0.21 0.018 60);
        --bg-2: oklch(0.25 0.022 58);
        --surface: oklch(0.28 0.024 58);
        --surface-2: oklch(0.31 0.026 56);
        --border: oklch(0.46 0.025 60 / 0.6);
        --ink: oklch(0.95 0.018 80);
        --ink-soft: oklch(0.82 0.02 72);
        --ink-mute: oklch(0.67 0.022 66);
        --deep: oklch(0.5 0.08 150);
        --deep-ink: oklch(0.98 0.02 90);
        --accent: oklch(0.78 0.14 60);
        --accent-2: oklch(0.78 0.15 50);
        --accent-ink: oklch(0.22 0.05 55);
        --glow: oklch(0.78 0.14 60 / 0.22);
        --shadow-s: 0 4px 14px -6px oklch(0.05 0.03 55 / 0.6);
        --shadow: 0 24px 50px -28px oklch(0.05 0.03 55 / 0.75);
        --shadow-l: 0 40px 80px -36px oklch(0.05 0.03 55 / 0.85);
      }
      :root {
        --maxw: 1280px;
        --pad: clamp(1.15rem, 4vw, 3.5rem);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --r-s: 14px;
        --r-m: 22px;
        --r-l: 34px;
        --r-xl: 48px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Assistant", sans-serif;
        font-size: 1.02rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        transition: background 0.45s var(--ease), color 0.45s var(--ease);
      }
      h1, h2, h3 { font-family: "Secular One", sans-serif; font-weight: 400; line-height: 1.08; margin: 0; letter-spacing: -0.01em; overflow-wrap: anywhere; }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      p { overflow-wrap: anywhere; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 8px; }
      .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--pad); }

      .kick {
        font-weight: 800; font-size: 0.8rem; letter-spacing: 0.16em;
        color: var(--accent-2); display: inline-flex; align-items: center; gap: 0.6rem;
        background: color-mix(in oklch, var(--accent) 14%, transparent);
        padding: 0.45rem 1rem; border-radius: 999px;
      }
      .kick::before { content: ""; inline-size: 7px; block-size: 7px; border-radius: 50%; background: var(--accent); flex: none; }

      .btn {
        font-family: "Assistant", sans-serif; font-weight: 800; font-size: 1.02rem;
        display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
        padding: 0.95rem 1.8rem; min-block-size: 52px; border-radius: 999px; border: 2px solid transparent; cursor: pointer;
        transition: transform 0.35s var(--ease), background 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
      }
      .btn svg { transition: transform 0.35s var(--ease); }
      .btn:hover svg { transform: translateX(-5px); }
      .btn-primary { background: var(--accent); color: var(--accent-ink); box-shadow: var(--shadow-s); }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 16px 32px -12px var(--accent); }
      .btn-ghost { background: var(--surface); color: var(--ink); border-color: var(--border); }
      .btn-ghost:hover { transform: translateY(-3px); border-color: var(--accent); color: var(--accent-2); }
      .btn-deep { background: var(--deep); color: var(--deep-ink); }
      .btn-deep:hover { transform: translateY(-3px); box-shadow: var(--shadow); }

      /* header */
      .site-header { position: sticky; inset-block-start: 0; z-index: 60; background: color-mix(in oklch, var(--bg) 80%, transparent); backdrop-filter: blur(16px); border-block-end: 1px solid var(--border); }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; block-size: 76px; }
      .wordmark { font-family: "Secular One", sans-serif; font-size: 1.6rem; letter-spacing: -0.02em; color: var(--ink); }
      .wordmark span { color: var(--accent); }
      .nav { display: none; gap: 1.7rem; font-weight: 700; font-size: 0.98rem; }
      .nav a { color: var(--ink-soft); }
      .nav a:hover { color: var(--accent-2); }
      .header-actions { display: flex; align-items: center; gap: 0.7rem; }
      .theme-toggle { inline-size: 46px; block-size: 46px; display: grid; place-items: center; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--ink); cursor: pointer; transition: border-color 0.3s var(--ease), transform 0.3s var(--ease); }
      .theme-toggle:hover { border-color: var(--accent); transform: rotate(12deg); }
      .theme-toggle .icon-sun { display: none; }
      html[data-theme="light"] .theme-toggle .icon-sun { display: block; }
      html[data-theme="light"] .theme-toggle .icon-moon { display: none; }
      .header-cta { display: none; }
      @media (min-width: 980px) { .nav, .header-cta { display: inline-flex; } }

      /* HERO */
      .hero { position: relative; overflow: hidden; isolation: isolate; }
      .blob {
        position: absolute; z-index: -1; border-radius: 47% 53% 60% 40% / 48% 42% 58% 52%;
        background: radial-gradient(circle at 35% 35%, var(--glow), transparent 70%); pointer-events: none; filter: blur(8px);
      }
      .hero .blob-1 { inset-block-start: -16%; inset-inline-end: -12%; inline-size: 52vw; block-size: 52vw; max-inline-size: 640px; max-block-size: 640px; }
      .hero .blob-2 { inset-block-end: -20%; inset-inline-start: -10%; inline-size: 40vw; block-size: 40vw; max-inline-size: 460px; max-block-size: 460px; background: radial-gradient(circle at 50% 50%, color-mix(in oklch, var(--deep) 26%, transparent), transparent 70%); }
      .hero-grid { display: grid; grid-template-columns: 1fr; gap: clamp(2.4rem, 5vw, 4rem); align-items: center; padding-block: clamp(2.6rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem); }
      @media (min-width: 980px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; } }
      .hero h1 { font-size: clamp(2.6rem, 8vw, 5.4rem); margin-block: 1.1rem 1.2rem; letter-spacing: -0.02em; }
      .hero h1 .accent { color: var(--accent-2); }
      .hero p { font-size: clamp(1.05rem, 1.7vw, 1.28rem); color: var(--ink-soft); max-inline-size: 46ch; }
      .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-block-start: 2rem; }
      .hero-trust { display: flex; flex-wrap: wrap; gap: 1.2rem 1.8rem; margin-block-start: 2.2rem; align-items: center; }
      .hero-trust .tr { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.95rem; color: var(--ink-soft); }
      .hero-trust .tr svg { color: var(--accent); flex: none; }

      /* hero portrait — single contained image */
      .portrait-stage { position: relative; }
      .portrait-card {
        position: relative; inline-size: 100%; aspect-ratio: 4/5; overflow: hidden;
        border-radius: var(--r-xl); box-shadow: var(--shadow-l); border: 6px solid var(--surface);
      }
      .portrait-card img { inline-size: 100%; block-size: 100%; object-fit: cover; }
      .portrait-badge {
        position: absolute; inset-block-end: 1.1rem; inset-inline-start: 1.1rem; inset-inline-end: 1.1rem;
        display: flex; align-items: center; gap: 0.9rem;
        background: color-mix(in oklch, var(--surface) 92%, transparent); backdrop-filter: blur(8px);
        border-radius: var(--r-m); padding: 0.85rem 1.1rem; box-shadow: var(--shadow-s);
      }
      .portrait-badge .av { inline-size: 46px; block-size: 46px; border-radius: 50%; background: var(--deep); color: var(--deep-ink); display: grid; place-items: center; font-family: "Secular One", sans-serif; font-size: 1.05rem; flex: none; }
      .portrait-badge .nm { font-family: "Secular One", sans-serif; font-size: 1rem; color: var(--ink); line-height: 1.1; }
      .portrait-badge .rl { font-size: 0.82rem; color: var(--ink-mute); }
      .portrait-chip {
        position: absolute; inset-block-start: 1.1rem; inset-inline-end: 1.1rem;
        background: var(--accent); color: var(--accent-ink); font-family: "Secular One", sans-serif;
        font-size: 0.95rem; padding: 0.55rem 1rem; border-radius: 999px; box-shadow: var(--shadow-s);
      }

      /* trust strip */
      .strip { background: var(--deep); color: var(--deep-ink); }
      .strip-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.9rem 2.4rem; padding-block: 1.1rem; text-align: center; }
      .strip-inner span { font-family: "Secular One", sans-serif; font-size: 1.02rem; display: inline-flex; align-items: center; gap: 0.7rem; opacity: 0.95; }
      .strip-inner span::before { content: ""; inline-size: 7px; block-size: 7px; border-radius: 50%; background: var(--accent); flex: none; }

      /* sections */
      .section { padding-block: clamp(4rem, 9vw, 7rem); position: relative; }
      .section-head { max-inline-size: 640px; margin-block-end: clamp(2.4rem, 5vw, 3.4rem); }
      .section-head.center { margin-inline: auto; text-align: center; }
      .section-head.center .kick { margin-inline: auto; }
      .section-head h2 { font-size: clamp(2rem, 5vw, 3.3rem); margin-block: 1rem 0.7rem; }
      .section-head p { color: var(--ink-mute); font-size: 1.1rem; }

      /* services */
      .svc-grid { display: grid; gap: 1.3rem; grid-template-columns: 1fr; }
      @media (min-width: 740px) { .svc-grid { grid-template-columns: repeat(3, 1fr); } }
      .svc {
        position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-l);
        padding: clamp(1.6rem, 3vw, 2.1rem); box-shadow: var(--shadow-s); overflow: hidden;
        transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
      }
      .svc:hover { transform: translateY(-8px); box-shadow: var(--shadow); }
      .svc-thumb { inline-size: 100%; aspect-ratio: 16/10; overflow: hidden; border-radius: var(--r-m); margin-block-end: 1.3rem; }
      .svc-thumb img { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.7s var(--ease); }
      .svc:hover .svc-thumb img { transform: scale(1.07); }
      .svc-ic { position: absolute; inset-block-start: clamp(1.6rem, 3vw, 2.1rem); inset-inline-end: clamp(1.6rem, 3vw, 2.1rem); inline-size: 52px; block-size: 52px; border-radius: var(--r-s); background: color-mix(in oklch, var(--accent) 16%, var(--surface)); color: var(--accent-2); display: grid; place-items: center; box-shadow: var(--shadow-s); z-index: 2; }
      .svc h3 { font-size: 1.45rem; margin-block: 0 0.6rem; }
      .svc p { color: var(--ink-soft); font-size: 0.98rem; margin: 0; }

      /* before/after section */
      .ba { background: var(--bg-2); position: relative; overflow: hidden; }
      .ba .blob-3 { position: absolute; z-index: 0; inset-block-start: -10%; inset-inline-end: -8%; inline-size: 36vw; block-size: 36vw; max-inline-size: 420px; max-block-size: 420px; border-radius: 50%; background: radial-gradient(circle, var(--glow), transparent 70%); pointer-events: none; }
      .ba .wrap { position: relative; z-index: 1; }
      .ba-stage { max-inline-size: 1000px; margin-inline: auto; }
      .ba-compare {
        position: relative; inline-size: 100%; aspect-ratio: 16/10; overflow: hidden;
        border-radius: var(--r-l); border: 6px solid var(--surface); box-shadow: var(--shadow-l);
        --pos: 50%; user-select: none; touch-action: pan-y;
      }
      .ba-layer { position: absolute; inset: 0; }
      .ba-layer img { inline-size: 100%; block-size: 100%; object-fit: cover; }
      .ba-after { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
      .ba-badge { position: absolute; inset-block-start: 1rem; font-family: "Secular One", sans-serif; font-size: 0.85rem; letter-spacing: 0.06em; padding: 0.45rem 1.1rem; border-radius: 999px; background: oklch(0.2 0.02 55 / 0.78); color: #fff; z-index: 4; pointer-events: none; }
      .ba-badge.before { right: 1rem; }
      .ba-badge.after { left: 1rem; background: var(--accent); color: var(--accent-ink); }
      .ba-divider { position: absolute; inset-block: 0; left: var(--pos); inline-size: 3px; background: #fff; transform: translateX(-50%); z-index: 3; pointer-events: none; box-shadow: 0 0 18px oklch(0.1 0.02 55 / 0.7); }
      .ba-handle { position: absolute; inset-block-start: 50%; left: var(--pos); transform: translate(-50%, -50%); inline-size: 58px; block-size: 58px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; z-index: 3; pointer-events: none; box-shadow: var(--shadow); }
      .ba-range { position: absolute; inset-block-start: 50%; inset-inline: 0; transform: translateY(-50%); inline-size: 100%; block-size: 60px; margin: 0; z-index: 5; cursor: ew-resize; opacity: 0; -webkit-appearance: none; appearance: none; background: transparent; direction: ltr; }
      .ba-range::-webkit-slider-thumb { -webkit-appearance: none; inline-size: 60px; block-size: 60px; }
      .ba-range:focus-visible { opacity: 1; }
      .ba-note { text-align: center; margin-block-start: 1.3rem; color: var(--ink-mute); font-weight: 700; font-size: 0.95rem; }

      /* gallery */
      .gallery { margin-block-start: 2.4rem; }
      .embla__viewport { overflow: hidden; }
      .embla__container { display: flex; gap: 1.1rem; }
      .embla__slide { position: relative; flex: 0 0 84%; min-inline-size: 0; overflow: hidden; border-radius: var(--r-l); box-shadow: var(--shadow-s); }
      @media (min-width: 720px) { .embla__slide { flex-basis: 47%; } }
      @media (min-width: 1040px) { .embla__slide { flex-basis: 32%; } }
      .embla__slide img { inline-size: 100%; aspect-ratio: 16/11; object-fit: cover; transition: transform 0.7s var(--ease); }
      .embla__slide:hover img { transform: scale(1.06); }
      .embla__slide span { position: absolute; inset-block-end: 0.8rem; inset-inline-start: 0.8rem; font-family: "Secular One", sans-serif; font-size: 0.82rem; color: #fff; padding: 0.35rem 0.9rem; border-radius: 999px; background: oklch(0.2 0.02 55 / 0.62); backdrop-filter: blur(4px); }
      .embla__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-block-start: 1.5rem; }
      .embla__btn { inline-size: 50px; block-size: 50px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--border); background: var(--surface); color: var(--ink); cursor: pointer; transition: border-color 0.3s var(--ease), transform 0.3s var(--ease); }
      .embla__btn:hover { border-color: var(--accent); transform: scale(1.08); }
      .embla__dots { display: flex; gap: 0.5rem; }
      .embla__dot { inline-size: 9px; block-size: 9px; border-radius: 50%; border: 0; padding: 0; cursor: pointer; background: var(--border); transition: transform 0.3s var(--ease), background 0.3s var(--ease); }
      .embla__dot.is-selected { background: var(--accent); transform: scale(1.4); }

      /* testimonial */
      .testimonial { background: var(--deep); color: var(--deep-ink); position: relative; overflow: hidden; }
      .testimonial .blob-4 { position: absolute; inset-block-end: -30%; inset-inline-end: -10%; inline-size: 44vw; block-size: 44vw; max-inline-size: 520px; max-block-size: 520px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklch, var(--accent) 30%, transparent), transparent 70%); pointer-events: none; }
      .testimonial .wrap { position: relative; z-index: 1; }
      .testimonial-inner { max-inline-size: 880px; margin-inline: auto; text-align: center; }
      .quote-mark { font-family: "Secular One", sans-serif; font-size: clamp(4rem, 12vw, 7rem); line-height: 0.6; color: var(--accent); opacity: 0.9; }
      .testimonial blockquote { margin: 0; font-family: "Secular One", sans-serif; font-size: clamp(1.4rem, 3.4vw, 2.2rem); line-height: 1.35; letter-spacing: -0.01em; }
      .testimonial .who { margin-block-start: 1.6rem; display: inline-flex; flex-direction: column; gap: 0.2rem; }
      .testimonial .who .nm { font-family: "Secular One", sans-serif; font-size: 1.05rem; }
      .testimonial .who .rl { font-size: 0.9rem; color: color-mix(in oklch, var(--deep-ink) 80%, transparent); }
      .testimonial .stars { display: inline-flex; gap: 0.25rem; color: var(--accent); margin-block-end: 1.4rem; }

      /* stats */
      .stats-band { background: var(--surface-2); border-block: 1px solid var(--border); }
      .stats { display: grid; grid-template-columns: repeat(2, 1fr); }
      @media (min-width: 760px) { .stats { grid-template-columns: repeat(4, 1fr); } }
      .stat { padding: clamp(1.8rem, 4vw, 2.8rem) 1rem; text-align: center; }
      .stat + .stat { border-inline-start: 1px solid var(--border); }
      @media (max-width: 759px) { .stat:nth-child(odd) { border-inline-start: 0; } .stat:nth-child(n+3) { border-block-start: 1px solid var(--border); } }
      .stat .n { font-family: "Secular One", sans-serif; font-size: clamp(1.9rem, 5vw, 3rem); color: var(--accent-2); line-height: 1; }
      .stat .l { font-weight: 600; color: var(--ink-soft); margin-block-start: 0.5rem; font-size: 0.95rem; }

      /* about */
      .about { position: relative; overflow: hidden; }
      .about-grid { display: grid; gap: clamp(2.2rem, 5vw, 4rem); align-items: center; grid-template-columns: 1fr; }
      @media (min-width: 900px) { .about-grid { grid-template-columns: 0.85fr 1.15fr; } }
      .about-portrait { position: relative; overflow: hidden; border-radius: var(--r-xl); box-shadow: var(--shadow-l); aspect-ratio: 4/5; border: 6px solid var(--surface); }
      .about-portrait img { inline-size: 100%; block-size: 100%; object-fit: cover; }
      .about-pin { position: absolute; inset-block-end: 1.1rem; inset-inline-start: 1.1rem; background: var(--accent); color: var(--accent-ink); font-family: "Secular One", sans-serif; padding: 0.6rem 1.1rem; font-size: 0.98rem; border-radius: 999px; box-shadow: var(--shadow-s); }
      .about h2 { font-size: clamp(2rem, 4.6vw, 3rem); margin-block: 1rem 0.9rem; }
      .about p { color: var(--ink-soft); font-size: 1.08rem; max-inline-size: 52ch; }
      .about-points { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: 0.9rem; }
      .about-points li { display: flex; gap: 0.85rem; align-items: flex-start; font-weight: 600; color: var(--ink-soft); }
      .about-points .ck { flex: none; inline-size: 28px; block-size: 28px; border-radius: 50%; background: color-mix(in oklch, var(--accent) 18%, var(--surface)); color: var(--accent-2); display: grid; place-items: center; margin-block-start: 1px; }

      /* CTA */
      .cta { position: relative; overflow: hidden; }
      .cta-card { position: relative; overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-xl); box-shadow: var(--shadow); padding: clamp(2.4rem, 6vw, 4.5rem); text-align: center; isolation: isolate; }
      .cta-card .blob-5 { position: absolute; z-index: -1; inset-block-start: -40%; inset-inline-start: -10%; inline-size: 50vw; block-size: 50vw; max-inline-size: 560px; max-block-size: 560px; border-radius: 50%; background: radial-gradient(circle, var(--glow), transparent 70%); pointer-events: none; }
      .cta-card h2 { font-size: clamp(2rem, 5.5vw, 3.4rem); max-inline-size: 20ch; margin-inline: auto; margin-block: 1rem 1rem; }
      .cta-card > p { color: var(--ink-soft); max-inline-size: 50ch; margin-inline: auto; }
      .cta-contact { display: flex; flex-wrap: wrap; gap: 1.2rem; justify-content: center; margin-block: 1.8rem; font-weight: 600; }
      .cta-contact a, .cta-contact span { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink-soft); }
      .cta-contact svg { color: var(--accent); flex: none; }
      .cta-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }

      /* footer */
      .site-footer { background: var(--deep); color: var(--deep-ink); padding-block: clamp(2.4rem, 6vw, 3.6rem); }
