<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — ללא פשרות</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Suez+One&family=Heebo:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("dmeyers-mock-theme");
          document.documentElement.setAttribute(
            "data-theme",
            s === "light" || s === "dark" ? s : "light"
          );
        } catch (e) {}
      })();
    </script>
    <style>
      html[data-theme="light"] {
        --bg: oklch(0.97 0.005 95);
        --bg-2: oklch(0.93 0.006 95);
        --surface: oklch(1 0 0);
        --ink: oklch(0.16 0.01 270);
        --ink-soft: oklch(0.32 0.012 270);
        --ink-mute: oklch(0.46 0.012 270);
        --line: oklch(0.16 0.01 270);
        --accent: oklch(0.5 0.2 255);
        --on-accent: oklch(0.99 0.005 255);
        --shadow-color: oklch(0.16 0.01 270);
        --img-frame: oklch(0.16 0.01 270);
      }
      html[data-theme="dark"] {
        --bg: oklch(0.15 0.01 270);
        --bg-2: oklch(0.19 0.012 270);
        --surface: oklch(0.22 0.014 270);
        --ink: oklch(0.97 0.004 270);
        --ink-soft: oklch(0.84 0.01 270);
        --ink-mute: oklch(0.66 0.012 270);
        --line: oklch(0.97 0.004 270);
        --accent: oklch(0.66 0.19 255);
        --on-accent: oklch(0.12 0.02 270);
        --shadow-color: oklch(0.66 0.19 255);
        --img-frame: oklch(0.97 0.004 270);
      }
      :root {
        --maxw: 1340px;
        --pad: clamp(1.1rem, 4vw, 3.5rem);
        --ease: cubic-bezier(0.2, 0.9, 0.25, 1);
        --offset: 8px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Heebo", sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        transition: background 0.35s var(--ease), color 0.35s var(--ease);
      }
      h1, h2, h3 {
        font-family: "Suez One", serif; font-weight: 400; line-height: 0.94;
        margin: 0; letter-spacing: -0.02em; overflow-wrap: anywhere;
      }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
      .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: var(--pad); }

      /* kicker / labels */
      .kick {
        font-weight: 900; font-size: 0.72rem; letter-spacing: 0.26em;
        text-transform: uppercase; color: var(--accent);
        display: inline-flex; align-items: center; gap: 0.7rem;
      }
      .kick::before { content: ""; inline-size: 26px; block-size: 3px; background: currentColor; }

      /* buttons — hard offset shadow brutalist */
      .btn {
        font-weight: 900; font-size: 1rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
        padding: 1rem 1.6rem; min-block-size: 54px; border: 3px solid var(--line); cursor: pointer;
        background: var(--surface); color: var(--ink);
        box-shadow: var(--offset) var(--offset) 0 0 var(--shadow-color);
        transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
      }
      .btn svg { transition: transform 0.2s var(--ease); }
      .btn:hover { transform: translate(4px, 4px); box-shadow: 4px 4px 0 0 var(--shadow-color); }
      .btn:active { transform: translate(var(--offset), var(--offset)); box-shadow: 0 0 0 0 var(--shadow-color); }
      .btn:hover svg { transform: translateX(-5px); }
      .btn-primary { background: var(--accent); color: var(--on-accent); border-color: var(--line); }
      .btn-ghost { background: var(--surface); color: var(--ink); }

      /* header */
      .site-header { position: sticky; inset-block-start: 0; z-index: 60; background: var(--bg); border-block-end: 3px solid var(--line); }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; block-size: 76px; }
      .wordmark { font-family: "Suez One", serif; font-size: 1.6rem; letter-spacing: -0.04em; }
      .wordmark span { color: var(--accent); }
      .nav { display: none; gap: 1.6rem; font-weight: 800; font-size: 0.9rem; }
      .nav a { color: var(--ink-soft); padding-block: 0.2rem; border-block-end: 3px solid transparent; }
      .nav a:hover { color: var(--ink); border-block-end-color: var(--accent); }
      .header-actions { display: flex; align-items: center; gap: 0.7rem; }
      .theme-toggle { inline-size: 46px; block-size: 46px; display: grid; place-items: center; border: 3px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; transition: background 0.2s var(--ease), color 0.2s var(--ease); }
      .theme-toggle:hover { background: var(--accent); color: var(--on-accent); border-color: var(--line); }
      .theme-toggle .icon-sun { display: none; }
      html[data-theme="light"] .theme-toggle .icon-sun { display: block; }
      html[data-theme="light"] .theme-toggle .icon-moon { display: none; }
      .header-cta { display: none; }
      @media (min-width: 1000px) { .nav, .header-cta { display: inline-flex; } }

      /* HERO — giant type on solid + one contained image block */
      .hero { border-block-end: 3px solid var(--line); position: relative; overflow: hidden; }
      .hero-grid { display: grid; grid-template-columns: 1fr; gap: clamp(1.8rem, 4vw, 3rem); align-items: end; padding-block: clamp(2.4rem, 6vw, 4.6rem) clamp(2rem, 4vw, 3.4rem); }
      @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.25fr 0.75fr; } }
      .hero-chip { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 900; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); background: var(--bg-2); border: 3px solid var(--line); padding: 0.4rem 0.85rem; margin-block-end: 1.5rem; }
      .hero-chip b { color: var(--accent); }
      .hero h1 { font-size: clamp(3rem, 13vw, 8.5rem); letter-spacing: -0.04em; }
      .hero h1 .out {
        color: var(--bg); -webkit-text-stroke: clamp(2px, 0.5vw, 4px) var(--ink); text-stroke: clamp(2px, 0.5vw, 4px) var(--ink);
        display: inline-block;
      }
      .hero h1 .acc { color: var(--accent); }
      .hero-sub { font-size: clamp(1.02rem, 1.7vw, 1.22rem); color: var(--ink-soft); max-inline-size: 48ch; margin-block-start: 1.4rem; font-weight: 500; }
      .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-block-start: 2rem; }

      /* hero before/after card — framed */
      .reveal-card {
        position: relative; inline-size: 100%; aspect-ratio: 4/5; overflow: hidden;
        border: 3px solid var(--img-frame); box-shadow: var(--offset) var(--offset) 0 0 var(--shadow-color);
        --pos: 50%; user-select: none; touch-action: pan-y; background: var(--bg-2);
      }
      @media (min-width: 1000px) { .reveal-card { aspect-ratio: 3/4; } }
      .ba-layer { position: absolute; inset: 0; }
      .ba-layer img { inline-size: 100%; block-size: 100%; object-fit: cover; }
      .ba-after { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
      .ba-badge { position: absolute; inset-block-start: 0.9rem; font-weight: 900; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.42rem 0.9rem; border: 2px solid #fff; background: oklch(0.12 0.01 270 / 0.86); color: #fff; z-index: 4; pointer-events: none; }
      .ba-badge.before { right: 0.9rem; }
      .ba-badge.after { left: 0.9rem; background: var(--accent); color: var(--on-accent); border-color: var(--on-accent); }
      .ba-divider { position: absolute; inset-block: 0; left: var(--pos); inline-size: 4px; background: #fff; transform: translateX(-50%); z-index: 3; pointer-events: none; }
      .ba-handle { position: absolute; inset-block-start: 50%; left: var(--pos); transform: translate(-50%, -50%); inline-size: 56px; block-size: 56px; background: var(--accent); color: var(--on-accent); border: 3px solid #fff; display: grid; place-items: center; z-index: 3; pointer-events: none; }
      .ba-range { position: absolute; inset-block-start: 50%; inset-inline: 0; transform: translateY(-50%); inline-size: 100%; block-size: 60px; margin: 0; z-index: 5; cursor: ew-resize; opacity: 0; -webkit-appearance: none; appearance: none; background: transparent; direction: ltr; }
      .ba-range::-webkit-slider-thumb { -webkit-appearance: none; inline-size: 60px; block-size: 60px; }
      .ba-range:focus-visible { opacity: 1; }
      .reveal-note { position: absolute; inset-block-end: 0.9rem; inset-inline: 0.9rem; text-align: center; font-weight: 800; font-size: 0.78rem; letter-spacing: 0.05em; color: #fff; background: oklch(0.12 0.01 270 / 0.62); padding: 0.5rem; z-index: 4; pointer-events: none; }

      /* MARQUEE / ticker */
      .marquee { background: var(--accent); color: var(--on-accent); border-block-end: 3px solid var(--line); overflow: hidden; }
      .marquee-track { display: flex; gap: 0; padding-block: 0.75rem; white-space: nowrap; width: max-content; animation: scroll-x 30s linear infinite; }
      .marquee-track span { font-family: "Suez One", serif; font-size: 1.05rem; letter-spacing: 0.02em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 1.6rem; padding-inline: 1.6rem; }
      .marquee-track span::after { content: "／"; opacity: 0.6; }
      @keyframes scroll-x { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

      /* sections */
      .section { padding-block: clamp(4rem, 9vw, 7.5rem); position: relative; }
      .section-head { max-inline-size: 720px; margin-block-end: clamp(2.2rem, 5vw, 3.4rem); }
      .section-head.center { margin-inline: auto; text-align: center; }
      .section-head.center .kick { justify-content: center; }
      .section-head h2 { font-size: clamp(2.2rem, 6.5vw, 4.4rem); margin-block: 1rem 0.8rem; }
      .section-head p { color: var(--ink-mute); font-size: 1.06rem; font-weight: 500; }
      .num-marker { font-family: "Suez One", serif; font-size: clamp(1rem, 2vw, 1.2rem); color: var(--accent); letter-spacing: 0.05em; }

      /* services — blocky cells with exposed grid */
      .svc-grid { display: grid; gap: 0; grid-template-columns: 1fr; border: 3px solid var(--line); background: var(--surface); box-shadow: var(--offset) var(--offset) 0 0 var(--shadow-color); }
      @media (min-width: 820px) { .svc-grid { grid-template-columns: repeat(3, 1fr); } }
      .svc { background: var(--surface); padding: clamp(1.6rem, 3vw, 2.2rem); display: flex; flex-direction: column; gap: 0.9rem; min-block-size: 320px; position: relative; transition: background 0.25s var(--ease); }
      .svc + .svc { border-block-start: 3px solid var(--line); }
      @media (min-width: 820px) { .svc + .svc { border-block-start: 0; border-inline-start: 3px solid var(--line); } }
      .svc:hover { background: var(--bg-2); }
      .svc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
      .svc-num { font-family: "Suez One", serif; font-size: clamp(3rem, 7vw, 4.6rem); line-height: 0.8; color: var(--accent); }
      .svc-icon { inline-size: 50px; block-size: 50px; display: grid; place-items: center; border: 3px solid var(--line); color: var(--ink); flex: none; }
      .svc h3 { font-size: clamp(1.35rem, 2.6vw, 1.7rem); margin-block-start: auto; }
      .svc p { color: var(--ink-soft); font-size: 0.97rem; margin: 0; font-weight: 500; }
      .svc-thumb { aspect-ratio: 16/9; overflow: hidden; border: 3px solid var(--line); margin-block-start: 0.3rem; }
      .svc-thumb img { inline-size: 100%; block-size: 100%; object-fit: cover; filter: grayscale(0.55) contrast(1.05); transition: transform 0.6s var(--ease), filter 0.4s var(--ease); }
      .svc:hover .svc-thumb img { transform: scale(1.07); filter: grayscale(0) contrast(1); }

      /* projects: big before/after + gallery */
      .proj { background: var(--bg-2); border-block: 3px solid var(--line); }
      .ba-stage { max-inline-size: 1020px; margin-inline: auto; }
      .ba-compare {
        position: relative; inline-size: 100%; aspect-ratio: 16/10; overflow: hidden;
        border: 3px solid var(--img-frame); box-shadow: var(--offset) var(--offset) 0 0 var(--shadow-color);
        --pos: 50%; user-select: none; touch-action: pan-y; background: var(--surface);
      }

      .gallery { margin-block-start: clamp(2rem, 4vw, 3rem); }
      .gallery-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-block-end: 1.2rem; flex-wrap: wrap; }
      .gallery-head h3 { font-size: clamp(1.4rem, 3vw, 2rem); }
      .embla__viewport { overflow: hidden; }
      .embla__container { display: flex; gap: 1rem; }
      .embla__slide { position: relative; flex: 0 0 84%; min-inline-size: 0; overflow: hidden; border: 3px solid var(--img-frame); background: var(--surface); }
      @media (min-width: 720px) { .embla__slide { flex-basis: 47%; } }
      @media (min-width: 1040px) { .embla__slide { flex-basis: 32%; } }
      .embla__slide img { inline-size: 100%; aspect-ratio: 16/11; object-fit: cover; transition: transform 0.6s var(--ease); }
      .embla__slide:hover img { transform: scale(1.06); }
      .embla__slide span { position: absolute; inset-block-end: 0; inset-inline-start: 0; font-weight: 900; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-accent); padding: 0.4rem 0.8rem; background: var(--accent); }
      .embla__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-block-start: 1.4rem; }
      .embla__btn { inline-size: 50px; block-size: 50px; display: grid; place-items: center; border: 3px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; transition: background 0.2s var(--ease), color 0.2s var(--ease); }
      .embla__btn:hover { background: var(--accent); color: var(--on-accent); }
      .embla__dots { display: flex; gap: 0.5rem; }
      .embla__dot { inline-size: 14px; block-size: 14px; border: 2px solid var(--line); padding: 0; cursor: pointer; background: transparent; }
      .embla__dot.is-selected { background: var(--accent); border-color: var(--accent); }

      /* stats band — oversized numerals exposed grid */
      .stats { display: grid; grid-template-columns: repeat(2, 1fr); border-block-end: 3px solid var(--line); background: var(--line); gap: 3px; }
      @media (min-width: 820px) { .stats { grid-template-columns: repeat(4, 1fr); } }
      .stat { padding: clamp(1.8rem, 4vw, 2.8rem) 1rem; text-align: center; background: var(--bg); }
      .stat .n { font-family: "Suez One", serif; font-size: clamp(2.1rem, 5vw, 3.4rem); color: var(--accent); line-height: 0.95; }
      .stat .l { font-weight: 800; color: var(--ink-soft); margin-block-start: 0.5rem; font-size: 0.9rem; letter-spacing: 0.04em; }

      /* about */
      .about-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; grid-template-columns: 1fr; }
      @media (min-width: 900px) { .about-grid { grid-template-columns: 0.8fr 1.2fr; } }
      .about-portrait { position: relative; overflow: hidden; border: 3px solid var(--img-frame); box-shadow: var(--offset) var(--offset) 0 0 var(--shadow-color); aspect-ratio: 4/5; background: var(--bg-2); }
      .about-portrait img { inline-size: 100%; block-size: 100%; object-fit: cover; filter: grayscale(0.25) contrast(1.04); }
      .about-portrait .pin { position: absolute; inset-block-end: 0; inset-inline-start: 0; background: var(--accent); color: var(--on-accent); font-family: "Suez One", serif; padding: 0.6rem 1.1rem; font-size: 1rem; }
      .about h2 { font-size: clamp(2rem, 5vw, 3.4rem); margin-block: 1rem; }
      .about p { color: var(--ink-soft); font-size: 1.08rem; max-inline-size: 54ch; font-weight: 500; }
      .about-points { list-style: none; margin: 1.7rem 0 0; padding: 0; display: grid; gap: 0; border: 3px solid var(--line); }
      .about-points li { display: flex; gap: 0.8rem; align-items: flex-start; font-weight: 700; padding: 0.95rem 1.1rem; }
      .about-points li + li { border-block-start: 3px solid var(--line); }
      .about-points svg { flex: none; color: var(--accent); margin-block-start: 2px; }
      .court-chip { display: inline-flex; align-items: center; gap: 0.45rem; margin-block-start: 1.4rem; font-weight: 800; font-size: 0.82rem; color: var(--ink-soft); background: var(--bg-2); border: 3px solid var(--line); padding: 0.45rem 0.9rem; }
      .court-chip svg { color: var(--accent); flex: none; }

      /* CTA */
      .cta { background: var(--accent); color: var(--on-accent); border-block: 3px solid var(--line); }
      .cta-inner { text-align: center; padding-block: clamp(3.6rem, 9vw, 6.5rem); }
      .cta .kick { color: var(--on-accent); }
      .cta-inner h2 { color: var(--on-accent); font-size: clamp(2.3rem, 7vw, 4.8rem); max-inline-size: 20ch; margin-inline: auto; margin-block: 1rem 1.4rem; }
      .cta-contact { display: flex; flex-wrap: wrap; gap: 1rem 1.6rem; justify-content: center; margin-block: 1.4rem 2rem; font-weight: 700; }
      .cta-contact a, .cta-contact span { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--on-accent); }
      .cta-contact svg { flex: none; }
      .cta .btn { background: var(--surface); color: var(--ink); border-color: var(--on-accent); box-shadow: var(--offset) var(--offset) 0 0 oklch(0.12 0.02 270 / 0.4); }
      .cta .btn:hover { transform: translate(4px, 4px); box-shadow: 4px 4px 0 0 oklch(0.12 0.02 270 / 0.4); }

      /* footer */
      .site-footer { background: var(--bg); padding-block: clamp(2.4rem, 6vw, 4rem); }
      .footer-big { font-family: "Suez One", serif; font-size: clamp(3rem, 16vw, 11rem); line-height: 0.82; letter-spacing: -0.04em; margin-block-end: 1.4rem; }
      .footer-big span { color: var(--accent); }
      .footer-row { display: flex; flex-direction: column; gap: 0.8rem; padding-block-start: 1.4rem; border-block-start: 3px solid var(--line); }
      @media (min-width: 720px) { .footer-row { flex-direction: row; justify-content: space-between; align-items: center; } }
      .footer-row .tag { color: var(--ink-mute); font-size: 0.95rem; font-weight: 600; }
      .footer-row .copy { color: var(--ink-mute); font-size: 0.85rem; }

      /* reveal */
      .reveal { opacity: 0; transform: translateY(24px); animation: rise 0.8s var(--ease) forwards; }
      @keyframes rise { to { opacity: 1; transform: none; } }
      .d1 { animation-delay: 0.05s; } .d2 { animation-delay: 0.16s; } .d3 { animation-delay: 0.27s; } .d4 { animation-delay: 0.38s; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
        .reveal { opacity: 1; transform: none; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="#top">D<span>.</span>Meyer's</a>
        <nav class="nav" aria-label="ניווט ראשי">
          <a href="#top">בית</a><a href="#services">שירותים</a><a href="#projects">פרויקטים</a><a href="#about">אודות</a><a href="#contact">צור קשר</a>
        </nav>
        <div class="header-actions">
          <a class="btn btn-primary header-cta" href="/contact">תיאום ייעוץ</a>
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="החלפת מצב תצוגה">
            <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-text">
            <span class="hero-chip reveal d1">בדק בית · איטום · ציפויים <b>23+ שנים</b></span>
            <h1 class="reveal d2">בלי<br /><span class="acc">פשרות.</span><br /><span class="out">בלי הפתעות.</span></h1>
            <p class="hero-sub reveal d3">23+ שנות ניסיון באיתור ליקויי בנייה, רטיבות ואיטום. בדיקה יסודית, חוות דעת מקצועית מפורטת — וליווי אישי עד לפתרון.</p>
            <div class="hero-cta reveal d4">
              <a class="btn btn-primary" href="/contact">תיאום פגישת ייעוץ
