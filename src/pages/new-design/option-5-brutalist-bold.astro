    <script is:inline>
      (function () {
        var btn = document.getElementById("themeToggle");
        if (btn) btn.addEventListener("click", function () {
          var n = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", n);
          try { localStorage.setItem("dmeyers-mock-theme", n); } catch (e) {}
        });
        function wireBA(rangeId, compId) {
          var r = document.getElementById(rangeId), c = document.getElementById(compId);
          if (r && c) r.addEventListener("input", function () { c.style.setProperty("--pos", r.value + "%"); });
        }
        wireBA("baRange", "baCompare");
        wireBA("baRange2", "baCompare2");
      })();
    </script>
    <script>
      import EmblaCarousel from "embla-carousel";
      const galRoot = document.querySelector<HTMLElement>("[data-embla-gallery]");
      const galVp = galRoot?.querySelector<HTMLElement>(".embla__viewport");
      if (galRoot && galVp) {
        const embla = EmblaCarousel(galVp, { loop: true, direction: "rtl", align: "start" });
        const prev = galRoot.querySelector(".embla__prev");
        const next = galRoot.querySelector(".embla__next");
        if (prev) prev.addEventListener("click", () => embla.scrollPrev());
        if (next) next.addEventListener("click", () => embla.scrollNext());
        const dotsNode = galRoot.querySelector("[data-embla-dots]");
        if (dotsNode) {
          dotsNode.innerHTML = embla.scrollSnapList().map((_: number, i: number) => '<button class="embla__dot" type="button" aria-label="שקופית ' + (i + 1) + '"></button>').join("");
          const dots = Array.from(dotsNode.children) as HTMLElement[];
          dots.forEach((d, i) => d.addEventListener("click", () => embla.scrollTo(i)));
          const sel = () => { const i = embla.selectedScrollSnap(); dots.forEach((d, n) => d.classList.toggle("is-selected", n === i)); };
          embla.on("select", sel); sel();
        }
      }
    </script>
