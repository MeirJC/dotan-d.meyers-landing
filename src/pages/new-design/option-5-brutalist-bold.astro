<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית · ייעוץ איטום · אפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Suez+One&family=Heebo:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "dark" || saved === "light" ? saved : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      /* ============================================================
         OPTION 5 — "BOLD CONFIDENT"
         High-contrast, oversized heavy Hebrew display on a clean
         canvas. Disciplined strong grid; a few sharp accents (thick
         rule, offset block) used sparingly with one refined accent:
         deep electric COBALT. No green anywhere.
         ============================================================ */

      /* ---------- TOKENS ---------- */
      html[data-theme="light"] {
        --bg: oklch(0.985 0.003 250);
        --bg-2: oklch(0.955 0.005 250);
        --surface: oklch(1 0 0);
        --surface-2: oklch(0.97 0.005 250);
        --ink: oklch(0.18 0.02 264);
        --ink-soft: oklch(0.36 0.02 264);
        --ink-mute: oklch(0.5 0.018 264);
        --line: oklch(0.18 0.02 264);
        --hair: oklch(0.86 0.012 264);
        --accent: oklch(0.5 0.2 255);
        --accent-strong: oklch(0.44 0.21 255);
        --accent-soft: oklch(0.5 0.2 255 / 0.1);
        --accent-on: oklch(0.99 0.005 250);
        --on-photo: oklch(0.99 0.01 90);
        --on-photo-soft: oklch(0.93 0.008 250);
        --scrim-top: oklch(0.08 0.02 264 / 0.92);
        --scrim-mid: oklch(0.1 0.02 264 / 0.5);
        --invert: oklch(0.16 0.02 264);
        --invert-ink: oklch(0.98 0.004 250);
        --shadow: 0 24px 56px -26px oklch(0.3 0.04 264 / 0.4);
        --shadow-sm: 0 10px 28px -18px oklch(0.3 0.04 264 / 0.35);
      }

      html[data-theme="dark"] {
        --bg: oklch(0.16 0.018 264);
        --bg-2: oklch(0.2 0.02 264);
        --surface: oklch(0.23 0.02 264);
        --surface-2: oklch(0.27 0.022 264);
        --ink: oklch(0.97 0.005 250);
        --ink-soft: oklch(0.82 0.012 250);
        --ink-mute: oklch(0.66 0.014 250);
        --line: oklch(0.97 0.005 250);
        --hair: oklch(0.34 0.02 264);
        --accent: oklch(0.66 0.19 255);
        --accent-strong: oklch(0.72 0.18 255);
        --accent-soft: oklch(0.66 0.19 255 / 0.16);
        --accent-on: oklch(0.12 0.03 264);
        --on-photo: oklch(0.99 0.01 90);
        --on-photo-soft: oklch(0.93 0.008 250);
        --scrim-top: oklch(0.05 0.02 264 / 0.95);
        --scrim-mid: oklch(0.06 0.02 264 / 0.55);
        --invert: oklch(0.98 0.004 250);
        --invert-ink: oklch(0.16 0.02 264);
        --shadow: 0 24px 60px -24px oklch(0.02 0.02 264 / 0.85);
        --shadow-sm: 0 10px 30px -16px oklch(0.02 0.02 264 / 0.7);
      }

      :root {
        --font-display: "Suez One", "Heebo", system-ui, sans-serif;
        --font-body: "Heebo", system-ui, sans-serif;
        --maxw: 1240px;
        --pad: clamp(1.15rem, 4vw, 3rem);
        --r: 6px;
        --r-lg: 10px;
        --rule: 4px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        font-weight: 500;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        transition: background 0.4s var(--ease), color 0.4s var(--ease);
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 400;
        line-height: 0.98;
        margin: 0;
        letter-spacing: -0.02em;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--pad);
      }

      /* ---------- EYEBROW ---------- */
      .eyebrow {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        color: var(--accent);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-transform: none;
      }
      .eyebrow::before {
        content: "";
        inline-size: 30px;
        block-size: var(--rule);
        background: currentColor;
        display: inline-block;
        flex: none;
      }

      /* ---------- BUTTONS ---------- */
      .btn {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: -0.01em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.95rem 1.7rem;
        min-block-size: 50px;
        border-radius: var(--r);
        border: 2px solid transparent;
        cursor: pointer;
        transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
          background 0.25s var(--ease), border-color 0.25s var(--ease),
          color 0.25s var(--ease);
      }
      .btn svg {
        transition: transform 0.25s var(--ease);
      }
      /* RTL arrow points left on hover */
      .btn:hover svg {
        transform: translateX(-5px);
      }
      .btn-primary {
        background: var(--accent);
        color: var(--accent-on);
        box-shadow: 0 10px 28px -14px var(--accent);
      }
      .btn-primary:hover {
        transform: translateY(-3px);
        background: var(--accent-strong);
        box-shadow: 0 16px 36px -14px var(--accent);
      }
      .btn-outline {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }
      .btn-outline:hover {
        transform: translateY(-3px);
        background: var(--ink);
        color: var(--bg);
      }
      .btn-ghost {
        background: oklch(0.5 0.02 264 / 0.18);
        color: var(--on-photo);
        border-color: oklch(0.95 0.01 250 / 0.4);
        backdrop-filter: blur(10px);
      }
      .btn-ghost:hover {
        transform: translateY(-3px);
        border-color: var(--on-photo);
        background: oklch(0.5 0.02 264 / 0.3);
      }

      /* ---------- HEADER ---------- */
      .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: oklch(0.985 0.003 250 / 0.82);
        backdrop-filter: blur(16px);
        border-block-end: var(--border-w, 2px) solid var(--line);
        transition: background 0.4s var(--ease);
      }
      html[data-theme="dark"] .site-header {
        background: oklch(0.16 0.018 264 / 0.78);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        block-size: 74px;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: 1.5rem;
        letter-spacing: -0.03em;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      /* small brand mark — stays in header only */
      .brand-mark {
        inline-size: 30px;
        block-size: 30px;
        display: grid;
        place-items: center;
        background: var(--accent);
        color: var(--accent-on);
        border-radius: var(--r);
        font-size: 1rem;
        flex: none;
      }
      .wordmark .dot {
        color: var(--accent);
      }
      .nav {
        display: none;
        gap: 1.7rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.96rem;
      }
      .nav a {
        position: relative;
        color: var(--ink-soft);
        padding-block: 0.3rem;
        transition: color 0.25s var(--ease);
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 0;
        inline-size: 0;
        block-size: 3px;
        background: var(--accent);
        transition: inline-size 0.3s var(--ease);
      }
      .nav a:hover {
        color: var(--ink);
      }
      .nav a:hover::after {
        inline-size: 100%;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }
      .theme-toggle {
        inline-size: 46px;
        block-size: 46px;
        display: grid;
        place-items: center;
        border-radius: var(--r);
        border: 2px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          background 0.3s var(--ease);
      }
      .theme-toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      .theme-toggle .icon-sun {
        display: none;
      }
      html[data-theme="light"] .theme-toggle .icon-sun {
        display: block;
      }
      html[data-theme="light"] .theme-toggle .icon-moon {
        display: none;
      }
      .header-cta {
        display: none;
      }
      @media (min-width: 900px) {
        .nav {
          display: flex;
        }
        .header-cta {
          display: inline-flex;
        }
      }

      /* ---------- HERO ---------- */
      .hero {
        position: relative;
        overflow: hidden;
        border-block-end: var(--rule) solid var(--line);
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0;
      }
      @media (min-width: 980px) {
        .hero-grid {
          grid-template-columns: 1.05fr 0.95fr;
          align-items: stretch;
        }
      }
      .hero-text {
        padding-block: clamp(3rem, 8vw, 6rem);
        padding-inline-end: clamp(0rem, 3vw, 2.5rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .hero h1 {
        /* oversized heavy display — legible, tight, no mobile overflow */
        font-size: clamp(2.6rem, 9vw, 5.4rem);
        line-height: 0.96;
        color: var(--ink);
        text-wrap: balance;
        margin-block: 1.1rem 1.3rem;
        max-inline-size: 14ch;
        overflow-wrap: break-word;
      }
      .hero h1 .hl {
        color: var(--accent);
      }
      .hero p {
        font-size: clamp(1rem, 1.5vw, 1.18rem);
        font-weight: 500;
        color: var(--ink-soft);
        max-inline-size: 50ch;
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-block-start: 2rem;
      }
      /* one small trust chip — court mentioned once only */
      .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-block-start: 1.6rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--ink-soft);
        padding: 0.45rem 0.95rem;
        border-radius: var(--r);
        border: 2px solid var(--hair);
        background: var(--surface);
        width: fit-content;
      }
      .hero-chip svg {
        color: var(--accent);
        flex: none;
      }
      /* hero media — Embla carousel of jobsite photos */
      .hero-media {
        position: relative;
        min-block-size: clamp(300px, 56vw, 620px);
        border-inline-start: var(--rule) solid var(--line);
        isolation: isolate;
      }
      @media (max-width: 979px) {
        .hero-media {
          border-inline-start: 0;
          border-block-start: var(--rule) solid var(--line);
        }
      }
      .hero-media .embla,
      .hero-media .embla__container,
      .hero-media .embla__slide {
        block-size: 100%;
      }
      .hero-media .embla {
        overflow: hidden;
        block-size: 100%;
      }
      .hero-media .embla__container {
        display: flex;
      }
      .hero-media .embla__slide {
        position: relative;
        flex: 0 0 100%;
        min-inline-size: 0;
      }
      .hero-media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      .hero-media::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(
          to inline-start,
          transparent 70%,
          var(--scrim-mid) 100%
        );
      }

      /* ---------- STAT STRIP ---------- */
      .stats {
        background: var(--invert);
        color: var(--invert-ink);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
      }
      @media (min-width: 760px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .stat {
        padding: clamp(1.6rem, 3.5vw, 2.4rem) 1.2rem;
        text-align: center;
        border-inline-end: 2px solid oklch(0.5 0.02 264 / 0.4);
        border-block-end: 2px solid oklch(0.5 0.02 264 / 0.4);
        transition: background 0.3s var(--ease);
      }
      @media (max-width: 759px) {
        .stat:nth-child(2n) {
          border-inline-end: 0;
        }
      }
      @media (min-width: 760px) {
        .stat {
          border-block-end: 0;
        }
        .stat:last-child {
          border-inline-end: 0;
        }
      }
      .stat:hover {
        background: oklch(0.5 0.02 264 / 0.2);
      }
      .stat .num {
        font-family: var(--font-display);
        font-size: clamp(1.7rem, 4vw, 2.4rem);
        color: var(--accent-strong);
        line-height: 1;
      }
      html[data-theme="dark"] .stat .num {
        color: var(--accent-strong);
      }
      .stat .lbl {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--invert-ink);
        margin-block-start: 0.55rem;
        opacity: 0.9;
      }

      /* ---------- SECTION SHELL ---------- */
      .section {
        padding-block: clamp(4.5rem, 10vw, 8rem);
      }
      .section-head {
        max-inline-size: 720px;
        margin-block-end: clamp(2.4rem, 5vw, 3.4rem);
      }
      .section-head h2 {
        font-size: clamp(2.1rem, 5.5vw, 3.6rem);
        margin-block: 1rem 0.9rem;
        text-wrap: balance;
      }
      .section-head p {
        color: var(--ink-mute);
        font-size: 1.06rem;
        font-weight: 500;
        max-inline-size: 54ch;
      }

      /* ---------- SERVICES ---------- */
      .svc-grid {
        display: grid;
        gap: 1.4rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 720px) {
        .svc-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 1040px) {
        .svc-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .svc {
        position: relative;
        background: var(--surface);
        border: 2px solid var(--line);
        border-radius: var(--r-lg);
        padding: clamp(1.6rem, 3vw, 2.1rem);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
        overflow: hidden;
      }
      /* offset block accent — sharp, used sparingly */
      .svc::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        inline-size: 100%;
        block-size: var(--rule);
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: inline-start;
        transition: transform 0.4s var(--ease);
      }
      .svc:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow);
      }
      .svc:hover::before {
        transform: scaleX(1);
      }
      .svc-num {
        font-family: var(--font-display);
        font-size: 2.4rem;
        color: var(--hair);
        line-height: 1;
      }
      .svc h3 {
        font-size: 1.55rem;
        color: var(--ink);
        margin-block: 0.9rem 0.7rem;
      }
      .svc > p {
        color: var(--ink-mute);
        font-size: 0.98rem;
        font-weight: 500;
        margin: 0 0 1.2rem;
      }
      .svc-list {
        list-style: none;
        margin: auto 0 0;
        padding: 1.2rem 0 0;
        border-block-start: 2px solid var(--hair);
        display: grid;
        gap: 0.6rem;
      }
      .svc-list li {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .svc-list svg {
        flex: none;
        color: var(--accent);
      }

      /* ---------- BEFORE / AFTER — CENTERPIECE ---------- */
      .ba {
        background: var(--bg-2);
        border-block: var(--rule) solid var(--line);
      }
      .ba .section-head {
        text-align: center;
        margin-inline: auto;
      }
      .ba .section-head .eyebrow {
        justify-content: center;
      }
      .ba .section-head p {
        margin-inline: auto;
      }
      .ba-stage {
        max-inline-size: 1000px;
        margin-inline: auto;
      }
      .ba-compare {
        position: relative;
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 2px solid var(--line);
        --pos: 50%;
        user-select: none;
        touch-action: pan-y;
      }
      .ba-layer {
        position: absolute;
        inset: 0;
      }
      .ba-layer img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      /* "after" sits on top, clipped. Physical positioning (RTL-safe):
         before stays on the RIGHT, after revealed from the LEFT as --pos grows. */
      .ba-after {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }
      .ba-badge {
        position: absolute;
        inset-block-start: 1rem;
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        padding: 0.4rem 1rem;
        border-radius: var(--r);
        background: oklch(0.08 0.02 264 / 0.78);
        color: var(--on-photo);
        backdrop-filter: blur(6px);
        z-index: 4;
        pointer-events: none;
      }
      .ba-badge.before {
        right: 1rem;
      }
      .ba-badge.after {
        left: 1rem;
        background: var(--accent);
        color: var(--accent-on);
      }
      .ba-divider {
        position: absolute;
        inset-block: 0;
        left: var(--pos);
        inline-size: 3px;
        background: oklch(0.99 0.01 90 / 0.95);
        transform: translateX(-50%);
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 0 16px oklch(0.04 0.02 264 / 0.65);
      }
      .ba-handle {
        position: absolute;
        inset-block-start: 50%;
        left: var(--pos);
        transform: translate(-50%, -50%);
        inline-size: 54px;
        block-size: 54px;
        border-radius: 50%;
        background: var(--accent);
        color: var(--accent-on);
        display: grid;
        place-items: center;
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 6px 22px oklch(0.04 0.02 264 / 0.6);
      }
      .ba-range {
        position: absolute;
        inset-block-start: 50%;
        inset-inline: 0;
        transform: translateY(-50%);
        inline-size: 100%;
        block-size: 56px;
        margin: 0;
        z-index: 5;
        cursor: ew-resize;
        opacity: 0;
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        direction: ltr; /* keep range math LTR; value mapped to physical left */
      }
      .ba-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        inline-size: 56px;
        block-size: 56px;
        border-radius: 50%;
      }
      .ba-range::-moz-range-thumb {
        inline-size: 56px;
        block-size: 56px;
        border: 0;
        border-radius: 50%;
      }
      .ba-range:focus-visible {
        opacity: 1;
        outline-offset: -3px;
      }
      .ba-caption {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--ink-mute);
        text-align: center;
        margin-block-start: 1.1rem;
      }

      /* ---------- PROJECTS GALLERY — Embla ---------- */
      .embla--gallery {
        margin-block-start: 2rem;
      }
      .embla--gallery .embla__viewport {
        overflow: hidden;
        border-radius: var(--r-lg);
      }
      .embla--gallery .embla__container {
        display: flex;
        gap: 1.1rem;
        touch-action: pan-y;
      }
      .embla--gallery .embla__slide {
        position: relative;
        flex: 0 0 82%;
        min-inline-size: 0;
        border-radius: var(--r-lg);
        overflow: hidden;
        border: 2px solid var(--line);
        box-shadow: var(--shadow-sm);
      }
      @media (min-width: 720px) {
        .embla--gallery .embla__slide {
          flex-basis: 46%;
        }
      }
      @media (min-width: 1040px) {
        .embla--gallery .embla__slide {
          flex-basis: 31.5%;
        }
      }
      .embla--gallery .embla__slide img {
        inline-size: 100%;
        aspect-ratio: 16 / 11;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .embla--gallery .embla__slide:hover img {
        transform: scale(1.06);
      }
      .embla--gallery .embla__slide span {
        position: absolute;
        inset-block-end: 0.8rem;
        inset-inline-start: 0.8rem;
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.82rem;
        color: var(--on-photo);
        padding: 0.35rem 0.85rem;
        border-radius: var(--r);
        background: oklch(0.08 0.02 264 / 0.65);
        backdrop-filter: blur(6px);
      }
      .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-block-start: 1.5rem;
      }
      .embla__btn {
        inline-size: 48px;
        block-size: 48px;
        border-radius: var(--r);
        display: grid;
        place-items: center;
        border: 2px solid var(--line);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          background 0.3s var(--ease), color 0.3s var(--ease);
      }
      .embla__btn:hover {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--accent-on);
        transform: translateY(-2px);
      }
      .embla__dots {
        display: flex;
        gap: 0.5rem;
      }
      .embla__dot {
        inline-size: 10px;
        block-size: 10px;
        border-radius: 50%;
        border: 0;
        padding: 0;
        cursor: pointer;
        background: var(--hair);
        transition: background 0.3s var(--ease), transform 0.3s var(--ease);
      }
      .embla__dot.is-selected {
        background: var(--accent);
        transform: scale(1.3);
      }

      /* ---------- ABOUT ---------- */
      .about-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        grid-template-columns: 1fr;
      }
      @media (min-width: 880px) {
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
        }
      }
      .about-portrait {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        border: 2px solid var(--line);
        box-shadow: var(--shadow);
      }
      .about-portrait img {
        inline-size: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .about-portrait:hover img {
        transform: scale(1.05);
      }
      .about-portrait .tag {
        position: absolute;
        inset-block-end: 1rem;
        inset-inline-start: 1rem;
        background: var(--accent);
        color: var(--accent-on);
        font-family: var(--font-display);
        padding: 0.6rem 1.1rem;
        border-radius: var(--r);
        font-size: 0.95rem;
        line-height: 1.1;
      }
      .about-portrait .tag small {
        display: block;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.7rem;
        opacity: 0.92;
        margin-block-start: 0.2rem;
      }
      .about h2 {
        font-size: clamp(2rem, 5vw, 3.2rem);
        margin-block: 1rem;
        text-wrap: balance;
      }
      .about p {
        color: var(--ink-soft);
        font-size: 1.08rem;
        font-weight: 500;
        max-inline-size: 54ch;
      }
      .about-points {
        list-style: none;
        margin: 1.9rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.95rem;
      }
      .about-points li {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        font-family: var(--font-body);
        font-weight: 700;
        color: var(--ink);
      }
      .about-points svg {
        flex: none;
        color: var(--accent);
        margin-block-start: 2px;
      }

      /* ---------- FINAL CTA ---------- */
      .cta-band {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        border-block-start: var(--rule) solid var(--line);
      }
      .cta-band > img {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        z-index: -2;
      }
      .cta-band::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          to top,
          var(--scrim-top),
          oklch(0.07 0.02 264 / 0.82)
        );
      }
      .cta-inner {
        text-align: center;
        padding-block: clamp(4rem, 10vw, 7rem);
        color: var(--on-photo);
      }
      .cta-inner h2 {
        font-size: clamp(2.1rem, 6vw, 3.8rem);
        color: var(--on-photo);
        max-inline-size: 20ch;
        margin-inline: auto;
        margin-block: 1rem 1.2rem;
        text-wrap: balance;
      }
      .cta-inner .eyebrow {
        color: var(--on-photo);
        justify-content: center;
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 1.3rem;
        justify-content: center;
        margin-block-start: 1.9rem;
        font-family: var(--font-body);
        font-weight: 700;
      }
      .cta-contact a,
      .cta-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--on-photo-soft);
      }
      .cta-contact a {
        transition: color 0.25s var(--ease);
      }
      .cta-contact a:hover {
        color: var(--on-photo);
      }
      .cta-contact svg {
        color: var(--on-photo);
        flex: none;
      }
      .cta-inner .btn {
        margin-block-start: 2.1rem;
      }

      /* ---------- FOOTER ---------- */
      .site-footer {
        background: var(--invert);
        color: var(--invert-ink);
        padding-block: clamp(2.5rem, 5vw, 3.5rem);
      }
      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        align-items: flex-start;
      }
      @media (min-width: 720px) {
        .footer-inner {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }
      }
      .footer-inner .wordmark {
        font-size: 1.4rem;
        color: var(--invert-ink);
      }
      .footer-tag {
        color: var(--invert-ink);
        opacity: 0.78;
        font-size: 0.95rem;
        max-inline-size: 46ch;
        margin-block: 0.5rem 0;
      }
      .footer-copy {
        color: var(--invert-ink);
        opacity: 0.7;
        font-size: 0.88rem;
      }

      /* ---------- REVEAL ANIM ---------- */
      .reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: rise 0.9s var(--ease) forwards;
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }
      .d1 {
        animation-delay: 0.08s;
      }
      .d2 {
        animation-delay: 0.2s;
      }
      .d3 {
        animation-delay: 0.32s;
      }
      .d4 {
        animation-delay: 0.44s;
      }
      .d5 {
        animation-delay: 0.56s;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>

