<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית, ייעוץ איטום ואפיון ציפויים | חוות דעת קבילות בבית המשפט</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800;900&family=Suez+One&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "dark" || saved === "light" ? saved : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      :root {
        --font-display: "Suez One", "Heebo", system-ui, sans-serif;
        --font-body: "Heebo", system-ui, sans-serif;
        --border-w: 3px;
        --shadow-off: 8px;
        --maxw: 1280px;
      }

      html[data-theme="light"] {
        --bg: oklch(96.5% 0.006 95);
        --bg-2: oklch(99% 0.004 95);
        --ink: oklch(18% 0.01 280);
        --ink-soft: oklch(38% 0.01 280);
        --line: oklch(18% 0.01 280);
        --accent: oklch(72% 0.2 138);
        --accent-ink: oklch(18% 0.04 138);
        --card: oklch(99% 0.004 95);
        --shadow-color: oklch(18% 0.01 280);
        --invert: oklch(18% 0.01 280);
        --invert-ink: oklch(96.5% 0.006 95);
      }

      html[data-theme="dark"] {
        --bg: oklch(16% 0.012 280);
        --bg-2: oklch(21% 0.014 280);
        --ink: oklch(95% 0.006 95);
        --ink-soft: oklch(74% 0.01 95);
        --line: oklch(95% 0.006 95);
        --accent: oklch(78% 0.21 138);
        --accent-ink: oklch(16% 0.05 138);
        --card: oklch(21% 0.014 280);
        --shadow-color: oklch(78% 0.21 138);
        --invert: oklch(95% 0.006 95);
        --invert-ink: oklch(16% 0.012 280);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background-color: var(--bg);
        background-image:
          linear-gradient(var(--bg-2) 0.5px, transparent 0.5px),
          linear-gradient(90deg, var(--bg-2) 0.5px, transparent 0.5px);
        background-size: 34px 34px;
        color: var(--ink);
        font-family: var(--font-body);
        font-weight: 500;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-display);
        font-weight: 900;
        line-height: 0.98;
        letter-spacing: -0.01em;
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: clamp(1rem, 4vw, 3rem);
      }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }

      .skip {
        position: absolute;
        inset-block-start: -100px;
        inset-inline-start: 1rem;
        background: var(--accent);
        color: var(--accent-ink);
        padding: 0.6rem 1rem;
        border: var(--border-w) solid var(--line);
        font-weight: 800;
        z-index: 200;
      }
      .skip:focus {
        inset-block-start: 1rem;
      }

      /* ---------- Header ---------- */
      .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 100;
        background: var(--bg);
        border-block-end: var(--border-w) solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 68px;
      }
      .wordmark {
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 3vw, 1.7rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .wordmark .dot {
        display: inline-block;
        inline-size: 0.7rem;
        block-size: 0.7rem;
        background: var(--accent);
        border: 2px solid var(--line);
      }
      .nav-desktop {
        display: none;
        align-items: center;
        gap: clamp(0.6rem, 1.6vw, 1.6rem);
      }
      .nav-desktop a {
        font-weight: 700;
        font-size: 0.98rem;
        padding-block: 0.25rem;
        border-block-end: 3px solid transparent;
        transition: border-color 0.18s ease;
      }
      .nav-desktop a:hover {
        border-block-end-color: var(--accent);
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1rem;
        line-height: 1;
        padding: 0.85rem 1.3rem;
        border: var(--border-w) solid var(--line);
        background: var(--card);
        color: var(--ink);
        cursor: pointer;
        box-shadow: calc(var(--shadow-off) * -1) var(--shadow-off) 0 0 var(--shadow-color);
        transition:
          transform 0.14s ease,
          box-shadow 0.14s ease;
      }
      .btn:hover {
        transform: translate(4px, -4px);
        box-shadow: calc(var(--shadow-off) * -1.5) calc(var(--shadow-off) * 1.5) 0 0 var(--shadow-color);
      }
      .btn:active {
        transform: translate(0, 0);
        box-shadow: 0 0 0 0 var(--shadow-color);
      }
      .btn-accent {
        background: var(--accent);
        color: var(--accent-ink);
      }
      .btn-invert {
        background: var(--invert);
        color: var(--invert-ink);
      }
      .btn svg {
        inline-size: 1.1em;
        block-size: 1.1em;
      }
      .btn .arrow {
        transition: transform 0.18s ease;
      }
      .btn:hover .arrow {
        transform: translateX(-4px);
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        inline-size: 46px;
        block-size: 46px;
        padding: 0;
        border: var(--border-w) solid var(--line);
        background: var(--card);
        color: var(--ink);
        cursor: pointer;
        box-shadow: -4px 4px 0 0 var(--shadow-color);
        transition:
          transform 0.14s ease,
          box-shadow 0.14s ease;
      }
      .theme-toggle:hover {
        transform: translate(2px, -2px);
        box-shadow: -6px 6px 0 0 var(--shadow-color);
      }
      .theme-toggle svg {
        inline-size: 22px;
        block-size: 22px;
      }
      .theme-toggle .moon {
        display: none;
      }
      html[data-theme="dark"] .theme-toggle .sun {
        display: none;
      }
      html[data-theme="dark"] .theme-toggle .moon {
        display: block;
      }

      .nav-mobile {
        display: block;
      }
      .nav-mobile summary {
        list-style: none;
        cursor: pointer;
      }
      .nav-mobile summary::-webkit-details-marker {
        display: none;
      }
      .nav-mobile summary .theme-toggle,
      .burger {
        pointer-events: none;
      }
      .burger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        inline-size: 46px;
        block-size: 46px;
        border: var(--border-w) solid var(--line);
        background: var(--accent);
        color: var(--accent-ink);
        box-shadow: -4px 4px 0 0 var(--shadow-color);
      }
      .burger svg {
        inline-size: 24px;
        block-size: 24px;
      }
      .mobile-panel {
        position: absolute;
        inset-inline: 0;
        inset-block-start: 100%;
        background: var(--bg);
        border-block-end: var(--border-w) solid var(--line);
        padding: 1rem clamp(1rem, 4vw, 3rem) 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .mobile-panel a {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.5rem;
        padding: 0.6rem 0;
        border-block-end: 2px solid var(--bg-2);
      }
      .mobile-panel a:last-child {
        border-block-end: none;
      }

      /* ---------- Marquee ---------- */
      .marquee {
        background: var(--invert);
        color: var(--invert-ink);
        border-block-end: var(--border-w) solid var(--line);
        overflow: hidden;
        white-space: nowrap;
      }
      .marquee-track {
        display: inline-flex;
        gap: 2.5rem;
        padding-block: 0.7rem;
        animation: marquee 28s linear infinite;
        will-change: transform;
      }
      .marquee-track span {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 2.5rem;
      }
      .marquee-track span::after {
        content: "";
        inline-size: 9px;
        block-size: 9px;
        background: var(--accent);
        border: 1.5px solid var(--invert-ink);
        display: inline-block;
      }
      @keyframes marquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(50%);
        }
      }

      /* ---------- Reveal ---------- */
      .reveal {
        opacity: 0;
        transform: translateY(28px);
        animation: reveal 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      }
      .reveal-2 {
        animation-delay: 0.1s;
      }
      .reveal-3 {
        animation-delay: 0.2s;
      }
      .reveal-4 {
        animation-delay: 0.3s;
      }
      .reveal-5 {
        animation-delay: 0.4s;
      }
      .reveal-6 {
        animation-delay: 0.5s;
      }
      @keyframes reveal {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ---------- Hero ---------- */
      .hero {
        padding-block: clamp(2.5rem, 6vw, 5rem);
        position: relative;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.5rem, 4vw, 2.5rem);
        align-items: start;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        background: var(--accent);
        color: var(--accent-ink);
        border: var(--border-w) solid var(--line);
        padding: 0.4rem 0.9rem;
        margin-block-end: 1.2rem;
      }
      .hero h1 {
        font-size: clamp(2.7rem, 9vw, 6rem);
        margin-block-end: 1.4rem;
      }
      .hero h1 .hl {
        background: var(--accent);
        color: var(--accent-ink);
        padding-inline: 0.12em;
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
      }
      .hero p.sub {
        font-size: clamp(1rem, 1.8vw, 1.2rem);
        color: var(--ink-soft);
        max-width: 56ch;
        margin-block: 0 2rem;
        font-weight: 500;
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
      }
      .hero-media {
        position: relative;
        border: var(--border-w) solid var(--line);
        box-shadow: -12px 12px 0 0 var(--shadow-color);
        background: var(--accent);
        aspect-ratio: 4 / 5;
        overflow: hidden;
      }
      .hero-media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.08);
        mix-blend-mode: luminosity;
      }
      .hero-media .badge {
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 0;
        background: var(--invert);
        color: var(--invert-ink);
        font-family: var(--font-display);
        font-weight: 900;
        padding: 0.7rem 1.1rem;
        font-size: 0.95rem;
        border-block-start: var(--border-w) solid var(--line);
        border-inline-end: var(--border-w) solid var(--line);
      }

      /* ---------- Stats ---------- */
      .stats {
        border-block: var(--border-w) solid var(--line);
        background: var(--invert);
        color: var(--invert-ink);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      .stat {
        padding: clamp(1.3rem, 3vw, 2.2rem) clamp(1rem, 3vw, 2rem);
        border-inline-start: var(--border-w) solid var(--invert-ink);
        border-block-start: var(--border-w) solid var(--invert-ink);
      }
      .stat:nth-child(odd) {
        border-inline-start: none;
      }
      .stat:nth-child(-n + 2) {
        border-block-start: none;
      }
      .stat .num {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: clamp(2rem, 6vw, 3.4rem);
        line-height: 1;
        color: var(--accent);
        display: block;
      }
      .stat .lbl {
        font-weight: 700;
        font-size: clamp(0.85rem, 1.6vw, 1rem);
        margin-block-start: 0.5rem;
        display: block;
      }

      /* ---------- Section heads ---------- */
      .section {
        padding-block: clamp(3rem, 7vw, 6rem);
      }
      .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-block-end: clamp(1.8rem, 4vw, 3rem);
      }
      .kicker {
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-soft);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-block-end: 0.8rem;
      }
      .kicker::before {
        content: "";
        inline-size: 28px;
        block-size: 3px;
        background: var(--accent);
      }
      .section-head h2 {
        font-size: clamp(2rem, 5.5vw, 3.6rem);
      }

      /* ---------- Services ---------- */
      .cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.5rem, 3vw, 2rem);
      }
      .card {
        background: var(--card);
        border: var(--border-w) solid var(--line);
        box-shadow: -8px 8px 0 0 var(--shadow-color);
        padding: clamp(1.4rem, 3vw, 2rem);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease;
      }
      .card:hover {
        transform: translate(4px, -4px);
        box-shadow: -12px 12px 0 0 var(--shadow-color);
      }
      .card-num {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 3.4rem;
        line-height: 0.8;
        color: var(--accent);
        -webkit-text-stroke: 2px var(--line);
      }
      .card-ico {
        inline-size: 52px;
        block-size: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: var(--border-w) solid var(--line);
        background: var(--accent);
        color: var(--accent-ink);
      }
      .card-ico svg {
        inline-size: 28px;
        block-size: 28px;
      }
      .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .card h3 {
        font-size: 1.5rem;
        font-weight: 900;
        font-family: var(--font-display);
      }
      .card p {
        margin: 0;
        color: var(--ink-soft);
      }
      .card ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
        margin-block-start: auto;
      }
      .card li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
        padding-block-start: 0.5rem;
        border-block-start: 2px solid var(--bg-2);
      }
      .card li svg {
        inline-size: 16px;
        block-size: 16px;
        color: var(--accent);
        flex-shrink: 0;
      }

      /* ---------- Before / After ---------- */
      .ba-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.2rem, 3vw, 1.8rem);
      }
      .ba {
        position: relative;
        border: var(--border-w) solid var(--line);
        box-shadow: -8px 8px 0 0 var(--shadow-color);
        overflow: hidden;
        aspect-ratio: 4 / 3;
        background: var(--bg-2);
      }
      .ba img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: grayscale(0.4) contrast(1.05);
      }
      .ba .tag {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.05rem;
        padding: 0.55rem 1.1rem;
        border-block-end: var(--border-w) solid var(--line);
        border-inline-end: var(--border-w) solid var(--line);
      }
      .ba.before .tag {
        background: var(--invert);
        color: var(--invert-ink);
      }
      .ba.after .tag {
        background: var(--accent);
        color: var(--accent-ink);
      }

      /* ---------- About ---------- */
      .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: center;
      }
      .about-portrait {
        position: relative;
        border: var(--border-w) solid var(--line);
        box-shadow: -12px 12px 0 0 var(--shadow-color);
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: var(--accent);
        max-width: 420px;
      }
      .about-portrait img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
      }
      .about-content h2 {
        font-size: clamp(2rem, 5vw, 3.4rem);
        margin-block-end: 1.2rem;
      }
      .about-content p {
        color: var(--ink-soft);
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        max-width: 54ch;
        margin-block: 0 1.5rem;
      }
      .about-sig {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.3rem;
        border: var(--border-w) solid var(--line);
        background: var(--accent);
        color: var(--accent-ink);
        padding: 0.6rem 1.2rem;
        box-shadow: -6px 6px 0 0 var(--shadow-color);
      }

      /* ---------- CTA band ---------- */
      .cta-band {
        background: var(--accent);
        color: var(--accent-ink);
        border-block: var(--border-w) solid var(--line);
      }
      .cta-inner {
        padding-block: clamp(2.5rem, 6vw, 4.5rem);
        text-align: center;
      }
      .cta-inner h2 {
        font-size: clamp(2.2rem, 7vw, 4.5rem);
        color: var(--accent-ink);
        margin-block-end: 1.5rem;
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 1.6rem;
        justify-content: center;
        align-items: center;
        margin-block-start: 1.8rem;
        font-weight: 800;
      }
      .cta-contact a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-block-end: 3px solid var(--accent-ink);
        padding-block-end: 2px;
      }
      .cta-contact svg {
        inline-size: 1.1em;
        block-size: 1.1em;
      }

      /* ---------- Footer ---------- */
      .site-footer {
        background: var(--invert);
        color: var(--invert-ink);
        border-block-start: var(--border-w) solid var(--line);
        padding-block: clamp(2rem, 4vw, 3rem);
      }
      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-between;
        align-items: flex-start;
      }
      .footer-inner .wordmark {
        color: var(--invert-ink);
      }
      .footer-tag {
        color: var(--invert-ink);
        opacity: 0.85;
        max-width: 50ch;
        font-weight: 500;
        font-size: 0.95rem;
      }
      .footer-bottom {
        font-weight: 700;
        font-size: 0.9rem;
        opacity: 0.85;
      }

      /* ---------- Responsive ---------- */
      @media (min-width: 768px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
        .stat:nth-child(odd) {
          border-inline-start: var(--border-w) solid var(--invert-ink);
        }
        .stat:nth-child(1) {
          border-inline-start: none;
        }
        .stat {
          border-block-start: none;
        }
        .ba-grid {
          grid-template-columns: 1fr 1fr;
        }
        .footer-inner {
          flex-direction: row;
          align-items: center;
        }
      }

      @media (min-width: 960px) {
        .nav-desktop {
          display: flex;
        }
        .nav-mobile {
          display: none;
        }
        .hero-grid {
          grid-template-columns: 1.25fr 1fr;
          gap: clamp(2rem, 5vw, 4rem);
        }
        .cards {
          grid-template-columns: repeat(3, 1fr);
        }
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .reveal {
          opacity: 1;
          transform: none;
