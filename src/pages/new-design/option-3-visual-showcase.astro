<!doctype html>
<html lang="he" dir="rtl" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית · ייעוץ איטום · אפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Suez+One&family=Heebo:wght@300;400;500;600;700;900&family=Assistant:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "light" || saved === "dark" ? saved : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      /* ============ TOKENS ============ */
      html[data-theme="dark"] {
        --bg: oklch(0.15 0.012 250);
        --bg-2: oklch(0.19 0.015 250);
        --surface: oklch(0.23 0.018 250);
        --surface-2: oklch(0.27 0.02 250);
        --border: oklch(0.36 0.02 250 / 0.55);
        --ink: oklch(0.97 0.005 250);
        --ink-soft: oklch(0.84 0.01 250);
        --ink-mute: oklch(0.68 0.012 250);
        --accent: oklch(0.74 0.16 52);
        --accent-2: oklch(0.8 0.13 60);
        --accent-ink: oklch(0.18 0.05 52);
        --on-photo: oklch(0.99 0.01 90);
        --on-photo-soft: oklch(0.93 0.008 250);
        --scrim-top: oklch(0.07 0.012 250 / 0.95);
        --scrim-mid: oklch(0.08 0.012 250 / 0.55);
        --card-glow: oklch(0.74 0.16 52 / 0.18);
        --shadow: 0 24px 60px -24px oklch(0.04 0.02 250 / 0.85);
        --shadow-sm: 0 10px 30px -16px oklch(0.04 0.02 250 / 0.7);
      }
      html[data-theme="light"] {
        --bg: oklch(0.985 0.005 80);
        --bg-2: oklch(0.955 0.008 80);
        --surface: oklch(1 0 0);
        --surface-2: oklch(0.97 0.006 80);
        --border: oklch(0.82 0.012 80 / 0.95);
        --ink: oklch(0.21 0.02 250);
        --ink-soft: oklch(0.35 0.02 250);
        --ink-mute: oklch(0.47 0.018 250);
        --accent: oklch(0.58 0.17 46);
        --accent-2: oklch(0.54 0.17 42);
        --accent-ink: oklch(0.99 0.01 80);
        --on-photo: oklch(0.99 0.01 90);
        --on-photo-soft: oklch(0.94 0.008 250);
        --scrim-top: oklch(0.08 0.012 250 / 0.92);
        --scrim-mid: oklch(0.1 0.012 250 / 0.5);
        --card-glow: oklch(0.58 0.17 46 / 0.14);
        --shadow: 0 24px 56px -26px oklch(0.45 0.04 80 / 0.5);
        --shadow-sm: 0 10px 28px -18px oklch(0.45 0.04 80 / 0.4);
      }

      :root {
        --maxw: 1240px;
        --pad: clamp(1.15rem, 4vw, 3rem);
        --r: 16px;
        --r-lg: 24px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Heebo", sans-serif;
        font-weight: 400;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        transition: background 0.4s var(--ease), color 0.4s var(--ease);
      }

      h1,
      h2,
      h3 {
        font-family: "Suez One", serif;
        font-weight: 400;
        line-height: 1.08;
        margin: 0;
        letter-spacing: -0.01em;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
        border-radius: 6px;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--pad);
      }

      .eyebrow {
        font-family: "Assistant", sans-serif;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        color: var(--accent);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .eyebrow::before {
        content: "";
        inline-size: 26px;
        block-size: 2px;
        background: currentColor;
        display: inline-block;
        flex: none;
      }

      /* ============ BUTTONS ============ */
      .btn {
        font-family: "Assistant", sans-serif;
        font-weight: 700;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.9rem 1.6rem;
        min-block-size: 48px;
        border-radius: 100px;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease),
          background 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .btn svg {
        transition: transform 0.3s var(--ease);
      }
      .btn-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: var(--accent-ink);
        box-shadow: 0 10px 30px -12px var(--accent);
      }
      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px -14px var(--accent);
      }
      /* RTL arrow points left */
      .btn:hover svg {
        transform: translateX(-5px);
      }
      .btn-ghost {
        background: oklch(0.5 0.02 250 / 0.18);
        color: var(--on-photo);
        border-color: oklch(0.95 0.01 250 / 0.35);
        backdrop-filter: blur(10px);
      }
      .btn-ghost:hover {
        transform: translateY(-3px);
        border-color: var(--accent-2);
        background: oklch(0.5 0.02 250 / 0.3);
      }
      .btn-solid {
        background: var(--ink);
        color: var(--bg);
        border-color: transparent;
      }
      .btn-solid:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-sm);
      }

      /* ============ HEADER ============ */
      .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: oklch(0.15 0.012 250 / 0.62);
        backdrop-filter: blur(16px);
        border-block-end: 1px solid var(--border);
        transition: background 0.4s var(--ease);
      }
      html[data-theme="light"] .site-header {
        background: oklch(0.985 0.005 80 / 0.76);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        block-size: 72px;
      }
      .wordmark {
        font-family: "Suez One", serif;
        font-size: 1.5rem;
        letter-spacing: -0.02em;
        white-space: nowrap;
      }
      .wordmark span {
        color: var(--accent);
      }
      .nav {
        display: none;
        gap: 1.7rem;
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        font-size: 0.98rem;
      }
      .nav a {
        position: relative;
        color: var(--ink-soft);
        padding-block: 0.3rem;
        transition: color 0.25s var(--ease);
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 0;
        inline-size: 0;
        block-size: 2px;
        background: var(--accent);
        transition: inline-size 0.3s var(--ease);
      }
      .nav a:hover {
        color: var(--ink);
      }
      .nav a:hover::after {
        inline-size: 100%;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }
      .theme-toggle {
        inline-size: 44px;
        block-size: 44px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          background 0.3s var(--ease);
      }
      .theme-toggle:hover {
        transform: rotate(18deg);
        border-color: var(--accent);
      }
      .theme-toggle .icon-sun {
        display: none;
      }
      html[data-theme="light"] .theme-toggle .icon-sun {
        display: block;
      }
      html[data-theme="light"] .theme-toggle .icon-moon {
        display: none;
      }
      .header-cta {
        display: none;
      }
      @media (min-width: 900px) {
        .nav {
          display: flex;
        }
        .header-cta {
          display: inline-flex;
        }
      }

      /* ============ HERO ============ */
      .hero {
        position: relative;
        min-block-size: clamp(580px, 94svh, 940px);
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        isolation: isolate;
      }
      .hero-media {
        position: absolute;
        inset: 0;
        z-index: -2;
      }
      /* hero background = Embla carousel of jobsite photos */
      .hero-media .embla,
      .hero-media .embla__container,
      .hero-media .embla__slide {
        block-size: 100%;
      }
      .hero-media .embla {
        overflow: hidden;
      }
      .hero-media .embla__container {
        display: flex;
      }
      .hero-media .embla__slide {
        position: relative;
        flex: 0 0 100%;
        min-inline-size: 0;
      }
      .hero-media img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        transform: scale(1.06);
      }
      .hero-scrim {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            to top,
            var(--scrim-top) 2%,
            var(--scrim-mid) 48%,
            transparent 82%
          ),
          linear-gradient(
            to inline-start,
            transparent 38%,
            oklch(0.06 0.012 250 / 0.55) 100%
          );
      }
      .hero-content {
        padding-block: clamp(2.6rem, 7vw, 5.5rem);
        max-inline-size: 760px;
      }
      .hero h1 {
        /* tighter, controlled wrap; balance prevents orphan accent line */
        font-size: clamp(2.15rem, 6vw, 4.4rem);
        line-height: 1.06;
        color: var(--on-photo);
        text-wrap: balance;
        text-shadow: 0 4px 30px oklch(0.04 0.02 250 / 0.65);
        margin-block: 1rem 1.15rem;
        max-inline-size: 16ch;
      }
      .hero h1 .hl {
        color: var(--accent-2);
        white-space: nowrap;
      }
      .hero p {
        font-size: clamp(1rem, 1.5vw, 1.18rem);
        color: var(--on-photo-soft);
        max-inline-size: 56ch;
        text-shadow: 0 2px 16px oklch(0.04 0.02 250 / 0.75);
      }
      .hero .eyebrow {
        color: var(--accent-2);
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-block-start: 1.9rem;
      }
      /* one small trust chip — court mentioned once only */
      .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-block-start: 1.5rem;
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        font-size: 0.82rem;
        color: var(--on-photo);
        padding: 0.4rem 0.9rem 0.4rem 0.75rem;
        border-radius: 100px;
        border: 1px solid oklch(0.9 0.01 250 / 0.32);
        background: oklch(0.18 0.012 250 / 0.42);
        backdrop-filter: blur(8px);
      }
      .hero-chip svg {
        color: var(--accent-2);
        flex: none;
      }

      /* ============ STATS STRIP ============ */
      .stats {
        background: var(--bg-2);
        border-block-end: 1px solid var(--border);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        overflow: hidden;
        margin-block: -3.25rem 0;
        position: relative;
        z-index: 5;
        box-shadow: var(--shadow);
      }
      @media (min-width: 760px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .stat {
        background: var(--surface);
        padding: clamp(1.5rem, 3vw, 2.1rem) 1rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: background 0.3s var(--ease);
      }
      .stat:hover {
        background: var(--surface-2);
      }
      .stat .num {
        font-family: "Suez One", serif;
        font-size: clamp(1.6rem, 3.6vw, 2.2rem);
        color: var(--accent);
        line-height: 1;
      }
      .stat .lbl {
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--ink-soft);
        margin-block-start: 0.5rem;
      }

      /* ============ SECTION SHELL ============ */
      .section {
        padding-block: clamp(4.5rem, 10vw, 8rem);
      }
      .section-head {
        max-inline-size: 700px;
        margin-block-end: clamp(2.4rem, 5vw, 3.4rem);
      }
      .section-head h2 {
        font-size: clamp(1.95rem, 4.6vw, 3.1rem);
        margin-block: 0.9rem 0.85rem;
        text-wrap: balance;
      }
      .section-head p {
        color: var(--ink-mute);
        font-size: 1.06rem;
        max-inline-size: 54ch;
      }

      /* ============ SERVICES ============ */
      .svc-grid {
        display: grid;
        gap: 1.3rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 720px) {
        .svc-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 1040px) {
        .svc-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .svc {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        min-block-size: 430px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        isolation: isolate;
        border: 1px solid var(--border);
        transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
      }
      .svc:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow);
      }
      .svc-img {
        position: absolute;
        inset: 0;
        z-index: -2;
      }
      .svc-img img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .svc:hover .svc-img img {
        transform: scale(1.08);
      }
      .svc::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          to top,
          var(--scrim-top) 10%,
          oklch(0.08 0.012 250 / 0.5) 52%,
          oklch(0.08 0.012 250 / 0.08) 100%
        );
      }
      .svc-body {
        padding: clamp(1.5rem, 3vw, 1.9rem);
        color: var(--on-photo);
      }
      .svc-num {
        font-family: "Suez One", serif;
        font-size: 0.95rem;
        color: var(--accent-2);
      }
      .svc-body h3 {
        font-size: 1.5rem;
        color: var(--on-photo);
        margin-block: 0.4rem 0.85rem;
      }
      .svc-body > p {
        color: var(--on-photo-soft);
        font-size: 0.98rem;
        margin: 0 0 1.1rem;
      }
      .svc-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.55rem;
      }
      .svc-list li {
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--on-photo);
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }
      .svc-list svg {
        flex: none;
        color: var(--accent-2);
      }

      /* ============ BEFORE / AFTER — CENTERPIECE ============ */
      .ba {
        background: var(--bg-2);
        position: relative;
        overflow: hidden;
      }
      .ba::before {
        content: "";
        position: absolute;
        inset-block-start: -25%;
        inset-inline-end: -12%;
        inline-size: 55vw;
        block-size: 55vw;
        background: radial-gradient(circle, var(--card-glow), transparent 70%);
        z-index: 0;
        pointer-events: none;
      }
      .ba .wrap {
        position: relative;
        z-index: 1;
      }
      .ba .section-head {
        text-align: center;
        margin-inline: auto;
      }
      .ba .section-head .eyebrow {
        justify-content: center;
      }
      .ba .section-head p {
        margin-inline: auto;
      }
      .ba-stage {
        max-inline-size: 1000px;
        margin-inline: auto;
      }
      .ba-compare {
        position: relative;
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        --pos: 50%;
        user-select: none;
        touch-action: pan-y;
      }
      .ba-layer {
        position: absolute;
        inset: 0;
      }
      .ba-layer img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
      /* "after" sits on top, clipped. Physical positioning (RTL-safe):
         before stays on the RIGHT, after is revealed from the LEFT as --pos grows. */
      .ba-after {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
      }
      .ba-badge {
        position: absolute;
        inset-block-start: 1rem;
        font-family: "Assistant", sans-serif;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        padding: 0.4rem 1rem;
        border-radius: 100px;
        background: oklch(0.08 0.012 250 / 0.72);
        color: var(--on-photo);
        backdrop-filter: blur(6px);
        z-index: 4;
        pointer-events: none;
      }
      .ba-badge.before {
        right: 1rem;
      }
      .ba-badge.after {
        left: 1rem;
        background: var(--accent);
        color: var(--accent-ink);
      }
      .ba-divider {
        position: absolute;
        inset-block: 0;
        left: var(--pos);
        inline-size: 3px;
        background: oklch(0.99 0.01 90 / 0.92);
        transform: translateX(-50%);
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 0 16px oklch(0.04 0.02 250 / 0.65);
      }
      .ba-handle {
        position: absolute;
        inset-block-start: 50%;
        left: var(--pos);
        transform: translate(-50%, -50%);
        inline-size: 54px;
        block-size: 54px;
        border-radius: 50%;
        background: var(--accent);
        color: var(--accent-ink);
        display: grid;
        place-items: center;
        z-index: 3;
        pointer-events: none;
        box-shadow: 0 6px 22px oklch(0.04 0.02 250 / 0.6);
      }
      .ba-range {
        position: absolute;
        inset-block-start: 50%;
        inset-inline: 0;
        transform: translateY(-50%);
        inline-size: 100%;
        block-size: 56px;
        margin: 0;
        z-index: 5;
        cursor: ew-resize;
        opacity: 0;
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        direction: ltr; /* keep range math LTR; value mapped to inline-end */
      }
      .ba-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        inline-size: 56px;
        block-size: 56px;
        border-radius: 50%;
      }
      .ba-range::-moz-range-thumb {
        inline-size: 56px;
        block-size: 56px;
        border: 0;
        border-radius: 50%;
      }
      .ba-range:focus-visible {
        opacity: 1;
        outline-offset: -3px;
      }
      .ba-caption {
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ink-mute);
        text-align: center;
        margin-block-start: 1.1rem;
      }
      /* projects gallery — Embla carousel (uses the project's embla-carousel lib) */
      .embla--gallery {
        margin-block-start: 1.9rem;
      }
      .embla--gallery .embla__viewport {
        overflow: hidden;
        border-radius: var(--r);
      }
      .embla--gallery .embla__container {
        display: flex;
        gap: 1.1rem;
        touch-action: pan-y;
      }
      .embla--gallery .embla__slide {
        position: relative;
        flex: 0 0 82%;
        min-inline-size: 0;
        border-radius: var(--r);
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
      }
      @media (min-width: 720px) {
        .embla--gallery .embla__slide {
          flex-basis: 46%;
        }
      }
      @media (min-width: 1040px) {
        .embla--gallery .embla__slide {
          flex-basis: 31.5%;
        }
      }
      .embla--gallery .embla__slide img {
        inline-size: 100%;
        aspect-ratio: 16 / 11;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .embla--gallery .embla__slide:hover img {
        transform: scale(1.06);
      }
      .embla--gallery .embla__slide span {
        position: absolute;
        inset-block-end: 0.8rem;
        inset-inline-start: 0.8rem;
        font-family: "Assistant", sans-serif;
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--on-photo);
        padding: 0.35rem 0.85rem;
        border-radius: 100px;
        background: oklch(0.08 0.012 250 / 0.6);
        backdrop-filter: blur(6px);
      }
      .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-block-start: 1.4rem;
      }
      .embla__btn {
        inline-size: 46px;
        block-size: 46px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          background 0.3s var(--ease);
      }
      .embla__btn:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
      }
      .embla__dots {
        display: flex;
        gap: 0.5rem;
      }
      .embla__dot {
        inline-size: 9px;
        block-size: 9px;
        border-radius: 50%;
        border: 0;
        padding: 0;
        cursor: pointer;
        background: var(--border);
        transition: background 0.3s var(--ease), transform 0.3s var(--ease);
      }
      .embla__dot.is-selected {
        background: var(--accent);
        transform: scale(1.25);
      }

      /* ============ ABOUT ============ */
      .about-grid {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: center;
        grid-template-columns: 1fr;
      }
      @media (min-width: 880px) {
        .about-grid {
          grid-template-columns: 0.85fr 1.15fr;
        }
      }
      .about-portrait {
        position: relative;
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
      }
      .about-portrait img {
        inline-size: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        transition: transform 0.7s var(--ease);
      }
      .about-portrait:hover img {
        transform: scale(1.05);
      }
      .about-portrait .tag {
        position: absolute;
        inset-block-end: 1rem;
        inset-inline-start: 1rem;
        background: var(--accent);
        color: var(--accent-ink);
        font-family: "Suez One", serif;
        padding: 0.6rem 1.1rem;
        border-radius: 14px;
        font-size: 0.95rem;
        line-height: 1.1;
      }
      .about-portrait .tag small {
        display: block;
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        font-size: 0.7rem;
        opacity: 0.9;
      }
      .about h2 {
        font-size: clamp(1.9rem, 4.6vw, 2.9rem);
        margin-block: 0.9rem;
        text-wrap: balance;
      }
      .about p {
        color: var(--ink-soft);
        font-size: 1.08rem;
        max-inline-size: 54ch;
      }
      .about-points {
        list-style: none;
        margin: 1.8rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.9rem;
      }
      .about-points li {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        font-family: "Assistant", sans-serif;
        font-weight: 600;
        color: var(--ink);
      }
      .about-points svg {
        flex: none;
        color: var(--accent);
        margin-block-start: 2px;
      }

      /* ============ FINAL CTA ============ */
      .cta-band {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }
      .cta-band img {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        z-index: -2;
      }
      .cta-band::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          to top,
          var(--scrim-top),
          oklch(0.07 0.012 250 / 0.8)
        );
      }
      .cta-inner {
        text-align: center;
        padding-block: clamp(4rem, 10vw, 7rem);
        color: var(--on-photo);
      }
      .cta-inner h2 {
        font-size: clamp(2rem, 5.4vw, 3.6rem);
        color: var(--on-photo);
        max-inline-size: 20ch;
        margin-inline: auto;
        margin-block: 0.9rem 1.15rem;
        text-wrap: balance;
        text-shadow: 0 4px 24px oklch(0.04 0.02 250 / 0.65);
      }
      .cta-inner .eyebrow {
        color: var(--accent-2);
        justify-content: center;
      }
      .cta-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 1.3rem;
        justify-content: center;
        margin-block-start: 1.9rem;
        font-family: "Assistant", sans-serif;
        font-weight: 600;
      }
      .cta-contact a,
      .cta-contact span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--on-photo-soft);
      }
      .cta-contact a {
        transition: color 0.25s var(--ease);
      }
      .cta-contact a:hover {
        color: var(--on-photo);
      }
      .cta-contact svg {
        color: var(--accent-2);
        flex: none;
      }
      .cta-inner .btn {
        margin-block-start: 2.1rem;
      }

      /* ============ FOOTER ============ */
      .site-footer {
        background: var(--bg-2);
        border-block-start: 1px solid var(--border);
        padding-block: clamp(2.5rem, 5vw, 3.5rem);
      }
      .footer-inner {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        align-items: flex-start;
      }
      @media (min-width: 720px) {
        .footer-inner {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }
      }
      .footer-inner .wordmark {
        font-size: 1.4rem;
      }
      .footer-tag {
        color: var(--ink-mute);
        font-size: 0.95rem;
        max-inline-size: 46ch;
        margin-block: 0.5rem 0;
      }
      .footer-copy {
        color: var(--ink-mute);
        font-size: 0.88rem;
      }

      /* ============ REVEAL ANIM ============ */
      .reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: rise 0.9s var(--ease) forwards;
      }
      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }
      .d1 {
        animation-delay: 0.08s;
      }
      .d2 {
        animation-delay: 0.2s;
      }
      .d3 {
        animation-delay: 0.32s;
      }
      .d4 {
        animation-delay: 0.44s;
      }
      .d5 {
        animation-delay: 0.56s;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
        .hero-media img {
          animation: none;
          transform: scale(1.04);
        }
      }
    </style>
  </head>

