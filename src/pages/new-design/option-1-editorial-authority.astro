    <script is:inline>
      (function () {
        var KEY = "dmeyers-mock-theme";
        var root = document.documentElement;
        var btn = document.getElementById("themeToggle");
        if (btn) {
          btn.addEventListener("click", function () {
            var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            root.setAttribute("data-theme", next);
            try {
              localStorage.setItem(KEY, next);
            } catch (e) {}
          });
        }

        /* Before/After comparison slider (physical, RTL-correct) */
        var range = document.getElementById("baRange");
        var shell = document.getElementById("baShell");
        if (range && shell) {
          var apply = function () {
            shell.style.setProperty("--pos", range.value + "%");
          };
          range.addEventListener("input", apply);
          apply();
        }
      })();
    </script>

    <script>
      import EmblaCarousel from "embla-carousel";
      import Autoplay from "embla-carousel-autoplay";

      const hero = document.querySelector<HTMLElement>("[data-embla-hero]");
      if (hero) {
        EmblaCarousel(hero, { loop: true, direction: "rtl", duration: 30 }, [
          Autoplay({ delay: 4500, stopOnInteraction: false }),
        ]);
      }

      const gallery = document.querySelector<HTMLElement>("[data-embla-gallery]");
      const viewport = gallery?.querySelector<HTMLElement>(".embla__viewport");
      if (gallery && viewport) {
        const embla = EmblaCarousel(viewport, {
          loop: true,
          direction: "rtl",
          align: "start",
        });
        const prevBtn = gallery.querySelector(".embla__prev");
        const nextBtn = gallery.querySelector(".embla__next");
        const dotsNode = gallery.querySelector("[data-embla-dots]");
        if (prevBtn) prevBtn.addEventListener("click", () => embla.scrollPrev());
        if (nextBtn) nextBtn.addEventListener("click", () => embla.scrollNext());
        let dots: Element[] = [];
        if (dotsNode) {
          dotsNode.innerHTML = embla
            .scrollSnapList()
            .map(
              (_, i) =>
                '<button class="embla__dot" type="button" aria-label="מעבר לפרויקט ' +
                (i + 1) +
                '"></button>'
            )
            .join("");
          dots = Array.from(dotsNode.children);
          dots.forEach((d, i) =>
            d.addEventListener("click", () => embla.scrollTo(i))
          );
        }
        const onSelect = () => {
          const i = embla.selectedScrollSnap();
          dots.forEach((d, n) => d.classList.toggle("is-selected", n === i));
        };
        embla.on("select", onSelect);
        onSelect();
      }
    </script>
