<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית · ייעוץ איטום · אפיון ציפויים לתעשייה</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700;800;900&family=Assistant:wght@300;400;500;600;700&family=Heebo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var key = "dmeyers-mock-theme";
          var saved = localStorage.getItem(key);
          var theme = saved === "light" || saved === "dark" ? saved : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <style>
      :root {
        --serif: "Frank Ruhl Libre", Georgia, "Times New Roman", serif;
        --sans: "Assistant", "Heebo", system-ui, -apple-system, sans-serif;
        --maxw: 1240px;

        /* Type scale — fluid, editorial */
        --t-caption: clamp(0.78rem, 0.74rem + 0.18vw, 0.9rem);
        --t-body: clamp(1rem, 0.96rem + 0.22vw, 1.12rem);
        --t-lede: clamp(1.12rem, 1.02rem + 0.5vw, 1.35rem);
        --t-h3: clamp(1.3rem, 1.16rem + 0.7vw, 1.7rem);
        --t-h2: clamp(2rem, 1.55rem + 2.2vw, 3.4rem);
        --t-display: clamp(2.6rem, 1.7rem + 4.4vw, 5.4rem);

        /* Rhythm — tighter, deliberate */
        --section-y: clamp(3.25rem, 2.6rem + 3.5vw, 5.75rem);
        --gutter: clamp(1.15rem, 0.6rem + 3vw, 3rem);

        --rule: 1px;
        --radius: 4px;
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      }

      html[data-theme="light"] {
        --paper: oklch(97.6% 0.011 84);
        --paper-2: oklch(94.6% 0.016 82);
        --paper-3: oklch(91.5% 0.02 80);
        --ink: oklch(24% 0.018 55);
        --ink-soft: oklch(40% 0.016 55);
        --ink-faint: oklch(50% 0.015 58);
        --accent: oklch(43% 0.135 22);
        --accent-soft: oklch(49% 0.13 24);
        --accent-tint: oklch(43% 0.135 22 / 0.08);
        --line: oklch(82% 0.016 70);
        --line-strong: oklch(66% 0.02 65);
        --card: oklch(99.2% 0.006 88);
        --shadow-1: 0 1px 2px oklch(24% 0.018 55 / 0.06), 0 6px 18px oklch(24% 0.018 55 / 0.07);
        --shadow-2: 0 10px 40px oklch(24% 0.018 55 / 0.12);
        --on-accent: oklch(98% 0.01 85);
        --hero-tint-a: oklch(20% 0.02 55 / 0.66);
        --hero-tint-b: oklch(20% 0.02 55 / 0.16);
        --on-photo: oklch(97% 0.01 85);
      }

      html[data-theme="dark"] {
        --paper: oklch(17.5% 0.012 58);
        --paper-2: oklch(21% 0.014 56);
        --paper-3: oklch(25% 0.016 54);
        --ink: oklch(94% 0.011 82);
        --ink-soft: oklch(80% 0.013 78);
        --ink-faint: oklch(66% 0.013 72);
        --accent: oklch(70% 0.145 30);
        --accent-soft: oklch(76% 0.13 32);
        --accent-tint: oklch(70% 0.145 30 / 0.15);
        --line: oklch(34% 0.014 60);
        --line-strong: oklch(48% 0.018 58);
        --card: oklch(21.5% 0.014 57);
        --shadow-1: 0 1px 2px oklch(0% 0 0 / 0.3), 0 8px 24px oklch(0% 0 0 / 0.35);
        --shadow-2: 0 14px 48px oklch(0% 0 0 / 0.5);
        --on-accent: oklch(15% 0.012 58);
        --hero-tint-a: oklch(10% 0.012 58 / 0.74);
        --hero-tint-b: oklch(10% 0.012 58 / 0.24);
        --on-photo: oklch(97% 0.01 85);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: var(--sans);
        font-size: var(--t-body);
        line-height: 1.65;
        color: var(--ink);
        background-color: var(--paper);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        transition: background-color 0.5s var(--ease), color 0.5s var(--ease);
      }

      h1, h2, h3 {
        font-family: var(--serif);
        font-weight: 800;
        line-height: 1.06;
        letter-spacing: -0.012em;
        text-wrap: balance;
      }

      a { color: inherit; text-decoration: none; }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      :focus-visible {
        outline: 2.5px solid var(--accent);
        outline-offset: 3px;
        border-radius: 3px;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .skip {
        position: absolute;
        inset-inline-start: -9999px;
        top: 0;
        z-index: 100;
        background: var(--accent);
        color: var(--on-accent);
        padding: 0.6rem 1rem;
        border-radius: 0 0 var(--radius) var(--radius);
      }
      .skip:focus { inset-inline-start: 0; }

      .eyebrow {
        font-family: var(--sans);
        font-size: var(--t-caption);
        font-weight: 700;
        letter-spacing: 0.2em;
        color: var(--accent);
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
      }
      .eyebrow::before {
        content: "";
        width: clamp(1.4rem, 4vw, 2.4rem);
        height: 2px;
        background: var(--accent);
        flex: none;
      }

      .numeral {
        font-family: var(--serif);
        font-weight: 500;
        line-height: 1;
        color: var(--accent);
        font-variant-numeric: lining-nums;
        font-feature-settings: "lnum";
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--t-caption);
        font-weight: 600;
        letter-spacing: 0.01em;
        color: var(--ink-soft);
        background: var(--accent-tint);
        border: var(--rule) solid color-mix(in oklch, var(--accent) 30%, transparent);
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
      }
      .chip svg { width: 0.95em; height: 0.95em; color: var(--accent); flex: none; }

      /* ---------- HEADER ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in oklch, var(--paper) 85%, transparent);
        backdrop-filter: blur(14px) saturate(1.1);
        border-bottom: var(--rule) solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: clamp(60px, 8vh, 74px);
      }
      .wordmark {
        font-family: var(--serif);
        font-weight: 900;
        font-size: clamp(1.3rem, 1.05rem + 1vw, 1.65rem);
        letter-spacing: -0.02em;
        display: inline-flex;
        align-items: baseline;
        white-space: nowrap;
      }
      .wordmark .dot { color: var(--accent); }

      .nav {
        display: none;
        gap: clamp(1.1rem, 2vw, 2.1rem);
        font-size: var(--t-caption);
        font-weight: 600;
        letter-spacing: 0.04em;
      }
      .nav a {
        position: relative;
        padding-block: 0.45rem;
        color: var(--ink-soft);
        transition: color 0.25s var(--ease);
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: inline-end;
        transition: transform 0.3s var(--ease);
      }
      .nav a:hover { color: var(--ink); }
      .nav a:hover::after { transform: scaleX(1); transform-origin: inline-start; }

      .header-actions { display: flex; align-items: center; gap: clamp(0.5rem, 1.5vw, 0.85rem); }

      .phone-link {
        display: none;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--t-caption);
        font-weight: 600;
        color: var(--ink-soft);
        transition: color 0.25s var(--ease);
      }
      .phone-link:hover { color: var(--accent); }
      .phone-link svg { width: 1em; height: 1em; }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        font-family: var(--sans);
        font-weight: 700;
        font-size: var(--t-caption);
        letter-spacing: 0.02em;
        min-height: 44px;
        padding: 0.65rem 1.3rem;
        border: 1.5px solid var(--accent);
        background: var(--accent);
        color: var(--on-accent);
        border-radius: var(--radius);
        cursor: pointer;
        transition: background 0.25s var(--ease), color 0.25s var(--ease),
          transform 0.25s var(--ease), box-shadow 0.25s var(--ease),
          border-color 0.25s var(--ease);
        white-space: nowrap;
      }
      .btn:hover {
        background: var(--accent-soft);
        border-color: var(--accent-soft);
        transform: translateY(-2px);
        box-shadow: var(--shadow-1);
      }
      .btn--ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line-strong);
      }
      .btn--ghost:hover {
        background: transparent;
        border-color: var(--accent);
        color: var(--accent);
        box-shadow: none;
      }
      .btn svg { width: 1.05em; height: 1.05em; flex: none; }
      /* RTL: arrow points left, nudges left on hover */
      .btn:hover .arrow { transform: translateX(-3px); }
      .btn .arrow { transition: transform 0.25s var(--ease); }

      .toggle {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: var(--rule) solid var(--line-strong);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        border-radius: 50%;
        transition: border-color 0.25s var(--ease), color 0.25s var(--ease),
          transform 0.45s var(--ease), background 0.25s var(--ease);
      }
      .toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: rotate(20deg);
      }
      .toggle svg { width: 18px; height: 18px; }
      .toggle .moon { display: none; }
      html[data-theme="dark"] .toggle .sun { display: none; }
      html[data-theme="dark"] .toggle .moon { display: block; }

      /* ---------- HERO ---------- */
      .hero { padding-block: clamp(2rem, 1.6rem + 2.5vw, 3.5rem) 0; }
      .hero-masthead {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem 1.25rem;
        padding-bottom: 1rem;
        margin-bottom: clamp(1.6rem, 3.5vw, 2.6rem);
        border-bottom: var(--rule) solid var(--line);
        font-size: var(--t-caption);
        font-weight: 600;
        letter-spacing: 0.14em;
        color: var(--ink-faint);
      }
      .hero-masthead .lead-mast { color: var(--accent); }

      .hero-top {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.5rem, 4vw, 2.75rem);
        align-items: end;
        margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
      }
      .hero h1 {
        font-size: var(--t-display);
        font-weight: 900;
        max-width: 13ch;
      }
      .hero h1 .accent { color: var(--accent); }
      .hero-aside {
        display: grid;
        gap: 1.4rem;
        align-content: end;
      }
      .hero-sub {
        color: var(--ink-soft);
        font-size: var(--t-lede);
        max-width: 46ch;
        border-inline-start: 2.5px solid var(--accent);
        padding-inline-start: clamp(1rem, 2vw, 1.4rem);
        line-height: 1.58;
      }
      .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }

      /* Cinematic wide image band = live Embla hero carousel */
      .hero-band {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius);
        box-shadow: var(--shadow-2);
        border: var(--rule) solid var(--line);
        isolation: isolate;
      }
      .hero-band .embla,
      .hero-band .embla__container,
      .hero-band .embla__slide {
        height: 100%;
      }
      .hero-band .embla {
        overflow: hidden;
        aspect-ratio: 16 / 11;
      }
      @media (min-width: 960px) {
        .hero-band .embla { aspect-ratio: 21 / 8; }
      }
      .hero-band .embla__container { display: flex; }
      .hero-band .embla__slide {
        position: relative;
        flex: 0 0 100%;
        min-inline-size: 0;
      }
      .hero-band .embla__slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.04);
      }
      .hero-band .embla__slide::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(to top, var(--hero-tint-a), var(--hero-tint-b) 55%, transparent 82%);
      }
      .hero-band-overlay {
        position: absolute;
        inset-block-end: 0;
        inset-inline: 0;
        z-index: 2;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding: clamp(1.1rem, 3vw, 2rem);
        pointer-events: none;
      }
      .hero-band-caption {
        font-size: var(--t-caption);
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--on-photo);
        text-shadow: 0 2px 14px oklch(15% 0.02 55 / 0.6);
      }
      .hero-band-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; pointer-events: auto; }
      .hero-band-chips .chip {
        color: var(--on-photo);
        background: oklch(20% 0.02 55 / 0.45);
        border-color: oklch(100% 0 0 / 0.25);
        backdrop-filter: blur(6px);
      }
      .hero-band-chips .chip svg { color: var(--on-photo); }

      /* ---------- STATS ---------- */
      .stats {
        border-block: var(--rule) solid var(--line-strong);
        background: var(--paper-2);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
      }
      .stat {
        padding: clamp(1.5rem, 4vw, 2.4rem) clamp(1rem, 3vw, 1.8rem);
        text-align: center;
        position: relative;
      }
      .stat + .stat { border-inline-start: var(--rule) solid var(--line); }
      .stat:nth-child(3) { border-inline-start: none; }
      .stat:nth-child(1), .stat:nth-child(2) { border-block-end: var(--rule) solid var(--line); }
      .stat-num {
        font-family: var(--serif);
        font-weight: 900;
        font-size: clamp(1.7rem, 1.3rem + 1.9vw, 2.7rem);
        line-height: 1;
        color: var(--ink);
        display: block;
        letter-spacing: -0.02em;
        font-variant-numeric: lining-nums;
        font-feature-settings: "lnum";
      }
      .stat-label {
        margin-top: 0.6rem;
        font-size: var(--t-caption);
        font-weight: 600;
        color: var(--ink-soft);
        letter-spacing: 0.02em;
      }

      /* ---------- SECTION SCAFFOLD ---------- */
      section { padding-block: var(--section-y); }
      .section-head {
        display: grid;
        gap: clamp(0.7rem, 2vw, 1.1rem);
        margin-bottom: clamp(2rem, 4.5vw, 3rem);
      }
      .section-head .row {
        display: flex;
        align-items: flex-start;
        gap: clamp(1rem, 3vw, 2rem);
        padding-bottom: clamp(1.1rem, 3vw, 1.75rem);
        border-bottom: var(--rule) solid var(--line);
      }
      .section-head .sec-numeral {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(2.2rem, 1.6rem + 3vw, 4.5rem);
        line-height: 0.85;
        color: var(--accent);
        opacity: 0.85;
        flex: none;
        font-variant-numeric: lining-nums;
        font-feature-settings: "lnum";
      }
      .section-head h2 { font-size: var(--t-h2); max-width: 18ch; }
      .section-head .lede {
        color: var(--ink-soft);
        max-width: 56ch;
        font-size: var(--t-lede);
      }

      /* ---------- SERVICES ---------- */
      .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--rule);
        background: var(--line);
        border: var(--rule) solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
      }
      .service {
        background: var(--card);
        padding: clamp(1.5rem, 3.5vw, 2.4rem);
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        transition: background 0.35s var(--ease);
      }
      .service:hover { background: var(--paper-2); }
      .service-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .service-icon {
        display: inline-grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border: 1.5px solid var(--accent);
        border-radius: var(--radius);
        color: var(--accent);
        background: var(--accent-tint);
        flex: none;
      }
      .service-icon svg { width: 24px; height: 24px; }
      .service .numeral { font-size: clamp(1.8rem, 1.4rem + 1.5vw, 2.6rem); }
      .service-media {
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: var(--radius);
        border: var(--rule) solid var(--line);
      }
      .service-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.25) contrast(1.04);
        transition: transform 0.7s var(--ease), filter 0.7s var(--ease);
      }
      .service:hover .service-media img {
        transform: scale(1.05);
        filter: grayscale(0) contrast(1.05);
      }
      .service h3 { font-size: var(--t-h3); }
      .service-desc { color: var(--ink-soft); font-size: var(--t-body); line-height: 1.55; }
      .service ul {
        list-style: none;
        display: grid;
        gap: 0.6rem;
        margin-top: auto;
        padding-top: 0.4rem;
      }
      .service li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: var(--t-caption);
        color: var(--ink-soft);
        line-height: 1.45;
      }
      .service li svg {
        width: 0.95em;
        height: 0.95em;
        flex: none;
        margin-top: 0.35em;
        color: var(--accent);
      }

      /* ---------- BEFORE / AFTER SLIDER (physical, RTL-correct per locked ref) ---------- */
      .ba { background: var(--paper-2); border-block: var(--rule) solid var(--line-strong); }
      .ba-shell {
        position: relative;
        max-width: 1000px;
        margin-inline: auto;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: var(--radius);
        box-shadow: var(--shadow-2);
        border: var(--rule) solid var(--line);
        touch-action: pan-y;
        user-select: none;
        --pos: 50%;
      }
      .ba-layer { position: absolute; inset: 0; }
      .ba-layer img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* "after" sits on top, clipped. Physical (RTL-safe):
         before stays on the RIGHT, after revealed from the LEFT as --pos grows. */
      .ba-after { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
      .ba-tag {
        position: absolute;
        inset-block-start: 0.9rem;
        z-index: 4;
        font-family: var(--serif);
        font-weight: 900;
        font-size: var(--t-caption);
        letter-spacing: 0.06em;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        pointer-events: none;
      }
      .ba-tag--before { right: 1rem; background: oklch(24% 0.018 55); color: var(--on-photo); }
      .ba-tag--after { left: 1rem; background: var(--accent); color: var(--on-accent); }
      .ba-divider {
        position: absolute;
        inset-block: 0;
        left: var(--pos);
        width: 2px;
        background: oklch(98% 0.01 85);
        transform: translateX(-50%);
        z-index: 5;
        pointer-events: none;
        box-shadow: 0 0 0 1px oklch(20% 0.02 55 / 0.25);
      }
      .ba-knob {
        position: absolute;
        top: 50%;
        left: var(--pos);
        transform: translate(-50%, -50%);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: oklch(98% 0.01 85);
        color: oklch(24% 0.018 55);
        display: grid;
        place-items: center;
        z-index: 6;
        pointer-events: none;
        box-shadow: var(--shadow-2);
      }
      .ba-knob svg { width: 22px; height: 22px; }
      .ba-range {
        position: absolute;
        top: 50%;
        inset-inline: 0;
        transform: translateY(-50%);
        width: 100%;
        height: 56px;
        margin: 0;
        opacity: 0;
        cursor: ew-resize;
        z-index: 7;
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        direction: ltr; /* keep range math LTR; value mapped via JS */
      }
      .ba-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 56px;
        height: 56px;
        border-radius: 50%;
      }
      .ba-range::-moz-range-thumb {
        width: 56px;
        height: 56px;
        border: 0;
        border-radius: 50%;
      }
      .ba-range:focus-visible + .ba-divider {
        background: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-tint);
      }
      .ba-caption {
        margin-top: 1.1rem;
        text-align: center;
        font-size: var(--t-caption);
        color: var(--ink-faint);
        letter-spacing: 0.02em;
      }

      /* ---------- PROJECTS GALLERY — Embla carousel ---------- */
      .embla--gallery { margin-top: clamp(1.75rem, 4vw, 2.75rem); }
      .embla--gallery .embla__viewport {
        overflow: hidden;
        border-radius: var(--radius);
      }
      .embla--gallery .embla__container {
        display: flex;
        gap: 1.1rem;
        touch-action: pan-y;
      }
      .embla--gallery .embla__slide {
        position: relative;
        flex: 0 0 82%;
        min-inline-size: 0;
        border-radius: var(--radius);
        overflow: hidden;
        border: var(--rule) solid var(--line);
        box-shadow: var(--shadow-1);
      }
      @media (min-width: 720px) {
        .embla--gallery .embla__slide { flex-basis: 46%; }
      }
      @media (min-width: 1040px) {
        .embla--gallery .embla__slide { flex-basis: 31.5%; }
      }
      .embla--gallery .embla__slide img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        filter: grayscale(0.2) contrast(1.04);
        transition: transform 0.7s var(--ease), filter 0.7s var(--ease);
      }
      .embla--gallery .embla__slide:hover img {
        transform: scale(1.05);
        filter: grayscale(0) contrast(1.05);
      }
      .embla--gallery .embla__slide figcaption {
        position: absolute;
        inset-block-end: 0.85rem;
        inset-inline-start: 0.85rem;
        z-index: 2;
        font-family: var(--serif);
        font-weight: 700;
        font-size: var(--t-h3);
        color: var(--on-photo);
        text-shadow: 0 2px 14px oklch(15% 0.02 55 / 0.65);
      }
      .embla--gallery .embla__slide::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--hero-tint-a), transparent 52%);
        pointer-events: none;
      }
      .embla__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 1.4rem;
      }
      .embla__btn {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        border: var(--rule) solid var(--line-strong);
        background: var(--card);
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.3s var(--ease), border-color 0.3s var(--ease),
          color 0.3s var(--ease);
      }
      .embla__btn:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-2px);
      }
      .embla__btn svg { width: 20px; height: 20px; }
      .embla__dots { display: flex; gap: 0.5rem; }
      .embla__dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 0;
        padding: 0;
        cursor: pointer;
        background: var(--line-strong);
        transition: background 0.3s var(--ease), transform 0.3s var(--ease);
      }
      .embla__dot.is-selected {
        background: var(--accent);
        transform: scale(1.25);
      }

      /* ---------- ABOUT ---------- */
      .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.8rem, 4vw, 3rem);
        align-items: start;
      }
      .about-portrait {
        position: relative;
        aspect-ratio: 4 / 5;
        max-width: 400px;
        overflow: hidden;
        border-radius: var(--radius);
        box-shadow: var(--shadow-2);
      }
      .about-portrait::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        box-shadow: inset 0 0 0 6px var(--paper);
        pointer-events: none;
        border-radius: var(--radius);
      }
      .about-portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        filter: grayscale(0.35) contrast(1.05);
        transition: filter 0.6s var(--ease);
      }
      .about-portrait:hover img { filter: grayscale(0); }
      .about-body .eyebrow { margin-bottom: 1.2rem; }
      .about-body h2 { font-size: var(--t-h2); margin-bottom: 1.3rem; max-width: 20ch; }
      .about-body p { color: var(--ink-soft); max-width: 58ch; margin-bottom: 1rem; }
      .about-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.5rem; }
      .about-sign {
        margin-top: 1.6rem;
        font-family: var(--serif);
        font-weight: 700;
        font-style: italic;
        font-size: var(--t-h3);
        color: var(--accent);
      }

      /* ---------- FINAL CTA ---------- */
      .cta-band {
        background: var(--ink);
        color: var(--on-photo);
        position: relative;
        overflow: hidden;
      }
      html[data-theme="dark"] .cta-band {
        background: var(--paper-3);
        border-block: var(--rule) solid var(--line-strong);
      }
      .cta-inner { position: relative; z-index: 2; display: grid; gap: 1.4rem; }
      .cta-inner .eyebrow { color: var(--accent-soft); }
      .cta-inner h2 {
        font-size: var(--t-h2);
        max-width: 17ch;
        color: var(--on-photo);
      }
      html[data-theme="dark"] .cta-inner h2 { color: var(--ink); }
      .cta-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }
      .cta-band .btn--ghost {
        color: var(--on-photo);
        border-color: oklch(100% 0 0 / 0.35);
      }
      html[data-theme="dark"] .cta-band .btn--ghost {
        color: var(--ink);
        border-color: var(--line-strong);
      }
      .cta-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(1rem, 3vw, 2.5rem);
        padding-top: 1.5rem;
        margin-top: 0.6rem;
        border-top: var(--rule) solid oklch(100% 0 0 / 0.16);
        font-weight: 600;
      }
      html[data-theme="dark"] .cta-contacts { border-top-color: var(--line); }
      .cta-contacts a, .cta-contacts span {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: oklch(92% 0.01 85);
        min-height: 44px;
      }
      html[data-theme="dark"] .cta-contacts a,
      html[data-theme="dark"] .cta-contacts span { color: var(--ink-soft); }
      .cta-contacts a:hover { color: var(--accent-soft); }
      .cta-contacts svg { width: 1.05em; height: 1.05em; color: var(--accent-soft); flex: none; }

      /* ---------- FOOTER ---------- */
      .site-footer {
        border-top: var(--rule) solid var(--line);
        padding-block: clamp(2rem, 5vw, 3rem);
      }
      .footer-inner { display: grid; gap: 1.3rem; }
      .footer-top {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
      }
      .footer-tag { color: var(--ink-faint); font-size: var(--t-caption); max-width: 48ch; }
      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.6rem;
        padding-top: 1.3rem;
        border-top: var(--rule) solid var(--line);
        font-size: var(--t-caption);
        color: var(--ink-faint);
      }

      /* ---------- MOTION ---------- */
      .reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: reveal 0.85s var(--ease-out) forwards;
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
      @keyframes reveal { to { opacity: 1; transform: translateY(0); } }

      .load {
        opacity: 0;
        transform: translateY(18px);
        animation: load 0.9s var(--ease-out) forwards;
      }
      @keyframes load { to { opacity: 1; transform: translateY(0); } }
      .d1 { animation-delay: 0.05s; }
      .d2 { animation-delay: 0.16s; }
      .d3 { animation-delay: 0.27s; }
      .d4 { animation-delay: 0.38s; }
      .d5 { animation-delay: 0.49s; }

      .clip {
        clip-path: inset(0 0 100% 0);
        animation: clip 1.1s var(--ease-out) 0.5s forwards;
      }
      @keyframes clip { to { clip-path: inset(0 0 0 0); } }

      /* ---------- RESPONSIVE ---------- */
      @media (min-width: 720px) {
        .stats-grid { grid-template-columns: repeat(4, 1fr); }
        .stat:nth-child(1), .stat:nth-child(2) { border-block-end: none; }
        .stat:nth-child(3) { border-inline-start: var(--rule) solid var(--line); }
        .services-grid { grid-template-columns: repeat(3, 1fr); }
      }

      @media (min-width: 960px) {
        .nav { display: flex; }
        .phone-link { display: inline-flex; }
        .hero-top { grid-template-columns: 1.4fr 1fr; }
        .about-grid { grid-template-columns: 0.8fr 1.2fr; align-items: center; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
        }
        .reveal, .load { opacity: 1; transform: none; }
        .clip { clip-path: none; }
        .hero-band .embla__slide img { transform: scale(1.02); }
      }
    </style>
  </head>
