<!doctype html>
<html lang="he" dir="rtl" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>D.Meyer's — בדק בית, ייעוץ איטום ואפיון ציפויים | חוות דעת קבילות בבית המשפט</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700;900&family=Assistant:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --serif: "Frank Ruhl Libre", Georgia, serif;
        --sans: "Assistant", system-ui, sans-serif;
        --maxw: 1280px;
        --step--1: clamp(0.82rem, 0.78rem + 0.2vw, 0.95rem);
        --step-0: clamp(1rem, 0.94rem + 0.3vw, 1.18rem);
        --step-1: clamp(1.3rem, 1.1rem + 0.9vw, 1.85rem);
        --step-2: clamp(1.9rem, 1.4rem + 2.2vw, 3rem);
        --step-3: clamp(2.6rem, 1.6rem + 4.6vw, 5.4rem);
        --step-4: clamp(3.4rem, 1.8rem + 7vw, 8rem);
        --rule: 1px;
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
      }

      html[data-theme="light"] {
        --paper: oklch(97.5% 0.012 85);
        --paper-2: oklch(94.5% 0.018 82);
        --paper-3: oklch(91% 0.022 80);
        --ink: oklch(22% 0.02 60);
        --ink-soft: oklch(38% 0.018 58);
        --ink-faint: oklch(55% 0.015 60);
        --accent: oklch(40% 0.13 25);
        --accent-soft: oklch(46% 0.12 26);
        --line: oklch(78% 0.02 70);
        --line-strong: oklch(60% 0.025 65);
        --card: oklch(99% 0.008 88);
        --shadow: oklch(22% 0.02 60 / 0.1);
        --hero-tint: oklch(22% 0.02 60 / 0.42);
      }

      html[data-theme="dark"] {
        --paper: oklch(18% 0.012 60);
        --paper-2: oklch(21.5% 0.014 58);
        --paper-3: oklch(25% 0.016 56);
        --ink: oklch(93% 0.012 80);
        --ink-soft: oklch(80% 0.014 78);
        --ink-faint: oklch(64% 0.014 72);
        --accent: oklch(66% 0.135 30);
        --accent-soft: oklch(72% 0.12 32);
        --line: oklch(34% 0.014 60);
        --line-strong: oklch(46% 0.018 60);
        --card: oklch(22% 0.014 58);
        --shadow: oklch(0% 0 0 / 0.4);
        --hero-tint: oklch(12% 0.012 60 / 0.55);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: var(--sans);
        font-size: var(--step-0);
        line-height: 1.65;
        color: var(--ink);
        background-color: var(--paper);
        background-image:
          radial-gradient(120% 80% at 100% 0%, var(--paper-2), transparent 55%),
          radial-gradient(100% 70% at 0% 100%, var(--paper-3), transparent 50%);
        background-attachment: fixed;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        transition: background-color 0.5s var(--ease), color 0.5s var(--ease);
      }

      h1, h2, h3 {
        font-family: var(--serif);
        font-weight: 900;
        line-height: 1.04;
        letter-spacing: -0.01em;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .wrap {
        width: 100%;
        max-width: var(--maxw);
        margin-inline: auto;
        padding-inline: clamp(1.1rem, 4vw, 3.5rem);
      }

      .eyebrow {
        font-family: var(--sans);
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .eyebrow::before {
        content: "";
        width: clamp(1.4rem, 4vw, 2.6rem);
        height: var(--rule);
        background: var(--accent);
        flex: none;
      }

      .numeral {
        font-family: var(--serif);
        font-weight: 500;
        line-height: 1;
        color: var(--accent);
        opacity: 0.85;
        font-size: var(--step-3);
        font-variant-numeric: lining-nums;
      }

      /* ---------- HEADER ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in oklch, var(--paper) 86%, transparent);
        backdrop-filter: blur(12px) saturate(1.1);
        border-bottom: var(--rule) solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: clamp(60px, 8vh, 78px);
      }
      .wordmark {
        font-family: var(--serif);
        font-weight: 900;
        font-size: clamp(1.25rem, 1rem + 1vw, 1.6rem);
        letter-spacing: -0.02em;
        display: inline-flex;
        align-items: baseline;
        gap: 0.05em;
      }
      .wordmark .dot {
        color: var(--accent);
      }
      .nav {
        display: none;
        gap: clamp(1rem, 2vw, 2rem);
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .nav a {
        position: relative;
        padding-block: 0.4rem;
        color: var(--ink-soft);
        transition: color 0.25s var(--ease);
      }
      .nav a::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        bottom: 0;
        height: var(--rule);
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: inline-end;
        transition: transform 0.3s var(--ease);
      }
      .nav a:hover {
        color: var(--ink);
      }
      .nav a:hover::after {
        transform: scaleX(1);
        transform-origin: inline-start;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: clamp(0.5rem, 1.5vw, 1rem);
      }
      .phone-link {
        display: none;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--ink-soft);
        transition: color 0.25s var(--ease);
      }
      .phone-link:hover {
        color: var(--accent);
      }
      .phone-link svg {
        width: 1em;
        height: 1em;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--sans);
        font-weight: 600;
        font-size: var(--step--1);
        letter-spacing: 0.02em;
        padding: 0.7rem 1.25rem;
        border: var(--rule) solid var(--accent);
        background: var(--accent);
        color: oklch(98% 0.01 85);
        transition: background 0.25s var(--ease), color 0.25s var(--ease), transform 0.25s var(--ease);
        white-space: nowrap;
      }
      .btn:hover {
        background: var(--accent-soft);
        transform: translateY(-2px);
      }
      .btn--ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line-strong);
      }
      .btn--ghost:hover {
        background: transparent;
        border-color: var(--accent);
        color: var(--accent);
      }
      .btn svg {
        width: 0.9em;
        height: 0.9em;
        transition: transform 0.25s var(--ease);
      }
      /* RTL: arrow points left, moves left on hover */
      .btn .arrow {
        transform: scaleX(1);
      }
      .btn:hover .arrow {
        transform: translateX(-3px);
      }
      .toggle {
        display: inline-grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border: var(--rule) solid var(--line-strong);
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        border-radius: 50%;
        transition: border-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.4s var(--ease);
      }
      .toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: rotate(18deg);
      }
      .toggle svg {
        width: 18px;
        height: 18px;
      }
      .toggle .moon {
        display: none;
      }
      html[data-theme="dark"] .toggle .sun {
        display: none;
      }
      html[data-theme="dark"] .toggle .moon {
        display: block;
      }

      /* ---------- HERO ---------- */
      .hero {
        position: relative;
        padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(2rem, 5vw, 4rem);
        overflow: hidden;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: end;
      }
      .hero-issue {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding-bottom: 1.1rem;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
        border-bottom: var(--rule) solid var(--line);
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }
      .hero h1 {
        font-size: var(--step-4);
        max-width: 16ch;
      }
      .hero h1 .accent {
        color: var(--accent);
        font-style: italic;
        font-weight: 700;
      }
      .hero-side {
        max-width: 46ch;
        border-inline-start: 2px solid var(--accent);
        padding-inline-start: clamp(1rem, 2vw, 1.5rem);
      }
      .hero-side p {
        color: var(--ink-soft);
        font-size: var(--step-0);
      }
      .hero-side p::first-letter {
        font-family: var(--serif);
        font-weight: 900;
        font-size: 2.6em;
        float: inline-start;
        line-height: 0.78;
        padding-inline-end: 0.08em;
        padding-block-start: 0.06em;
        color: var(--accent);
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: clamp(1.5rem, 4vw, 2.2rem);
      }
      .hero-figure {
        position: relative;
        margin-top: clamp(2rem, 5vw, 3rem);
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border: var(--rule) solid var(--line);
      }
      .hero-figure img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.25) contrast(1.05);
        transform: scale(1.02);
        transition: transform 1.2s var(--ease);
      }
      .hero-figure::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--hero-tint), transparent 55%),
          linear-gradient(to inline-start, color-mix(in oklch, var(--accent) 22%, transparent), transparent 60%);
        mix-blend-mode: multiply;
      }
      html[data-theme="dark"] .hero-figure::after {
        mix-blend-mode: screen;
        background: linear-gradient(to top, var(--hero-tint), transparent 55%);
      }
      .hero-figure:hover img {
        transform: scale(1.06);
      }
      .hero-caption {
        position: absolute;
        inset-block-end: clamp(0.8rem, 2vw, 1.4rem);
        inset-inline-start: clamp(0.8rem, 2vw, 1.4rem);
        z-index: 2;
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: oklch(96% 0.01 85);
        background: oklch(20% 0.02 60 / 0.45);
        backdrop-filter: blur(4px);
        padding: 0.4rem 0.8rem;
      }

      /* ---------- STATS ---------- */
      .stats {
        border-block: var(--rule) solid var(--line-strong);
        background: var(--paper-2);
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
      }
      .stat {
        padding: clamp(1.6rem, 4vw, 2.6rem) clamp(1rem, 3vw, 1.8rem);
        border-inline-start: var(--rule) solid var(--line);
        position: relative;
      }
      .stat:nth-child(1),
      .stat:nth-child(2) {
        border-block-end: var(--rule) solid var(--line);
      }
      .stat-num {
        font-family: var(--serif);
        font-weight: 900;
        font-size: var(--step-2);
        line-height: 1;
        color: var(--ink);
        display: block;
        letter-spacing: -0.02em;
      }
      .stat-label {
        margin-top: 0.6rem;
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--ink-soft);
        letter-spacing: 0.02em;
      }

      /* ---------- SECTION HEAD ---------- */
      section {
        padding-block: clamp(3.5rem, 9vw, 7rem);
      }
      .section-head {
        display: grid;
        gap: clamp(0.8rem, 2vw, 1.5rem);
        margin-bottom: clamp(2.2rem, 5vw, 3.5rem);
        padding-bottom: clamp(1.2rem, 3vw, 2rem);
        border-bottom: var(--rule) solid var(--line);
      }
      .section-head h2 {
        font-size: var(--step-3);
        max-width: 18ch;
      }
      .section-head .lede {
        color: var(--ink-soft);
        max-width: 52ch;
        font-size: var(--step-0);
      }

      /* ---------- SERVICES ---------- */
      .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--rule);
        background: var(--line);
        border: var(--rule) solid var(--line);
      }
      .service {
        background: var(--card);
        padding: clamp(1.6rem, 4vw, 2.6rem);
        display: grid;
        gap: 1.1rem;
        position: relative;
        transition: background 0.35s var(--ease);
      }
      .service:hover {
        background: var(--paper-2);
      }
      .service-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
      }
      .service .numeral {
        font-size: var(--step-2);
      }
      .service-media {
        aspect-ratio: 5 / 3;
        overflow: hidden;
        border: var(--rule) solid var(--line);
      }
      .service-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.3) contrast(1.04);
        transition: transform 0.7s var(--ease), filter 0.7s var(--ease);
      }
      .service:hover .service-media img {
        transform: scale(1.05);
        filter: grayscale(0) contrast(1.06);
      }
      .service h3 {
        font-size: var(--step-1);
      }
      .service p {
        color: var(--ink-soft);
        font-size: var(--step--1);
        line-height: 1.6;
      }
      .service ul {
        list-style: none;
        display: grid;
        gap: 0.55rem;
        margin-top: 0.3rem;
      }
      .service li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: var(--step--1);
        color: var(--ink-soft);
      }
      .service li svg {
        width: 0.85em;
        height: 0.85em;
        flex: none;
        margin-top: 0.5em;
        color: var(--accent);
      }

      /* ---------- BEFORE / AFTER ---------- */
      .ba {
        background: var(--paper-2);
        border-block: var(--rule) solid var(--line-strong);
      }
      .ba-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1rem, 3vw, 1.8rem);
      }
      .ba-figure {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border: var(--rule) solid var(--line);
      }
      .ba-figure img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s var(--ease);
      }
      .ba-figure:hover img {
        transform: scale(1.04);
      }
      .ba-tag {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        font-family: var(--serif);
        font-weight: 900;
        font-size: var(--step-1);
        color: oklch(97% 0.01 85);
        background: var(--accent);
        padding: 0.3rem 1rem;
        letter-spacing: -0.01em;
      }
      .ba-figure.is-before .ba-tag {
        background: var(--ink);
      }

      /* ---------- ABOUT ---------- */
      .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.8rem, 4vw, 3rem);
        align-items: start;
      }
      .about-portrait {
        position: relative;
        aspect-ratio: 4 / 5;
        max-width: 380px;
        overflow: hidden;
        border: var(--rule) solid var(--line);
      }
      .about-portrait::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        box-shadow: inset 0 0 0 6px var(--paper);
        pointer-events: none;
      }
      .about-portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.4) contrast(1.05);
        transition: filter 0.6s var(--ease);
      }
      .about-portrait:hover img {
        filter: grayscale(0);
      }
      .about-body .eyebrow {
        margin-bottom: 1.2rem;
      }
      .about-body h2 {
        font-size: var(--step-2);
        margin-bottom: 1.2rem;
      }
      .about-body p {
        color: var(--ink-soft);
        max-width: 56ch;
        margin-bottom: 1rem;
      }
      .about-sign {
        margin-top: 1.6rem;
        font-family: var(--serif);
        font-weight: 700;
        font-style: italic;
        font-size: var(--step-1);
        color: var(--accent);
      }

      /* ---------- FINAL CTA ---------- */
      .cta-band {
        background: var(--ink);
        color: oklch(96% 0.01 85);
        position: relative;
        overflow: hidden;
      }
      html[data-theme="dark"] .cta-band {
        background: var(--paper-3);
        border-block: var(--rule) solid var(--line-strong);
      }
      .cta-band::before {
        content: "01";
        position: absolute;
        font-family: var(--serif);
        font-weight: 900;
        font-size: clamp(12rem, 40vw, 28rem);
        color: var(--accent);
        opacity: 0.1;
        inset-block-start: -0.2em;
        inset-inline-end: -0.1em;
        line-height: 1;
        pointer-events: none;
      }
      .cta-inner {
        position: relative;
        z-index: 2;
        display: grid;
        gap: 1.5rem;
      }
      .cta-inner .eyebrow {
        color: var(--accent-soft);
      }
      .cta-inner h2 {
        font-size: var(--step-3);
        max-width: 16ch;
        color: oklch(97% 0.01 85);
      }
      html[data-theme="dark"] .cta-inner h2 {
        color: var(--ink);
      }
      .cta-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(1rem, 3vw, 2.5rem);
        padding-top: 1.5rem;
        margin-top: 0.5rem;
        border-top: var(--rule) solid oklch(100% 0 0 / 0.15);
        font-weight: 600;
      }
      html[data-theme="dark"] .cta-contacts {
        border-top-color: var(--line);
      }
      .cta-contacts a,
      .cta-contacts span {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: oklch(90% 0.01 85);
      }
      html[data-theme="dark"] .cta-contacts a,
      html[data-theme="dark"] .cta-contacts span {
        color: var(--ink-soft);
      }
      .cta-contacts a:hover {
        color: var(--accent-soft);
      }
      .cta-contacts svg {
        width: 1em;
        height: 1em;
        color: var(--accent-soft);
      }
      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 0.5rem;
      }
      .cta-band .btn--ghost {
        color: oklch(95% 0.01 85);
        border-color: oklch(100% 0 0 / 0.35);
      }
      html[data-theme="dark"] .cta-band .btn--ghost {
        color: var(--ink);
        border-color: var(--line-strong);
      }

      /* ---------- FOOTER ---------- */
      .site-footer {
        border-top: var(--rule) solid var(--line);
        padding-block: clamp(2rem, 5vw, 3rem);
      }
      .footer-inner {
        display: grid;
        gap: 1.2rem;
      }
      .footer-top {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
      }
      .footer-tag {
        color: var(--ink-faint);
        font-size: var(--step--1);
        max-width: 48ch;
      }
      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.6rem;
        padding-top: 1.2rem;
        border-top: var(--rule) solid var(--line);
        font-size: var(--step--1);
        color: var(--ink-faint);
      }

      /* ---------- REVEAL MOTION ---------- */
      .reveal {
        opacity: 0;
        transform: translateY(26px);
        animation: reveal 0.9s var(--ease) forwards;
        animation-timeline: view();
        animation-range: entry 0% cover 32%;
      }
      @keyframes reveal {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* page-load orchestration for hero */
      .load {
        opacity: 0;
        transform: translateY(20px);
        animation: load 0.95s var(--ease) forwards;
      }
      @keyframes load {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .d1 { animation-delay: 0.05s; }
      .d2 { animation-delay: 0.18s; }
      .d3 { animation-delay: 0.31s; }
      .d4 { animation-delay: 0.44s; }
      .d5 { animation-delay: 0.57s; }
      .d6 { animation-delay: 0.7s; }

      .clip {
        clip-path: inset(0 0 100% 0);
        animation: clip 1.1s var(--ease) 0.55s forwards;
      }
      @keyframes clip {
        to {
          clip-path: inset(0 0 0 0);
        }
      }

      /* ---------- RESPONSIVE ---------- */
      @media (min-width: 768px) {
        .stats-grid {
          grid-template-columns: repeat(4, 1fr);
        }
