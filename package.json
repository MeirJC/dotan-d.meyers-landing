{
  "name": "dotan-landing",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist .astro node_modules pnpm-lock.yaml && find . -name \".DS_Store\" -delete",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,astro,svelte,json,md,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,astro,svelte,json,md,css}\"",
    "format:diff": "prettier --list-different --cache \"src/**/*.{js,jsx,ts,tsx,astro,svelte,json,md,css}\"",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.18",
    "@emailjs/browser": "^4.4.1",
    "@fontsource-variable/heebo": "^5.2.8",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.4",
    "astro-seo": "^1.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@iconify-json/ic": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "knip": "^6.15.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
